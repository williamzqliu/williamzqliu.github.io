---
// SPEC §6 / §8 — tone-locked cover plate.
// TODO: render <video>/<img> once the media in `cover.wide` exists. Until then
// this draws the plate at the right ratio so the layout is already correct.
//
// Callers decide whether a plate is wanted at all (see lib/media.ts); this
// component still renders nothing when the switch is off, so no caller can
// bring the placeholder back by accident.

import { COVERS_ENABLED } from '../lib/media';

interface Props {
  tone: 'dark' | 'light' | 'neutral';
  /** `responsive` is square on mobile, 16:9 above (SPEC §5). */
  ratio?: 'responsive' | 'wide';
  label?: string;
}

const { tone, ratio = 'responsive', label = 'cover loop' } = Astro.props;
---

{
  COVERS_ENABLED && (
    <div class="cover" data-tone={tone} data-ratio={ratio} aria-hidden="true">
      <div class="cover__placeholder">
        <span>{label}</span>
        <span>1600 &#215; 900</span>
      </div>
    </div>
  )
}

<style>
  .cover {
    border: var(--rule-hair) solid var(--rule);
    display: flex;
    align-items: flex-end;
  }

  /* 16:9 at every width. SPEC §5 asked for square below 640px, but a 1:1
     plate at full column width took most of a phone screen before the title
     had been read — the row now shows image, title, year and the start of the
     blurb together. `responsive` is kept as a name because the wide plate on
     a case study head is a different, full-bleed thing. */
  .cover[data-ratio='responsive'],
  .cover[data-ratio='wide'] {
    aspect-ratio: 16 / 9;
  }

  /* Locked to the declared tone — does not follow the theme (SPEC §8). */
  .cover[data-tone='dark'] {
    background: var(--tone-dark);
    color: var(--tone-dark-ink);
  }

  .cover[data-tone='light'] {
    background: var(--tone-light);
    color: var(--tone-light-ink);
  }

  .cover[data-tone='neutral'] {
    background: var(--tone-neutral);
    color: var(--tone-neutral-ink);
  }

  .cover__placeholder {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--sp-16);
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    letter-spacing: -0.02em;
  }

  /* Ready for the real media: the plate's ratio is the frame, and the asset
     fills it rather than setting its own height. `cover.wide` is the asset to
     use here at every width — the square crop in the schema has no place left
     to appear. */
  .cover > :global(img),
  .cover > :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
