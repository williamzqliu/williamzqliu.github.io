---
// Subject filters plus one status filter. Values are the data values
// (`information-design`), labels are the readable form (`information design`).
//
// Progressive enhancement: with JS off every row stays visible and the chips
// simply do nothing. The filtering script lives on the page that owns the rows,
// because only that page knows what it is filtering.

interface Props {
  /** Data values, in order. `all` and `archive` are handled by the page. */
  options: string[];
  active?: string;
}

const { options, active = 'all' } = Astro.props;
const label = (value: string) => value.replace(/-/g, ' ');
---

<div class="filterrow" role="group" aria-label="Filter projects">
  <ul class="filterrow__list">
    {
      options.map((option) => (
        <li>
          <button
            type="button"
            class="filterrow__chip"
            data-filter={option}
            aria-pressed={option === active ? 'true' : 'false'}
          >
            {label(option)}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Wraps above 640px, scrolls sideways below it (SPEC §6). The half-visible
     chip at the right edge is the affordance, so the row is deliberately not
     padded to hide it. */
  .filterrow__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-24);
  }

  .filterrow__chip {
    position: relative;
    display: block;
    /* The nav's size, not the meta size: this is a control, not a caption. */
    font-size: var(--fs-nav);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-2);
    /* Reaches the 44px minimum tap target even though the type is small. */
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Orange underline on the active chip, as wide as the word, opening from
     the middle out — the same gesture as the nav indicator. */
  .filterrow__chip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--sp-8);
    height: var(--rule-heavy);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-draw) var(--ease-out);
  }

  /* Active chip takes the accent, matching its underline. */
  .filterrow__chip[aria-pressed='true'] {
    color: var(--accent);
  }

  .filterrow__chip[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .filterrow__chip:hover {
      color: var(--text);
      transition-duration: var(--dur-hover-in);
    }

    .filterrow__chip[aria-pressed='true']:hover {
      color: var(--accent);
    }
  }

  /* Filter press: a quick fade rather than a jump. Pointer devices only —
     touch gets no press state anywhere on the site. */
  @media (hover: hover) and (pointer: fine) {
    .filterrow__chip:active,
    .filterrow__chip:active::after {
      transition-duration: var(--dur-press);
    }

    .filterrow__chip:active {
      color: var(--text);
    }
  }

  /* One row on a phone, scrolled rather than wrapped. The scroller bleeds to
     the page edges so the last chip can reach the middle of the screen and
     keeps its full tap area, and the padding puts the first chip back on the
     page's own left edge. */
  @media (max-width: 639px) {
    .filterrow {
      /* The row lives in a `align-items: flex-start` column, so without these
         two it is sized by its own content and pushes the page sideways
         instead of scrolling inside itself. */
      align-self: stretch;
      min-width: 0;
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .filterrow::-webkit-scrollbar {
      display: none;
    }

    .filterrow__list {
      flex-wrap: nowrap;
      /* Otherwise the flex line shrinks to the scroller and the chips wrap
         their own text. */
      width: max-content;
    }

    .filterrow__chip {
      white-space: nowrap;
    }
  }

  @media (min-width: 640px) {
    .filterrow__list {
      gap: var(--sp-12) var(--sp-32);
    }
  }
</style>
