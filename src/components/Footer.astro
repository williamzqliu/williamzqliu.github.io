---
// The site's single contact point. Not a second navigation and not a résumé
// summary: a greeting, one sentence, three destinations, a quiet copyright.
// Resume is in the nav, so it is deliberately absent here.
import ExtArrow from './ExtArrow.astro';

const links = [
  // Email is not another site, so it gets no arrow.
  { label: 'Email', href: 'mailto:williamzq115@gmail.com' },
  // GitHub parked for now. Restore by uncommenting — the case studies still
  // link to their own repositories, so the profile is not the only way in.
  // { label: 'GitHub', href: 'https://github.com/williamzqliu' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/william-zqliu' },
];

const year = new Date().getFullYear();
---

{/* Unnamed, like the header: the root group does not animate, so the footer
    stays put without needing a group of its own. */}
<footer class="footer">
  <div class="container">
    {/* Four children, no wrappers: on a desktop the two sides have to share
        rows, and a row cannot be shared by items that live in different
        stacks. The order here is the order a phone reads them in; the desktop
        grid places them explicitly. */}
    <div class="footer__row">
      <h2 class="footer__heading">Get in touch</h2>

      <p class="footer__line">
        Send me an email or message and I&#8217;ll get back to you soon.
      </p>

      <ul class="footer__links">
        {
          links.map((link) => {
            const external = link.href.startsWith('http');
            return (
              <li>
                <a
                  class="footer__link"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {external && (
                    <>
                      <ExtArrow />
                      <span class="vh">(opens in a new tab)</span>
                    </>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>

      <p class="footer__colophon">&#169; {year} Zhuoqi Liu</p>
    </div>
  </div>
</footer>

<style>
  /* A divider, not a section boundary: the same hairline used between rows
     rather than the 2px rule this used to carry. */
  .footer {
    border-top: var(--rule-hair) solid var(--rule);
    margin-top: var(--sp-40);
  }

  /* Phone: one column, and the spacing rides on the items rather than on a
     single gap — the four steps are 8 / 24 / 16, not one number. The links
     carry 8px of tap padding at each end, so their margins are set 8px short
     of the space they are meant to read as. */
  .footer__row {
    display: grid;
    gap: 0;
    padding-block: var(--sp-48) var(--sp-40);
  }

  /* Display face, but at a size where it reads as a greeting rather than a
     heading competing with the page. */
  .footer__heading {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-body-lg);
    line-height: 1.2;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .footer__line {
    margin-top: var(--sp-8);
    max-width: var(--measure-meta);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  /* `baseline`, not the default `stretch`. It lines the two links up with each
     other, and — the reason it matters — it is what gives this list a baseline
     of its own to hand the footer's grid. Stretched, each item's baseline came
     from its own strut instead of from the words, and the row above read 4.6px
     high against the greeting beside it. */
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-24);
    margin-top: var(--sp-16);
  }

  /* Text links, colour only on hover — no underline, no fill, and the arrow
     never moves on its own. */
  .footer__link {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    padding-block: var(--sp-8);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* Last line of the page: separated by space, not by another rule, and it
     belongs to the links above it rather than to the width of the page. */
  .footer__colophon {
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  @media (min-width: 1024px) {
    /* Two columns and two rows that both sides sit in, rather than two stacks
       standing next to each other. Stacks drift: each side spaces itself, and
       the greeting ended up level with nothing in particular.

       `align-items: baseline` is what actually lines the pairs up — the
       greeting and the links are different faces at different sizes, and the
       links carry tap padding, so matching their boxes would not match their
       type. One `row-gap` for both columns, and no margins of their own. */
    .footer__row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      column-gap: var(--sp-64);
      row-gap: var(--sp-8);
      align-items: baseline;
      padding-block: var(--sp-48);
    }

    .footer__heading {
      grid-area: 1 / 1;
    }

    .footer__links {
      grid-area: 1 / 2;
      justify-self: end;
      justify-content: flex-end;
      gap: var(--sp-32);
      margin-top: 0;
    }

    .footer__line {
      grid-area: 2 / 1;
      margin-top: 0;
    }

    .footer__colophon {
      grid-area: 2 / 2;
      justify-self: end;
      text-align: right;
      margin-top: 0;
    }
  }
</style>
