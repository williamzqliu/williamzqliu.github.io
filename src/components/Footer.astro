---
// The site's single contact point. Not a second navigation and not a résumé
// summary: a greeting, one sentence, three destinations, a quiet copyright.
// Resume is in the nav, so it is deliberately absent here.
import ExtArrow from './ExtArrow.astro';

const links = [
  // Email is not another site, so it gets no arrow.
  { label: 'Email', href: 'mailto:williamzq115@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/williamzqliu' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/william-zqliu' },
];

const year = new Date().getFullYear();
---

{/* Unnamed, like the header: the root group does not animate, so the footer
    stays put without needing a group of its own. */}
<footer class="footer">
  <div class="container">
    <div class="footer__row">
      <div class="footer__copy">
        <h2 class="footer__heading">Get in touch</h2>
        <p class="footer__line">
          Send me an email or message and I&#8217;ll get back to you soon.
        </p>
      </div>

      <ul class="footer__links">
        {
          links.map((link) => {
            const external = link.href.startsWith('http');
            return (
              <li>
                <a
                  class="footer__link"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {external && (
                    <>
                      <ExtArrow />
                      <span class="vh">(opens in a new tab)</span>
                    </>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <p class="footer__colophon">&#169; {year} Zhuoqi Liu</p>
  </div>
</footer>

<style>
  /* A divider, not a section boundary: the same hairline used between rows
     rather than the 2px rule this used to carry. */
  .footer {
    border-top: var(--rule-hair) solid var(--rule);
    margin-top: var(--sp-64);
  }

  .footer__row {
    display: grid;
    gap: var(--sp-24);
    padding-block: var(--sp-48) var(--sp-24);
  }

  /* Display face, but at a size where it reads as a greeting rather than a
     heading competing with the page. */
  .footer__heading {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-body-lg);
    line-height: 1.2;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .footer__line {
    margin-top: var(--sp-8);
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-24);
  }

  /* Text links, colour only on hover — no underline, no fill, and the arrow
     never moves on its own. */
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    padding-block: var(--sp-8);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  .footer__link:active {
    color: var(--accent);
    transition-duration: var(--dur-press);
  }

  /* Last line of the page: separated by space, not by another rule. */
  .footer__colophon {
    padding-bottom: var(--sp-48);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  @media (min-width: 1024px) {
    /* Copy left, destinations right, both on the site's own grid. */
    .footer__row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--sp-64);
      align-items: start;
      padding-block: var(--sp-56) var(--sp-32);
    }

    .footer__links {
      justify-content: flex-end;
      gap: var(--sp-32);
    }

    .footer__colophon {
      padding-bottom: var(--sp-56);
    }
  }
</style>
