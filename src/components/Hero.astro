---
import IdentityLine from './IdentityLine.astro';
import StatRow from './StatRow.astro';

// Three tiers, one composition.
//   1. `Hi, I'm Zhuoqi.` — the personal anchor, whole line in the display face,
//      the name emphasised inside the sentence rather than lifted out of it.
//   2. Two work statements, set identically so they read as two related
//      thoughts rather than a headline and a subtitle.
//   3. The pronunciation, small, tucked under the name.
//
// The dictionary reference is carried by placement and treatment only — no
// "pronounced", no separator, no part-of-speech labels.

interface Stat {
  value: string;
  label: string;
}

interface Props {
  /** Stays in the main text colour, at the smaller of the two display sizes. */
  greeting?: string;
  /** A step larger, italic, accent — the emphasised word in the sentence. */
  name?: string;
  /** Plain-English respelling, italic, under the name. */
  respelling?: string;
  /** Lead-in for the respelling — a label, so it sits a weight below it. */
  respellingLabel?: string;
  /** Two lines, styled identically. Authored here, so `<strong>` markup in
      them is trusted content rather than user input. */
  statements: string[];
  /** Omit until the numbers are real. An empty row is better than a wrong one. */
  stats?: Stat[];
}

const { greeting, name, respelling, respellingLabel, statements, stats = [] } = Astro.props;
---

<section class="hero">
  <div class="container">
    {/* Two roles, two columns: who I am on the left, what I do on the right.
        Stacked below 1024px. */}
    <div class="hero__grid">
      {
        greeting && name && (
          <IdentityLine
            greeting={greeting}
            name={name}
            respelling={respelling}
            respellingLabel={respellingLabel}
          />
        )
      }

      <div class="hero__statements">
        {
          statements.map((line, i) =>
            i === 0 ? <h1 set:html={line} /> : <p set:html={line} />
          )
        }
      </div>
    </div>

    {
      stats.length > 0 && (
        <div class="hero__stats">
          <StatRow stats={stats} />
        </div>
      )
    }
  </div>
</section>

<style>
  /* The opening section, not a strip above the work. Mobile keeps the
     proportions but not the size.
     
     Both values are optical rather than scale steps: 150px lands under the
     header to the greeting's line box, and 142px puts 150px between the last
     statement and the `Selected work` label — the label's own tap padding
     contributes the other 8px. The bottom gap carries the whole chapter break
     on a phone, where there is no viewport-height hero and no arrow to mark
     it. */
  .hero {
    padding-block: 150px 142px;
  }

  /* Baseline-aligned so the two sizes sit on one line, wrapping only when the
     viewport forces it. */
  /* Phone: 75px between the pronunciation and the first statement, so the
     identity and the work read as two blocks rather than one paragraph.
     Optical, not a scale step. */
  .hero__grid {
    display: grid;
    gap: 75px;
  }









  /* Two statements, one treatment: same face, size, weight, leading, colour.
     The 15px between them is a phone value: tight, so the two sentences read
     as one pair — the air around the block does the separating. */
  .hero__statements {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 60ch;
  }

  /* The sentence sits a step back from full ink; the phrases that carry the
     content come forward on weight and colour alone — same face, same size,
     same leading. */
  .hero__statements h1,
  .hero__statements p {
    font-family: var(--font-body);
    font-size: var(--fs-statement);
    line-height: 1.25;
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    text-wrap: pretty;
    color: var(--text-2);
  }

  /* `:global` is required: the <strong> tags arrive through `set:html`, so
     they never receive Astro's scoping attribute and a scoped selector would
     silently miss them — the emphasis would fall back to the browser's bold. */
  .hero__statements :global(strong) {
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  /* 22px is the clamp floor, and on a 375px screen two sentences at that size
     fill the opening. 20px keeps them as the second tier they are. */
  @media (max-width: 639px) {
    .hero__statements h1,
    .hero__statements p {
      font-size: 1.25rem;
    }
  }

  .hero__stats {
    margin-top: var(--sp-32);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  @media (min-width: 640px) {
    .hero {
      padding-block: var(--sp-64) var(--sp-80);
    }

    .hero__grid {
      gap: var(--sp-48);
    }

    .hero__statements {
      gap: var(--sp-24);
    }
  }

  @media (min-width: 1024px) {
    /* Roughly 520-620px of section below the nav, following viewport height
       rather than filling it: a 100vh hero would push the work off screen,
       which is the opposite of the point. Slack lands at the bottom because
       the content is not centred — the composition stays top-weighted. */
    /* Centred within the padded box rather than sitting at the top. The
       bottom padding is larger than the top, so the block still lands a little
       above the true middle. */
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: clamp(520px, 62vh, 620px);
      padding-block: var(--sp-96) var(--sp-120);
    }

    /* Identity left, work right. The left column is sized to the name rather
       than to a fraction, so the split does not move when the copy changes. */
    .hero__grid {
      grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
      column-gap: var(--sp-64);
      align-items: start;
    }

    /* The hero is a flex column now, so the container has to fill it for the
       grid inside to keep its width. */
    .hero > .container {
      width: 100%;
    }

    /* Cap-height alignment, not line-box alignment: the `Z` of the name and
       the `I` of the statement sit on the same optical top line. The 7px was
       measured from real ink metrics (canvas actualBoundingBoxAscent against
       each element's baseline), not eyeballed. */
    .hero__statements {
      margin-top: 7px;
    }
  }
</style>
