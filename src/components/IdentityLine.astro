---
// `Hi, I'm Zhuoqi.` with the pronunciation under the name. Shared by the
// homepage hero and the about page so the two cannot drift apart.
//
// Sizes come from the caller through two custom properties, because the two
// pages want different scales but the same composition:
//   --idl-greet  size of `Hi, I'm`   (default: the hero's)
//   --idl-name   size of the name    (default: the hero's, a step larger)
//   --idl-gap    space between them (default: 12px)
//   --idl-name-style  `italic` where the name should lean (default: normal)
//
// The pronunciation is an identity detail, not an instruction: no
// "pronounced", no separator, no dictionary labels.

interface Props {
  /** Stays in the main text colour. */
  greeting: string;
  /** Takes the accent — the one orange element in this viewport. */
  name: string;
  /** Bare transcription; the slashes are added here so they stay upright. */
  ipa?: string;
  /** Plain-English respelling, italic, beside the IPA with no separator. */
  respelling?: string;
  /** `h1` on a page whose title this is, `p` where a heading already exists. */
  as?: 'h1' | 'h2' | 'p';
}

const { greeting, name, ipa, respelling, as: Tag = 'p' } = Astro.props;
---

<Tag class="idl">
  <span class="idl__greet">{greeting}</span>

  {/* A column, so the pronunciation's left edge lands under the name rather
      than under the greeting. */}
  <span class="idl__namecol">
    <span class="idl__name">{name}</span>

    {
      (ipa || respelling) && (
        <span class="idl__say">
          {respelling && <span class="idl__resp">{respelling}</span>}
          {ipa && (
            <span class="idl__ipa">
              /<i>{Array.from(ipa).map((character, index) =>
                character === 'r' && ipa[index + 1] === 'ɔ'
                  ? <span class="idl__ipa-r">{character}</span>
                  : character
              )}</i>/
            </span>
          )}
        </span>
      )
    }
  </span>
</Tag>

<style>
  /* Baseline-aligned so the two sizes sit on one line, wrapping only when the
     viewport forces it. */
  .idl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* A fixed gap, not em: em would resolve against this container's own
       font-size rather than the display-size children. */
    font-size: var(--idl-greet, var(--fs-hello));
    column-gap: var(--idl-gap, var(--sp-12));
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-medium);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .idl__greet {
    line-height: 1.05;
  }

  .idl__namecol {
    display: flex;
    flex-direction: column;
  }

  /* Upright, accent. The emphasis rests on size and colour alone. */
  /* Bricolage Grotesque ships no italic, so `italic` here is a synthetic
     slant — on one word at display size that reads as emphasis. */
  .idl__name {
    font-size: var(--idl-name, var(--fs-hello-name));
    font-style: var(--idl-name-style, normal);
    line-height: 1.05;
    color: var(--accent);
  }

  /* A paler tint of the name's orange, so the line reads as belonging to the
     name rather than as a separate note. */
  .idl__say {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    font-weight: var(--fw-strong);
    letter-spacing: 0;
    color: color-mix(in srgb, var(--accent) 75%, var(--bg));
  }

  .idl__resp {
    font-style: italic;
  }

  /* The transcription is italic; the slashes that delimit it are not — they
     are notation, and a slash already leans. The tracking belongs to the
     transcription alone: phonetic symbols need the air, the respelling does
     not. */
  .idl__ipa {
    letter-spacing: 0.02em;
  }

  .idl__ipa i {
    font-style: italic;
  }

  .idl__ipa-r {
    margin-right: 0.12em;
  }
</style>
