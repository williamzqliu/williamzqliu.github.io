---
// `Hi, I'm Zhuoqi.` with the pronunciation under the name. Shared by the
// homepage hero and the about page so the two cannot drift apart.
//
// Sizes come from the caller through two custom properties, because the two
// pages want different scales but the same composition:
//   --idl-greet  size of `Hi, I'm`   (default: the hero's)
//   --idl-name   size of the name    (default: the hero's, a step larger)
//   --idl-gap    space between them (default: 12px)
//   --idl-name-style  `italic` where the name should lean (default: normal)
//
// The pronunciation is a plain-English respelling and nothing else. The IPA
// that used to sit beside it was dropped — a transcription most readers cannot
// parse is decoration, not help. The whole line is italic; the lead-in comes
// in separately so it can sit a weight below the respelling it introduces.

interface Props {
  /** Stays in the main text colour. */
  greeting: string;
  /** Takes the accent — the one orange element in this viewport. */
  name: string;
  /** Plain-English respelling, italic, under the name. */
  respelling?: string;
  /** Lead-in for the respelling — a label, so it sits a weight below it. */
  respellingLabel?: string;
  /** `h1` on a page whose title this is, `p` where a heading already exists. */
  as?: 'h1' | 'h2' | 'p';
}

const { greeting, name, respelling, respellingLabel, as: Tag = 'p' } = Astro.props;
---

<Tag class="idl">
  <span class="idl__greet">{greeting}</span>

  {/* A column, so the pronunciation's left edge lands under the name rather
      than under the greeting. */}
  <span class="idl__namecol">
    <span class="idl__name">{name}</span>

    {
      respelling && (
        <span class="idl__say">
          {respellingLabel && (
            <>
              <span class="idl__saylabel">{respellingLabel}</span>{' '}
            </>
          )}
          {respelling}
        </span>
      )
    }
  </span>
</Tag>

<style>
  /* Baseline-aligned so the two sizes sit on one line, wrapping only when the
     viewport forces it. */
  .idl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* A fixed gap, not em: em would resolve against this container's own
       font-size rather than the display-size children. */
    font-size: var(--idl-greet, var(--fs-hello));
    column-gap: var(--idl-gap, var(--sp-12));
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--fw-medium);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .idl__greet {
    line-height: 1.05;
  }

  .idl__namecol {
    display: flex;
    flex-direction: column;
  }

  /* Upright, accent. The emphasis rests on size and colour alone. */
  /* Bricolage Grotesque ships no italic, so `italic` here is a synthetic
     slant — on one word at display size that reads as emphasis. */
  .idl__name {
    font-size: var(--idl-name, var(--fs-hello-name));
    font-style: var(--idl-name-style, normal);
    line-height: 1.05;
    color: var(--accent);
  }

  /* A paler tint of the name's orange, so the line reads as belonging to the
     name rather than as a separate note. */
  .idl__say {
    /* One run of text with a word space in it, not two flex items: `pronounced
       “draw-chee”` is a phrase and should wrap like one. */
    display: block;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    font-style: italic;
    font-weight: var(--fw-strong);
    letter-spacing: 0;
    color: color-mix(in srgb, var(--accent) 75%, var(--bg));
  }

  /* A step lighter and a shade paler than what it introduces: the label is not
     the name. Mixing from `currentColor` keeps it relative, so it follows the
     line's tint in either theme instead of naming a second colour. */
  .idl__saylabel {
    /* 4px on top of the word space. The label and the respelling are two
       registers, so they need a little more air between them than two words
       of the same sentence would. */
    margin-right: 4px;
    font-weight: var(--fw-medium);
    color: color-mix(in srgb, currentColor 80%, var(--bg));
  }

  @media (max-width: 639px) {
    /* One size for the whole line: the greeting comes up to meet the name
       instead of sitting a tier below it, and both drop 2px from the 46px
       clamp floor. Written as each property's fallback, so a caller that sets
       its own scale (the about page) keeps it. */
    .idl {
      font-size: var(--idl-greet, 2.75rem);
    }

    .idl__name {
      font-size: var(--idl-name, 2.75rem);
    }

  }
</style>
