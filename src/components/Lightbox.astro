---
// Click an image in a case study to see it whole, then walk the rest.
//
// Screenshots of a tool are the one kind of media on this site where the
// column width is genuinely too small: a 2560px capture of an interface has
// detail in it that a 460px cell cannot show. Everything else here — covers,
// the portrait — is composed for the size it is printed at.
//
// Built on <dialog>, so the browser supplies the top layer, the focus trap and
// the inert background. What is left is the scrim, the picture, its caption,
// and three buttons.
---

<dialog class="lb" data-lightbox tabindex="-1" aria-label="Image viewer">
  <button class="lb__btn lb__close" type="button" data-lightbox-close aria-label="Close">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M2.5 2.5l9 9M11.5 2.5l-9 9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <button class="lb__btn lb__step lb__step--prev" type="button" data-lightbox-step="-1" aria-label="Previous image">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M9 1.5L3.5 7 9 12.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <button class="lb__btn lb__step lb__step--next" type="button" data-lightbox-step="1" aria-label="Next image">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M5 1.5L10.5 7 5 12.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <figure class="lb__figure">
    <img class="lb__img" data-lightbox-img alt="" />
    {/* A clip opens the same way a picture does. No controls here either —
        the viewer is the same object, only bigger. */}
    <video class="lb__vid" data-lightbox-vid muted loop playsinline preload="metadata" hidden
    ></video>
    <figcaption class="lb__cap" data-lightbox-cap hidden></figcaption>
  </figure>
</dialog>

<style>
  /* The scrim is on the dialog rather than on ::backdrop, which has its own
     inheritance rules for custom properties. Not quite opaque: the page stays
     faintly there behind it, so this reads as a layer over the article rather
     than as a different screen. */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    /* The sides are the page's own bleed, so an enlarged picture starts and
       ends exactly where the article's pictures do. There are no arrows on a
       phone to leave room for — the gesture is the control. */
    padding: var(--sp-16) var(--pad);
    border: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    /* Anywhere that is not an arrow closes it, so the whole surface says so. */
    cursor: zoom-out;
    /* The scrim arrives and leaves; `data-shown` is set a frame after the
       dialog opens and removed before it closes, so both ends animate. */
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .lb[data-shown] {
    opacity: 1;
  }

  .lb:not([open]) {
    display: none;
  }

  .lb[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb::backdrop {
    background: transparent;
  }

  /* The picture comes forward rather than appearing: a percent and a half of
     scale under the scrim's fade. Swapping fades the whole figure, so the
     caption travels with its image and the change of shape happens while
     there is nothing to see. */
  .lb__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-16);
    max-width: 100%;
    max-height: 100%;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 260ms var(--ease-out),
      transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lb[data-shown] .lb__figure {
    opacity: 1;
    transform: none;
  }

  /* Out on a small drift rather than a straight fade — the picture recedes
     half a percent while it goes, so the change reads as one movement instead
     of a cut. */
  .lb[data-shown] .lb__figure[data-swapping] {
    opacity: 0;
    transform: scale(0.995);
  }

  /* Under a finger the picture tracks the finger, so nothing may ease. The
     attribute is also used for the frame that re-seats the next picture on
     the far side before it slides in. */
  .lb__figure[data-dragging] {
    transition: none;
  }

  /* Whole, not filled: `contain` inside a box already smaller than the
     viewport, so a wide screenshot and a square one both land with air around
     them. `min-height: 0` lets the picture give way to the caption rather than
     pushing it off the bottom. */
  .lb__img,
  .lb__vid {
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    max-width: min(1600px, 100%);
    max-height: 100%;
    object-fit: contain;
  }

  .lb__vid[hidden],
  .lb__img[hidden] {
    display: none;
  }

  .lb__img[data-ground='paper'] {
    background: var(--paper);
  }

  /* The figure's own caption, in the caption treatment the article uses. */
  .lb__cap {
    flex: none;
    max-width: 68ch;
    text-align: center;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
    text-wrap: pretty;
  }

  .lb__cap[hidden] {
    display: none;
  }

  /* The caption is lifted from the article's own figcaption, so it carries the
     article's treatment of a product name with it. */
  .lb__cap em {
    font-style: italic;
    font-size: 0.945em;
  }

  /* Square, no fill, out of the picture's way. */
  .lb__btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: none;
    color: var(--text-2);
    cursor: pointer;
    -webkit-tap-highlight-color: var(--tap-press);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .lb__close {
    top: var(--sp-16);
    right: var(--sp-16);
  }

  .lb__step {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb__step--prev {
    left: var(--sp-4);
  }

  .lb__step--next {
    right: var(--sp-4);
  }

  /* Phone: no arrows. At this width they can only sit on the picture, and a
     picture you can throw sideways does not need a button to say so. The
     gesture is in the script; the arrows come back at 640px, where there is
     margin for them to stand in. */
  @media (max-width: 639px) {
    .lb__step {
      display: none;
    }
  }

  /* The shell takes focus when the viewer opens so that no control starts out
     ringed — it is a container, not a button, and it is never reached by Tab.
     Every control inside it keeps the site's focus ring. */
  .lb:focus {
    outline: none;
  }

  /* The gesture owns the horizontal; the page behind is already locked. */
  .lb {
    touch-action: pan-y;
  }

  /* One picture is not a gallery. */
  .lb[data-single] .lb__step {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .lb__btn:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (min-width: 640px) {
    .lb {
      padding: var(--sp-48) var(--sp-80);
    }

    .lb__close {
      top: var(--sp-24);
      right: var(--sp-24);
    }

    .lb__step--prev {
      left: var(--sp-16);
    }

    .lb__step--next {
      right: var(--sp-16);
    }
  }
</style>

<style is:global>
  /* Only the images that have more to show than the column can print. The
     cursor is the whole affordance — no overlay, no icon, no border. */
  .prose img,
  .prose video,
  .cs__media img {
    cursor: zoom-in;
  }
</style>

<script>
  // Opening is delegated from the document, so images that arrive with a new
  // page (ClientRouter swaps the body) need no re-binding of their own.
  const SOURCES = '.prose img, .prose video, .cs__media img';

  let listeners: AbortController | undefined;

  function initLightbox() {
    listeners?.abort();
    listeners = undefined;

    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const frame = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const clip = dialog?.querySelector<HTMLVideoElement>('[data-lightbox-vid]');
    const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-cap]');
    if (!dialog || !frame || !clip || !caption) return;

    listeners = new AbortController();
    const { signal } = listeners;

    // The gallery is every openable image on the page, in reading order, so
    // the arrows walk the article rather than one figure's siblings.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const figure = dialog.querySelector<HTMLElement>('.lb__figure');

    type Source = HTMLImageElement | HTMLVideoElement;
    const isClip = (element: Source): element is HTMLVideoElement => element.tagName === 'VIDEO';

    let gallery: Source[] = [];
    let index = 0;
    let swap: number | undefined;
    let closing: number | undefined;

    const render = () => {
      const source = gallery[index];

      if (isClip(source)) {
        frame.hidden = true;
        frame.removeAttribute('src');
        clip.hidden = false;
        // Carry on from where the page's copy is rather than restarting: the
        // clip the reader tapped is the clip they were already watching.
        const from = source.currentTime;
        clip.src = source.currentSrc || source.src;
        clip.setAttribute('aria-label', source.getAttribute('aria-label') ?? '');
        clip.addEventListener(
          'loadedmetadata',
          () => {
            clip.currentTime = from;
            void clip.play().catch(() => {});
          },
          { once: true }
        );
      } else {
        clip.pause();
        clip.hidden = true;
        clip.removeAttribute('src');
        frame.hidden = false;
        // `currentSrc` is what the browser actually chose, so a <picture> with
        // an art-directed phone crop opens the crop the reader is looking at.
        frame.src = source.currentSrc || source.src;
        frame.alt = source.alt;

        // A plate that needs paper under it on the page needs it here too, and
        // more so: the viewer's ground is the page dimmed, so ink on a
        // transparent background lands on a near-black wash in dark mode.
        if (source.dataset.ground) frame.dataset.ground = source.dataset.ground;
        else delete frame.dataset.ground;
      }

      const own = source.closest('figure')?.querySelector('figcaption');
      caption.innerHTML = own ? own.innerHTML : '';
      caption.hidden = !own;
    };

    const show = (next: number, animate = true) => {
      if (gallery.length === 0) return;
      // Wraps, because a viewer with three pictures should not dead-end.
      index = (next + gallery.length) % gallery.length;

      if (!animate || !figure || reduced.matches) {
        render();
        return;
      }

      // Out, swap, in — the same crossfade the section bar's label uses.
      window.clearTimeout(swap);
      figure.dataset.swapping = 'true';
      swap = window.setTimeout(() => {
        render();
        delete figure.dataset.swapping;
      }, 260); // matches the opacity transition on .lb__figure
    };

    const open = (source: Source) => {
      // Document order between blocks, and inside a mosaic the order the eye
      // takes: down the left column, then the tall one beside it. A mosaic is
      // the one place where the markup and the layout disagree on purpose, so
      // it is the only place that gets re-sorted — sorting the whole page
      // geometrically put a picture in a mosaic's right column after every
      // full-width clip further down the article. Both keys are rounded into
      // bands so this is a real ordering rather than a fuzzy comparison that
      // sorts differently depending on where it starts.
      const items = Array.from(document.querySelectorAll<Source>(SOURCES));
      const tile = (element: Source): Element => element.closest('.media-mosaic') ?? element;
      const seat = new Map<Element, number>();
      items.forEach((element, position) => {
        const group = tile(element);
        if (!seat.has(group)) seat.set(group, position);
      });
      const band = (value: number) => Math.round(value / 24);
      const at = (element: Element) => element.getBoundingClientRect();
      gallery = items.sort(
        (a, b) =>
          (seat.get(tile(a)) ?? 0) - (seat.get(tile(b)) ?? 0) ||
          band(at(a).left) - band(at(b).left) ||
          band(at(a).top) - band(at(b).top)
      );

      window.clearTimeout(closing);
      delete dialog.dataset.closing;
      dialog.toggleAttribute('data-single', gallery.length < 2);
      show(gallery.indexOf(source), false);
      dialog.showModal();
      // showModal focuses the first control it finds, which drew a focus ring
      // around the close button on a tap. The shell takes it instead: it is
      // not a control, it carries no ring, and Tab still lands on the button.
      dialog.focus({ preventScroll: true });
      // <dialog> makes the page inert but does not stop it scrolling behind.
      document.documentElement.style.overflow = 'hidden';
      // A frame later, so the browser has a state to transition away from.
      if (reduced.matches) dialog.dataset.shown = 'true';
      else requestAnimationFrame(() => requestAnimationFrame(() => (dialog.dataset.shown = 'true')));
    };

    // `dialog.close()` is instant, so the fade has to finish first.
    const dismiss = () => {
      if (!dialog.open || dialog.dataset.closing) return;
      delete dialog.dataset.shown;
      if (reduced.matches) {
        dialog.close();
        return;
      }
      dialog.dataset.closing = 'true';
      closing = window.setTimeout(() => {
        delete dialog.dataset.closing;
        dialog.close();
      }, 240); // matches --dur-base on the scrim
    };

    document.addEventListener(
      'click',
      (event) => {
        if (event.defaultPrevented || (event as MouseEvent).button !== 0) return;
        const image = (event.target as HTMLElement | null)?.closest<HTMLImageElement>(SOURCES);
        if (!image) return;
        // An image inside a link belongs to the link.
        if (image.closest('a')) return;
        open(image);
      },
      { signal }
    );

    // Everything closes it except the two arrows — including the picture. A
    // viewer you have to aim to leave is a viewer you are stuck in.
    dialog.addEventListener(
      'click',
      (event) => {
        // A swipe ends in a click. Without this, throwing the picture sideways
        // would step it and then close the viewer.
        if (threw) {
          threw = false;
          return;
        }
        const step = (event.target as HTMLElement | null)?.closest<HTMLElement>(
          '[data-lightbox-step]'
        );
        if (!step) {
          dismiss();
          return;
        }
        show(index + Number(step.dataset.lightboxStep));
      },
      { signal }
    );

    /* The phone has no arrows, so the picture itself is the control: drag it
       and it follows the finger, let go past a fifth of the width and it goes
       on in that direction while the next one comes in from the other side.
       Short of that it settles back. Mouse and trackpad keep the arrows —
       a pointer that cannot throw should not have to. */
    let startX = 0;
    let startY = 0;
    let dragX = 0;
    let holding: number | undefined;
    let sliding = false;
    let threw = false;

    const release = () => {
      holding = undefined;
      delete figure?.dataset.dragging;
    };

    const settle = (direction: number) => {
      if (!figure) {
        show(index + direction);
        return;
      }
      sliding = true;
      threw = true;
      window.clearTimeout(swap);
      figure.dataset.swapping = 'true';
      // Carries on the way it was thrown rather than stopping where the finger
      // stopped.
      figure.style.transform = `translateX(${direction * -18}%)`;
      swap = window.setTimeout(() => {
        index = (index + direction + gallery.length) % gallery.length;
        render();
        // Re-seated on the far side with the easing off, then let back to
        // centre in the next frame with it on.
        figure.dataset.dragging = 'true';
        figure.style.transform = `translateX(${direction * 18}%)`;
        requestAnimationFrame(() => {
          delete figure.dataset.dragging;
          figure.style.transform = '';
          delete figure.dataset.swapping;
          sliding = false;
        });
      }, 220);
    };

    dialog.addEventListener(
      'pointerdown',
      (event) => {
        if (event.pointerType === 'mouse' || sliding) return;
        if (gallery.length < 2 || !figure) return;
        if ((event.target as HTMLElement | null)?.closest('[data-lightbox-close]')) return;
        holding = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        dragX = 0;
        figure.dataset.dragging = 'true';
      },
      { signal }
    );

    dialog.addEventListener(
      'pointermove',
      (event) => {
        if (holding !== event.pointerId || !figure) return;
        const x = event.clientX - startX;
        const y = event.clientY - startY;
        // A gesture that is mostly vertical is not a swipe; hand it back.
        if (dragX === 0 && Math.abs(y) > Math.abs(x) && Math.abs(y) > 8) {
          figure.style.transform = '';
          release();
          return;
        }
        dragX = x;
        figure.style.transform = `translateX(${x}px)`;
      },
      { signal }
    );

    const drop = (event: PointerEvent) => {
      if (holding !== event.pointerId || !figure) return;
      release();
      const width = dialog.clientWidth || window.innerWidth;
      const thrown = dragX;
      dragX = 0;
      const travelled = Math.abs(thrown) > 6;
      if (Math.abs(thrown) > Math.min(96, width * 0.2)) {
        // Dragged left, so the next one is what the drag was reaching for.
        settle(thrown < 0 ? 1 : -1);
        return;
      }
      // Not far enough: back to centre, and swallow the click if this was a
      // drag rather than a tap.
      threw = travelled;
      figure.style.transform = '';
    };

    dialog.addEventListener('pointerup', drop, { signal });
    dialog.addEventListener('pointercancel', drop, { signal });

    // On the document, not on the dialog. A modal dialog usually holds focus,
    // but not always — open it without a real click, or let the engine hand
    // focus back to <body> after a viewport change, and a dialog-scoped
    // listener never hears the key at all. `dialog.open` is the guard.
    document.addEventListener(
      'keydown',
      (event) => {
        if (!dialog.open) return;
        // <dialog> closes itself on Escape, but only if nothing upstream has
        // taken the key first; handling it here makes the behaviour the
        // component's own.
        if (event.key === 'Escape') {
          event.preventDefault();
          dismiss();
          return;
        }
        if (dialog.hasAttribute('data-single')) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(index - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(index + 1);
        }
      },
      { signal }
    );

    dialog.addEventListener(
      'close',
      () => {
        document.documentElement.style.overflow = '';
        delete dialog.dataset.shown;
        frame.removeAttribute('src');
        clip.pause();
        clip.removeAttribute('src');
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', initLightbox);
  initLightbox();
</script>
