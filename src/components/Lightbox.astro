---
// Click an image in a case study to see it whole, then walk the rest.
//
// Screenshots of a tool are the one kind of media on this site where the
// column width is genuinely too small: a 2560px capture of an interface has
// detail in it that a 460px cell cannot show. Everything else here — covers,
// the portrait — is composed for the size it is printed at.
//
// Built on <dialog>, so the browser supplies the top layer, the focus trap and
// the inert background. What is left is the scrim, the picture, its caption,
// and three buttons.
---

<dialog class="lb" data-lightbox tabindex="-1" aria-label="Image viewer">
  <button class="lb__btn lb__close" type="button" data-lightbox-close aria-label="Close">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M2.5 2.5l9 9M11.5 2.5l-9 9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <button class="lb__btn lb__step lb__step--prev" type="button" data-lightbox-step="-1" aria-label="Previous image">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M9 1.5L3.5 7 9 12.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <button class="lb__btn lb__step lb__step--next" type="button" data-lightbox-step="1" aria-label="Next image">
    <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false">
      <path
        d="M5 1.5L10.5 7 5 12.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <figure class="lb__figure">
    <img class="lb__img" data-lightbox-img alt="" />
    {/* A clip opens the same way a picture does. No controls here either —
        the viewer is the same object, only bigger. */}
    <video class="lb__vid" data-lightbox-vid muted loop playsinline preload="metadata" hidden
    ></video>
    <figcaption class="lb__cap" data-lightbox-cap hidden></figcaption>
  </figure>
</dialog>

<style>
  /* The scrim is on the dialog rather than on ::backdrop, which has its own
     inheritance rules for custom properties. Not quite opaque: the page stays
     faintly there behind it, so this reads as a layer over the article rather
     than as a different screen. */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    /* The sides are the page's own bleed, so an enlarged picture starts and
       ends exactly where the article's pictures do. There are no arrows on a
       phone to leave room for — the gesture is the control. */
    padding: var(--sp-16) var(--pad);
    border: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    /* Anywhere that is not an arrow closes it, so the whole surface says so. */
    cursor: zoom-out;
    /* The scrim arrives and leaves; `data-shown` is set a frame after the
       dialog opens and removed before it closes, so both ends animate. */
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .lb[data-shown] {
    opacity: 1;
  }

  .lb:not([open]) {
    display: none;
  }

  .lb[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Detail view, fine pointers only. The picture goes to its own size, which
     is usually bigger than the screen, and the viewer becomes the thing you
     scroll — the way you would read a large drawing rather than drag it. Safe
     centring so an oversized picture is still reachable at its top and left;
     plain centring pins the overflow out of scroll range. */
  .lb[data-zoomed] {
    overflow: auto;
    align-items: safe center;
    justify-content: safe center;
    cursor: default;
  }

  .lb[data-zoomed] .lb__figure {
    max-width: none;
    max-height: none;
    flex: none;
  }

  .lb[data-zoomed] .lb__img {
    max-width: none;
    max-height: none;
    /* A haul across a large picture should not select the caption on the way. */
    user-select: none;
    -webkit-user-drag: none;
  }

  /* The chrome stays where the window is, not where the picture is: with the
     viewer scrolled into the middle of a large image, the close button has to
     be in the corner of the screen rather than in the corner of the picture. */
  .lb[data-zoomed] .lb__btn {
    position: fixed;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Two states, and the cursor is the whole affordance — no toolbar, no
       percentage. */
    .lb__img {
      cursor: zoom-in;
    }

    .lb[data-zoomed] .lb__img {
      cursor: zoom-out;
    }

    /* While the picture is being hauled the hand closes. It has to be set on
       the dialog as well as the picture: the drag captures the pointer on the
       dialog, so the dialog's own cursor is the one the window shows. */
    .lb[data-hauling],
    .lb[data-hauling] .lb__img {
      cursor: grabbing;
    }
  }

  .lb::backdrop {
    background: transparent;
  }

  /* The picture comes forward rather than appearing: a percent and a half of
     scale under the scrim's fade. Swapping fades the whole figure, so the
     caption travels with its image and the change of shape happens while
     there is nothing to see. */
  .lb__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-16);
    max-width: 100%;
    max-height: 100%;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 280ms cubic-bezier(0.33, 0, 0.2, 1),
      transform 280ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lb[data-shown] .lb__figure {
    opacity: 1;
    transform: none;
  }

  /* Out on a small drift rather than a straight fade — the picture recedes
     half a percent while it goes, so the change reads as one movement instead
     of a cut.

     Leaving is quicker than arriving. The two halves run one after the other,
     never together, so their sum is the wait between two pictures: at 280 each
     that wait was most of a second, which reads as the viewer thinking. 150
     out and 280 in keeps the arrival calm and takes a third off the gap. */
  .lb[data-shown] .lb__figure[data-swapping] {
    opacity: 0;
    transform: scale(0.995);
    transition-duration: 150ms;
  }

  /* Pinch and pan are direct: the picture is under the fingers, so it may not
     ease behind them. Off the gesture, the same property eases, which is what
     lets a zoom settle back to the fitted size in one soft move. */
  .lb__img,
  .lb__vid {
    transform-origin: center center;
    transition:
      transform var(--dur-base) var(--ease-out),
      width 300ms var(--ease-out);
  }

  .lb__img[data-gesturing],
  .lb__vid[data-gesturing] {
    transition: none;
  }

  /* Whole, not filled: `contain` inside a box already smaller than the
     viewport, so a wide screenshot and a square one both land with air around
     them. `min-height: 0` lets the picture give way to the caption rather than
     pushing it off the bottom. */
  .lb__img,
  .lb__vid {
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    max-width: min(1600px, 100%);
    max-height: 100%;
    object-fit: contain;
  }

  .lb__vid[hidden],
  .lb__img[hidden] {
    display: none;
  }

  .lb__img[data-ground='paper'] {
    background: var(--paper);
  }

  /* The figure's own caption, in the caption treatment the article uses. */
  .lb__cap {
    flex: none;
    max-width: 68ch;
    text-align: center;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
    text-wrap: pretty;
  }

  .lb__cap[hidden] {
    display: none;
  }

  /* The caption is lifted from the article's own figcaption, so it carries the
     article's treatment of a product name with it. */
  .lb__cap em {
    font-style: italic;
    font-size: 0.945em;
  }

  /* Square, no fill, out of the picture's way. */
  .lb__btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: none;
    color: var(--text-2);
    cursor: pointer;
    -webkit-tap-highlight-color: var(--tap-press);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .lb__close {
    top: var(--sp-16);
    right: var(--sp-16);
  }

  .lb__step {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb__step--prev {
    left: var(--sp-4);
  }

  .lb__step--next {
    right: var(--sp-4);
  }

  /* Phone: no arrows. At this width they can only sit on the picture, and a
     picture you can throw sideways does not need a button to say so. The
     gesture is in the script; the arrows come back at 640px, where there is
     margin for them to stand in. */
  @media (max-width: 639px) {
    .lb__step {
      display: none;
    }
  }

  /* The shell takes focus when the viewer opens so that no control starts out
     ringed — it is a container, not a button, and it is never reached by Tab.
     Every control inside it keeps the site's focus ring. */
  .lb:focus {
    outline: none;
  }

  /* The viewer owns every gesture inside it: swipe, pinch and pan are read
     here rather than by the browser, and the page behind is already locked.
     Vertical is still yielded — in the script, by not acting on it. */
  .lb {
    touch-action: none;
  }

  /* One picture is not a gallery. */
  .lb[data-single] .lb__step {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .lb__btn:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (min-width: 640px) {
    .lb {
      padding: var(--sp-48) var(--sp-80);
    }

    .lb__close {
      top: var(--sp-24);
      right: var(--sp-24);
    }

    .lb__step--prev {
      left: var(--sp-16);
    }

    .lb__step--next {
      right: var(--sp-16);
    }
  }
</style>

<style is:global>
  /* Only the images that have more to show than the column can print. The
     cursor is the whole affordance — no overlay, no icon, no border. Anything
     marked `data-nozoom`, a head or a figure in the article, is excluded from
     both this and the gallery below: one selector, so the cursor can never
     promise a viewer that will not open.

     Documentary photographs of people carry `data-nozoom`. They are context
     and evidence, and enlarging a face adds nothing a reader needs; the
     viewer is for artifacts whose detail is part of the reading, which is
     system maps, blueprints, wireframes, interface screens and product
     close-ups. */
  .prose img:not([data-nozoom]),
  .prose video:not([data-nozoom]),
  .cs__media:not([data-nozoom]) img {
    cursor: zoom-in;
  }
</style>

<script>
  // Opening is delegated from the document, so images that arrive with a new
  // page (ClientRouter swaps the body) need no re-binding of their own.
  const SOURCES =
    '.prose img:not([data-nozoom]), .prose video:not([data-nozoom]), .cs__media:not([data-nozoom]) img';

  let listeners: AbortController | undefined;

  function initLightbox() {
    listeners?.abort();
    listeners = undefined;

    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const frame = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const clip = dialog?.querySelector<HTMLVideoElement>('[data-lightbox-vid]');
    const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-cap]');
    if (!dialog || !frame || !clip || !caption) return;

    listeners = new AbortController();
    const { signal } = listeners;

    // The gallery is every openable image on the page, in reading order, so
    // the arrows walk the article rather than one figure's siblings.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const figure = dialog.querySelector<HTMLElement>('.lb__figure');

    type Source = HTMLImageElement | HTMLVideoElement;
    const isClip = (element: Source): element is HTMLVideoElement => element.tagName === 'VIDEO';

    let gallery: Source[] = [];
    let index = 0;
    let swap: number | undefined;
    let closing: number | undefined;

    // Fine pointers get a second click: fitted, then the picture's own size.
    // Touch keeps pinch and pan, which is a different model on purpose.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    const unzoomDetail = () => {
      delete dialog.dataset.zoomed;
      frame.style.width = '';
      dialog.scrollTo(0, 0);
    };

    const toggleDetail = () => {
      if (dialog.dataset.zoomed) {
        unzoomDetail();
        return;
      }
      // Natural size, or twice the fitted size when the file is small — the
      // point of the second click is that it is a real change.
      const fitted = frame.getBoundingClientRect().width;
      if (!fitted) return;
      dialog.dataset.zoomed = 'true';
      frame.style.width = `${Math.round(Math.max(frame.naturalWidth, fitted * 2))}px`;
      // Open on the middle of the picture rather than its corner.
      requestAnimationFrame(() => {
        dialog.scrollTo({
          left: (dialog.scrollWidth - dialog.clientWidth) / 2,
          top: (dialog.scrollHeight - dialog.clientHeight) / 2,
        });
      });
    };

    const render = () => {
      const source = gallery[index];

      // A new picture always arrives fitted, at the top of the scroll.
      unzoomDetail();

      // A new picture arrives at its own size and centred: zoom belongs to the
      // picture being looked at, never to the viewer. The swap happens under a
      // fade, so there is nothing to animate back.
      scale = 1;
      panX = 0;
      panY = 0;
      frame.style.transform = '';
      clip.style.transform = '';
      delete frame.dataset.gesturing;
      delete clip.dataset.gesturing;

      if (isClip(source)) {
        frame.hidden = true;
        frame.removeAttribute('src');
        clip.hidden = false;
        // Carry on from where the page's copy is rather than restarting: the
        // clip the reader tapped is the clip they were already watching.
        const from = source.currentTime;
        clip.src = source.currentSrc || source.src;
        clip.setAttribute('aria-label', source.getAttribute('aria-label') ?? '');
        clip.addEventListener(
          'loadedmetadata',
          () => {
            clip.currentTime = from;
            void clip.play().catch(() => {});
          },
          { once: true }
        );
      } else {
        clip.pause();
        clip.hidden = true;
        clip.removeAttribute('src');
        frame.hidden = false;
        // `currentSrc` is what the browser actually chose, so a <picture> with
        // an art-directed phone crop opens the crop the reader is looking at.
        frame.src = source.currentSrc || source.src;
        frame.alt = source.alt;

        // A plate that needs paper under it on the page needs it here too, and
        // more so: the viewer's ground is the page dimmed, so ink on a
        // transparent background lands on a near-black wash in dark mode.
        if (source.dataset.ground) frame.dataset.ground = source.dataset.ground;
        else delete frame.dataset.ground;
      }

      const own = source.closest('figure')?.querySelector('figcaption');
      caption.innerHTML = own ? own.innerHTML : '';
      caption.hidden = !own;
    };

    const show = (next: number, animate = true) => {
      if (gallery.length === 0) return;
      // Wraps, because a viewer with three pictures should not dead-end.
      index = (next + gallery.length) % gallery.length;

      if (!animate || !figure || reduced.matches) {
        render();
        return;
      }

      // Out, swap, in. One crossfade for every way of changing picture — a
      // swipe, an arrow and an arrow key all read the same: a change of page
      // rather than a carousel snapping across.
      window.clearTimeout(swap);
      figure.dataset.swapping = 'true';
      swap = window.setTimeout(() => {
        render();
        delete figure.dataset.swapping;
      }, 150); // matches the fade out on .lb__figure[data-swapping]
    };

    const open = (source: Source) => {
      // Document order between blocks, and inside a mosaic the order the eye
      // takes: down the left column, then the tall one beside it. A mosaic is
      // the one place where the markup and the layout disagree on purpose, so
      // it is the only place that gets re-sorted — sorting the whole page
      // geometrically put a picture in a mosaic's right column after every
      // full-width clip further down the article. Both keys are rounded into
      // bands so this is a real ordering rather than a fuzzy comparison that
      // sorts differently depending on where it starts.
      const items = Array.from(document.querySelectorAll<Source>(SOURCES));
      const tile = (element: Source): Element => element.closest('.media-mosaic') ?? element;
      const seat = new Map<Element, number>();
      items.forEach((element, position) => {
        const group = tile(element);
        if (!seat.has(group)) seat.set(group, position);
      });
      const band = (value: number) => Math.round(value / 24);
      const at = (element: Element) => element.getBoundingClientRect();
      gallery = items.sort(
        (a, b) =>
          (seat.get(tile(a)) ?? 0) - (seat.get(tile(b)) ?? 0) ||
          band(at(a).left) - band(at(b).left) ||
          band(at(a).top) - band(at(b).top)
      );

      window.clearTimeout(closing);
      delete dialog.dataset.closing;
      dialog.toggleAttribute('data-single', gallery.length < 2);
      show(gallery.indexOf(source), false);
      dialog.showModal();
      // showModal focuses the first control it finds, which drew a focus ring
      // around the close button on a tap. The shell takes it instead: it is
      // not a control, it carries no ring, and Tab still lands on the button.
      dialog.focus({ preventScroll: true });
      // <dialog> makes the page inert but does not stop it scrolling behind.
      document.documentElement.style.overflow = 'hidden';
      // A frame later, so the browser has a state to transition away from.
      if (reduced.matches) dialog.dataset.shown = 'true';
      else requestAnimationFrame(() => requestAnimationFrame(() => (dialog.dataset.shown = 'true')));
    };

    // `dialog.close()` is instant, so the fade has to finish first.
    const dismiss = () => {
      if (!dialog.open || dialog.dataset.closing) return;
      delete dialog.dataset.shown;
      if (reduced.matches) {
        dialog.close();
        return;
      }
      dialog.dataset.closing = 'true';
      closing = window.setTimeout(() => {
        delete dialog.dataset.closing;
        dialog.close();
      }, 240); // matches --dur-base on the scrim
    };

    document.addEventListener(
      'click',
      (event) => {
        if (event.defaultPrevented || (event as MouseEvent).button !== 0) return;
        const image = (event.target as HTMLElement | null)?.closest<HTMLImageElement>(SOURCES);
        if (!image) return;
        // An image inside a link belongs to the link.
        if (image.closest('a')) return;
        open(image);
      },
      { signal }
    );

    // Everything closes it except the two arrows — including the picture. A
    // viewer you have to aim to leave is a viewer you are stuck in.
    dialog.addEventListener(
      'click',
      (event) => {
        // A swipe ends in a click. Without this, throwing the picture sideways
        // would step it and then close the viewer.
        if (threw) {
          threw = false;
          return;
        }
        const step = (event.target as HTMLElement | null)?.closest<HTMLElement>(
          '[data-lightbox-step]'
        );
        if (step) {
          show(index + Number(step.dataset.lightboxStep));
          return;
        }
        // The picture itself is the zoom control on a mouse or trackpad; the
        // scrim around it still closes. On touch a tap closes, as before.
        if (fine.matches && (event.target as HTMLElement | null)?.closest('[data-lightbox-img]')) {
          toggleDetail();
          return;
        }
        dismiss();
      },
      { signal }
    );

    /* Touch, and only touch. A phone has no arrows, so the gestures are the
       controls: a short horizontal flick steps, two fingers zoom, and one
       finger pans once there is something to pan. Mouse and trackpad keep the
       arrows and the keys exactly as they were.

       The picture does not follow the finger. A swipe here is an input, not a
       carousel being dragged: nothing moves until the gesture has been read,
       and a gesture that does not qualify leaves the frame exactly where it
       was — no travel, no snap back, no flicker. */
    const SWIPE_MIN = 24; // px: deliberate, but nothing like a full drag
    const FLICK_MIN = 12; // px, when it is thrown rather than dragged
    const FLICK_RATE = 0.35; // px per ms
    const YIELD_AT = 10; // px of vertical before the gesture is theirs, not ours
    const ZOOM_MAX = 4;

    const touches = new Map<number, { x: number; y: number }>();
    let startX = 0;
    let startY = 0;
    let startAt = 0;
    let reading = false; // a one-finger gesture we might still act on
    let threw = false; // swallow the click a real gesture ends with

    let scale = 1;
    let panX = 0;
    let panY = 0;
    let fromScale = 1;
    let fromSpan = 0;
    let fromPan = { x: 0, y: 0 };
    let centre = { x: 0, y: 0 };
    let anchor = { x: 0, y: 0 };

    const shown = (): HTMLElement => (clip.hidden ? frame : clip);

    const paint = () => {
      shown().style.transform =
        scale === 1 ? '' : `translate(${panX}px, ${panY}px) scale(${scale})`;
    };

    // Never so far that the picture leaves the frame: at 1x there is nothing
    // to pan, and above it the slack is however much of the picture is now
    // outside the box it was fitted to.
    const rein = () => {
      const media = shown();
      const slackX = (media.offsetWidth * (scale - 1)) / 2;
      const slackY = (media.offsetHeight * (scale - 1)) / 2;
      panX = Math.min(slackX, Math.max(-slackX, panX));
      panY = Math.min(slackY, Math.max(-slackY, panY));
    };

    // Every picture opens at its own size. Zoom belongs to the picture being
    // looked at, not to the viewer.
    const unzoom = (animate = false) => {
      const media = shown();
      scale = 1;
      panX = 0;
      panY = 0;
      if (animate) {
        media.style.transform = '';
        return;
      }
      media.dataset.gesturing = 'true';
      media.style.transform = '';
      requestAnimationFrame(() => delete media.dataset.gesturing);
    };

    const span = () => {
      const [a, b] = [...touches.values()];
      return Math.hypot(a.x - b.x, a.y - b.y);
    };

    const middle = () => {
      const [a, b] = [...touches.values()];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    };

    const startPinch = () => {
      const media = shown();
      const box = media.getBoundingClientRect();
      // Where the picture sits with nothing applied: scaling about the centre
      // does not move the centre, so only the pan has to come back out.
      centre = { x: (box.left + box.right) / 2 - panX, y: (box.top + box.bottom) / 2 - panY };
      anchor = middle();
      fromSpan = span();
      fromScale = scale;
      fromPan = { x: panX, y: panY };
      media.dataset.gesturing = 'true';
      reading = false;
    };

    dialog.addEventListener(
      'pointerdown',
      (event) => {
        if (event.pointerType === 'mouse') return;
        if ((event.target as HTMLElement | null)?.closest('[data-lightbox-close]')) return;
        touches.set(event.pointerId, { x: event.clientX, y: event.clientY });

        if (touches.size === 2) {
          startPinch();
          return;
        }
        if (touches.size > 2) return;

        startX = event.clientX;
        startY = event.clientY;
        startAt = event.timeStamp;
        fromPan = { x: panX, y: panY };
        reading = true;
        if (scale > 1) shown().dataset.gesturing = 'true';
      },
      { signal }
    );

    dialog.addEventListener(
      'pointermove',
      (event) => {
        const held = touches.get(event.pointerId);
        if (!held) return;
        held.x = event.clientX;
        held.y = event.clientY;

        if (touches.size >= 2) {
          if (!fromSpan) return;
          scale = Math.min(ZOOM_MAX, Math.max(1, (fromScale * span()) / fromSpan));
          const now = middle();
          // The point between the fingers stays under them, and the fingers
          // may travel while they pinch.
          const drift = 1 - scale / fromScale;
          panX = fromPan.x + (anchor.x - centre.x - fromPan.x) * drift + (now.x - anchor.x);
          panY = fromPan.y + (anchor.y - centre.y - fromPan.y) * drift + (now.y - anchor.y);
          rein();
          paint();
          return;
        }

        if (!reading) return;
        const x = event.clientX - startX;
        const y = event.clientY - startY;

        // Zoomed in, one finger moves the picture rather than the gallery.
        if (scale > 1) {
          panX = fromPan.x + x;
          panY = fromPan.y + y;
          rein();
          paint();
          return;
        }

        // Mostly vertical: not ours. Hand it back rather than half-reading it.
        if (Math.abs(y) > Math.abs(x) && Math.abs(y) > YIELD_AT) reading = false;
      },
      { signal }
    );

    const lift = (event: PointerEvent) => {
      if (!touches.has(event.pointerId)) return;
      touches.delete(event.pointerId);

      if (touches.size >= 1) {
        // A finger left mid-pinch. Carry on with the one still down instead of
        // reading the leftover travel as a swipe.
        fromSpan = 0;
        const [only] = [...touches.values()];
        startX = only.x;
        startY = only.y;
        startAt = event.timeStamp;
        fromPan = { x: panX, y: panY };
        reading = touches.size === 1 && scale > 1;
        return;
      }

      const media = shown();
      delete media.dataset.gesturing;
      fromSpan = 0;

      if (scale > 1) {
        // A pan ends where it ends, and it eats the click it came with.
        threw = reading && (Math.abs(event.clientX - startX) > 6 || Math.abs(event.clientY - startY) > 6);
        reading = false;
        return;
      }
      // A pinch that came back down to 1x leaves no offset behind.
      if (panX !== 0 || panY !== 0) unzoom(true);

      if (!reading) return;
      reading = false;

      const x = event.clientX - startX;
      const y = event.clientY - startY;
      const rate = Math.abs(x) / Math.max(1, event.timeStamp - startAt);
      const sideways = Math.abs(x) > Math.abs(y) * 1.2;
      const enough = Math.abs(x) >= SWIPE_MIN || (rate >= FLICK_RATE && Math.abs(x) >= FLICK_MIN);

      if (gallery.length > 1 && sideways && enough) {
        threw = true;
        // Left means forward: the next picture is the one the hand reached for.
        show(index + (x < 0 ? 1 : -1));
        return;
      }
      // Not a swipe. Nothing moved, so there is nothing to put back; the only
      // thing left to decide is whether this was a tap, which closes.
      threw = Math.abs(x) > 6 || Math.abs(y) > 6;
    };

    dialog.addEventListener('pointerup', lift, { signal });
    dialog.addEventListener('pointercancel', lift, { signal });

    /* Mouse and trackpad: the wheel steps the gallery. A wheel is the one
       input a pointer device has that a swipe would be, and there is nothing
       to scroll inside the viewer anyway.

       Deltas are accumulated rather than acted on one by one: a trackpad
       sends dozens of small ones per flick, and a step per event would run
       the whole gallery past in a second. Past the threshold it steps once
       and then ignores everything until the crossfade has finished. */
    const WHEEL_STEP = 60; // px of accumulated delta
    const WHEEL_REST = 500; // ms of quiet after a step
    let rolled = 0;
    let rolledAt = 0;
    let steppedAt = 0;

    /* Zoomed in, the picture can also be pushed around with the mouse. The
       scrollbars are still the primary control — this is the shortcut for
       moving a long way without reaching for them. It scrolls the container
       rather than transforming the picture, so both stay in agreement.

       The cursor stays `zoom-out` at rest: the click is still what returns the
       picture to its fitted size, and only the drag itself shows a grabbing
       hand. */
    let hauling = false;
    let haulX = 0;
    let haulY = 0;
    let fromLeft = 0;
    let fromTop = 0;

    dialog.addEventListener(
      'pointerdown',
      (event) => {
        if (event.pointerType !== 'mouse' || !dialog.dataset.zoomed) return;
        if (!(event.target as HTMLElement | null)?.closest('[data-lightbox-img]')) return;
        hauling = true;
        haulX = event.clientX;
        haulY = event.clientY;
        fromLeft = dialog.scrollLeft;
        fromTop = dialog.scrollTop;
        dialog.dataset.hauling = 'true';
        dialog.setPointerCapture(event.pointerId);
      },
      { signal }
    );

    dialog.addEventListener(
      'pointermove',
      (event) => {
        if (!hauling) return;
        event.preventDefault();
        dialog.scrollTo(fromLeft - (event.clientX - haulX), fromTop - (event.clientY - haulY));
      },
      { signal }
    );

    const drop2 = (event: PointerEvent) => {
      if (!hauling) return;
      hauling = false;
      delete dialog.dataset.hauling;
      if (dialog.hasPointerCapture(event.pointerId)) dialog.releasePointerCapture(event.pointerId);
      // A drag ends in a click; without this the picture would snap back to
      // fitted every time it was moved.
      if (Math.abs(event.clientX - haulX) > 4 || Math.abs(event.clientY - haulY) > 4) threw = true;
    };

    dialog.addEventListener('pointerup', drop2, { signal });
    dialog.addEventListener('pointercancel', drop2, { signal });

    // The browser's own image drag would start a ghost image mid-haul.
    frame.addEventListener('dragstart', (event) => event.preventDefault(), { signal });

    dialog.addEventListener(
      'wheel',
      (event) => {
        // Zoomed in, the wheel belongs to the scrollbars.
        if (dialog.dataset.zoomed) return;
        if (gallery.length < 2 || scale > 1) return;
        event.preventDefault();

        const now = event.timeStamp;
        if (now - steppedAt < WHEEL_REST) return;
        // A new gesture starts a new count, and so does a change of direction.
        const push = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        if (now - rolledAt > 200 || Math.sign(push) !== Math.sign(rolled)) rolled = 0;
        rolledAt = now;
        rolled += push;

        if (Math.abs(rolled) < WHEEL_STEP) return;
        steppedAt = now;
        rolled = 0;
        // Down and right go forward, the way a page and a filmstrip do.
        show(index + (push > 0 ? 1 : -1));
      },
      { signal, passive: false }
    );

    // On the document, not on the dialog. A modal dialog usually holds focus,
    // but not always — open it without a real click, or let the engine hand
    // focus back to <body> after a viewport change, and a dialog-scoped
    // listener never hears the key at all. `dialog.open` is the guard.
    document.addEventListener(
      'keydown',
      (event) => {
        if (!dialog.open) return;
        // <dialog> closes itself on Escape, but only if nothing upstream has
        // taken the key first; handling it here makes the behaviour the
        // component's own.
        if (event.key === 'Escape') {
          event.preventDefault();
          dismiss();
          return;
        }
        if (dialog.hasAttribute('data-single')) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(index - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(index + 1);
        }
      },
      { signal }
    );

    dialog.addEventListener(
      'close',
      () => {
        document.documentElement.style.overflow = '';
        delete dialog.dataset.shown;
        unzoomDetail();
        frame.removeAttribute('src');
        clip.pause();
        clip.removeAttribute('src');
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', initLightbox);
  initLightbox();
</script>
