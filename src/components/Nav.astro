---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  // The second entry point is not built. SPEC §1: it waits for the software
  // projects and is not called `engineering` — that word is half-claimed by
  // Design Engineer titles. Re-enable this line when the first one ships.
  // { href: '/code', label: 'Code' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
];

const showNav = navLinks.length > 1;

---

<header class="nav" transition:name="site-nav" transition:animate="none">
  <div class:list={['container', 'nav__inner', !showNav && 'nav__inner--bare']}>
    <a class="nav__name" href="/">Zhuoqi Liu</a>

    {showNav && (
    <nav class="nav__links" aria-label="Primary">
      <ul class="nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a
                class="nav__link"
                href={link.href}
                aria-current={link.href === current ? 'page' : undefined}
                data-astro-prefetch
                data-nav-link
              >
                <span class="nav__label">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    )}

    <div class="nav__toggle">
      <ThemeToggle />
    </div>
  </div>

  {/* Reading position, drawn on the header's own hairline. Scale only, so it
      composites on the GPU and never reflows the page. Shown on case studies
      only — see the script. */}
  <div class="nav__progress" aria-hidden="true"></div>
</header>

<style>
  /* No rule at rest: at the top of the page the header should read as part of
     the page, not as a bar on top of it. The divider appears only once content
     has scrolled underneath, and even then it is the faintest line available. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--rule-hair) solid transparent;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .nav[data-scrolled] {
    border-bottom-color: color-mix(in srgb, var(--rule) 70%, var(--bg));
  }

  .nav__inner {
    display: grid;
    grid-template-areas:
      'name toggle'
      'links links';
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--sp-16);
    row-gap: var(--sp-12);
    padding-block: var(--sp-12) 0;
  }

  /* No link row yet — collapse to a single row and restore the vertical
     padding the links were providing. */
  .nav__inner--bare {
    grid-template-areas: 'name toggle';
    row-gap: 0;
    padding-block: var(--sp-12);
  }

  /* Body face. The display face is reserved for the hero identity line,
     project titles and section headings; a wordmark in it competes with the
     hero for the same job. */
  .nav__name {
    position: relative;
    grid-area: name;
    /* A grid item fills its track unless told otherwise, and on a phone this
       one sits in a `1fr` column — so the link's box, and the touch layer
       drawn across it below, ran from the wordmark to the theme toggle. The
       link is now as wide as the words are. No effect above 640px, where the
       column is already `auto`. */
    justify-self: start;
    font-size: var(--fs-body);
    font-weight: var(--fw-strong);
    letter-spacing: -0.015em;
    /* Ink at rest, not orange: the accent belongs to the name in the hero,
       and two oranges in one viewport spend it twice. It is still a link, so
       it takes the accent under the pointer like every other one. */
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__name:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  /* 44px of touch without a 44px-tall wordmark in the header. */
  .nav__name::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: var(--tap);
    transform: translateY(-50%);
  }

  .nav__links {
    grid-area: links;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--pad) * -1);
    padding-inline: var(--pad);
  }

  .nav__links::-webkit-scrollbar {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--sp-24);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .nav__list {
      gap: var(--sp-32);
    }
  }

  /* Body face, sentence case. Never mono. */
  .nav__link {
    position: relative;
    display: inline-block;
    font-size: var(--fs-nav);
    font-weight: var(--fw-strong);
    color: var(--text-3);
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Colour, weight, and a 2px rule that is as wide as the word and sits 9px
     under it. Drawn with ::after rather than a border so the indicator has no
     effect on the row's height. */
  .nav__link[aria-current='page'] {
    color: var(--text);
    font-weight: var(--fw-strong);
  }

  /* Measured from the text, not from the link box: the indicator is exactly
     as wide as the word and sits 9px under it whatever the row padding is. */
  .nav__label {
    position: relative;
    display: inline-block;
  }

  /* Keep the active rule stable across swaps instead of replaying an entrance. */
  .nav__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 5px);
    height: 2px;
    background: var(--rule-strong);
    transform: scaleX(0);
    transform-origin: center;
  }

  .nav__link[aria-current='page'] .nav__label::after {
    transform: scaleX(1);
  }

  /* On a phone the header is short and the reading-progress line runs along
     its bottom edge, so the two rules end up almost touching and read as one
     thick indicator. The black one moves up rather than the orange one down:
     the progress line belongs to the header's edge. */
  @media (max-width: 639px) {
    .nav__label::after {
      top: calc(100% + 1px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    /* Hover is colour only. The rule belongs to the current page. */
    .nav__link:hover {
      color: var(--text);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__link:active {
      transition-duration: var(--dur-press);
      color: var(--text);
    }
  }

  /* Hidden until the script says this page is a long-form read. */
  .nav__progress[hidden] {
    display: none;
  }

  .nav__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: var(--rule-heavy);
    background: var(--accent);
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: left center;
  }

  .nav__toggle {
    grid-area: toggle;
    justify-self: end;
  }

  @media (min-width: 640px) {
    .nav__inner--bare {
      padding-block: var(--sp-16);
    }

    .nav__inner {
      grid-template-areas: 'name links toggle';
      grid-template-columns: auto 1fr auto;
      column-gap: var(--sp-32);
      row-gap: 0;
      /* Fixed chrome height. Setting it here rather than adding up paddings
         means the links and the toggle cannot change it. */
      min-height: 62px;
      padding-block: 0;
    }

    .nav__links {
      overflow-x: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .nav__list {
      justify-content: flex-end;
    }

    /* Shorter chrome. The 44px minimum is a touch requirement, and this tier
       is mouse and trackpad; mobile keeps its taller row. */
    .nav__link {
      padding-block: var(--sp-8);
    }
  }
</style>

<script>
  // Re-selecting this URL should not restart the page transition.
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-nav-link]') : null;
    if (!link || link.target || link.hasAttribute('download')) return;
    const target = new URL(link.href);
    const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
    if (target.origin === location.origin && normalize(target.pathname) === normalize(location.pathname) && target.search === location.search && target.hash === location.hash) event.preventDefault();
  }, { capture: true });

  // Reading position for the sticky header. Listeners are registered once;
  // the bar is re-queried on paint because client-side navigation replaces it.
  let queued = false;

  // The divider only exists once something has passed under the header. This
  // runs outside the rAF throttle: reading scrollY costs nothing and forces no
  // layout, and the divider should not wait for a frame that a background tab
  // may never render.
  function markScrolled() {
    const header = document.querySelector<HTMLElement>('.nav');
    if (!header) return;
    if (window.scrollY > 8) header.dataset.scrolled = 'true';
    else delete header.dataset.scrolled;
  }

  function paint() {
    queued = false;

    const bar = document.querySelector<HTMLElement>('.nav__progress');
    if (!bar) return;

    // A page can name the element that counts as the read (the case study
    // marks its article body). Progress is then progress through that, so it
    // completes with the last paragraph rather than with the footer.
    const reading = document.querySelector<HTMLElement>('[data-reading]');
    const end = reading
      ? reading.getBoundingClientRect().bottom + window.scrollY
      : document.documentElement.scrollHeight;
    const max = end - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.setProperty('--scroll-progress', String(progress));
  }

  function onScroll() {
    markScrolled();
    if (queued) return;
    queued = true;
    requestAnimationFrame(paint);
  }

  // Reading progress is for case studies, not for the index at /work. Kept in
  // the script rather than in the template so the element exists on every page
  // and only its visibility changes.
  function syncProgress() {
    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    const bar = document.querySelector<HTMLElement>('.nav__progress');
    if (bar) bar.hidden = !/^\/work\/.+/.test(path);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('astro:page-load', () => {
    syncProgress();
    markScrolled();
    paint();
  });
  syncProgress();
  markScrolled();
  paint();
</script>
