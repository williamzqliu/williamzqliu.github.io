---
// SPEC §6 — bottom of a case study. One link, not a heading with a link
// inside it: the whole block is the target, for the mouse and for the keyboard.
//
// Which project this points at is decided in lib/projects.ts (`nextStep`), so
// the component only has to render what it is handed — including the case where
// there is no next project and the reader is sent to /work instead.

interface Props {
  /** Omitted for the end of the sequence, where the title is the whole message. */
  label?: string;
  title: string;
  href: string;
  /** Omitted where there is no single project to date. */
  year?: number;
}

const { label, title, href, year } = Astro.props;
---

<nav class="next" aria-label={label ?? 'More work'}>
  <a class="next__link" href={href}>
    {label && <span class="next__label">{label}</span>}

    <span class="next__row">
      <span class="next__title">{title}</span>

      {year !== undefined && <span class="next__year">{year}</span>}
    </span>
  </a>
</nav>

<style>
  /* The rule above this block is the case study's (`.cs__next`). */

  /* No surface of its own. The whole block stays clickable, but the hover is
     scoped to the label and the title's row: the padding above and below them
     does not light the block up from a distance. */
  .next__link {
    position: relative;
    display: block;
    /* Two pixels off the top: the block sits a little closer to the rule that
       introduces it than to the footer below. */
    padding-block: calc(var(--sp-32) - 2px) var(--sp-32);
  }

  /* Set like Explore all work under it and Selected work on the homepage:
     the section label's type, weight, ink and wider tracking. */
  .next__label {
    /* As wide as its words, so it lights only when pointed at. A block
       still, so the line box around it does not move the title. */
    display: block;
    width: fit-content;
    /* Nudged up out of the flow rather than by a margin: the title below it
       stays exactly where it is, and only the label moves. */
    position: relative;
    top: -4px;
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
    line-height: var(--lh-small);
    letter-spacing: var(--ls-label-wide);
    text-transform: uppercase;
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .next__row {
    display: flex;
    /* The row is exactly as tall as the title: the year is smaller and sits on
       its baseline, so this box is the hover region. */
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-24);
    /* 20px of air between the label's letters and the title's capitals, so
       the two read as one thing. */
    margin-top: 5px;
  }

  /* Colour is the only thing that changes here: no weight step, no underline,
     no movement, no fill. */
  .next__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    /* A step lighter than --text-3: #837D6F on the light page, 3.8 : 1. The
       year below takes the same ink, so the row is one tone. */
    color: color-mix(in srgb, var(--text-3) 85%, var(--bg));
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Follows the title rather than staying grey: the row reads as one thing. */
  .next__year {
    flex: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: color-mix(in srgb, var(--text-3) 85%, var(--bg));
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Keyboard focus reads the same as hover — focus lands on the link, which
     has no pointer position to scope it to. */
  .next__link:focus-visible .next__label,
  .next__link:focus-visible .next__title,
  .next__link:focus-visible .next__year {
    color: var(--accent);
  }

  /* The label lights with the title: pointing at either lights both, and
     the year with them. */
  @media (hover: hover) and (pointer: fine) {
    .next__link:has(.next__label:hover, .next__row:hover) :is(.next__label, .next__title, .next__year) {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .next__link:has(.next__label:active, .next__row:active) :is(.next__label, .next__title, .next__year) {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }
</style>
