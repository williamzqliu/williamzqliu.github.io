---
// The end credits of a case study: what the project asked of me, what it was
// built with, and who else is in it. Deliberately a component rather than one
// more markdown pattern — unlike `.participant-quote` or `.tier-key`, this
// carries structured data, repeats verbatim at the end of every project, and
// re-composes across the three breakpoints. See
// docs/case-study-editorial-system.md.
//
// Film credits, not a second resume: a large title anchoring the left, a
// column of labelled rows on the right, hairlines between them, and nothing
// else. No fills, no cards, no pills, no icons. Role is absent on purpose —
// the intro already carries it.
//
// Two depths. Skills, tools and team answer what the project was made of and
// who made it, which is the question a credits block exists to answer, so they
// are open. Thanks and the note are the acknowledgement layer: owed, and not
// what someone arriving at the end of a case study is reading for. They sit
// behind one disclosure so the block closes the page instead of filling a
// screen.

export interface Credits {
  skills?: string[];
  tools?: string[];
  team?: { group?: string; people: string[] }[];
  teamLabel?: string;
  specialThanks?: string[];
  note?: string;
  collapse?: boolean;
}

interface Props {
  credits?: Credits;
}

type Row = {
  label: string;
  items?: string[];
  groups?: { group?: string; people: string[] }[];
  note?: string;
};

const { credits } = Astro.props;

// `*Gephi*` marks a product or service, the same convention the prose uses for
// named things. Splitting on the asterisk puts every odd piece in italics, so
// a tools entry can name what it wraps without the schema growing a shape.
//
// Only when the asterisks pair up. A lone one is a footnote mark, not an
// opening delimiter — `Yixuan Liu*` in an author list would otherwise lose it
// to an empty `<em>`.
const marked = (text: string) => {
  const parts = text.split('*');
  return parts.length > 2 && parts.length % 2 === 1 ? parts : [text];
};

const kept = (list: (Row | null)[]) => list.filter(Boolean) as Row[];

const primary = kept([
  credits?.skills?.length ? { label: 'Skills', items: credits.skills } : null,
  credits?.tools?.length ? { label: 'Tools', items: credits.tools } : null,
  // `Team` unless the project says otherwise: a solo project with an adviser
  // on it is not a team, and the default label would claim a collaboration
  // that did not happen.
  credits?.team?.length ? { label: credits.teamLabel ?? 'Team', groups: credits.team } : null,
]);

const attribution = kept([
  credits?.specialThanks?.length ? { label: 'Special thanks', items: credits.specialThanks } : null,
  credits?.note ? { label: 'Note', note: credits.note } : null,
]);

// The disclosure earns its place when there is enough behind it to be worth
// closing. `collapse: false` says there is not, per project.
const collapse = credits?.collapse !== false;
const shown = collapse ? primary : [...primary, ...attribution];
const hidden = collapse ? attribution : [];
---

{
  shown.length + hidden.length > 0 && (
    <section class="credits" aria-labelledby="credits-title">
      {/* An h2 outside `.prose`, so it takes neither the section counter nor a
          place in the table of contents: the narrative ends with the last
          numbered section, and this is the epilogue. */}
      <h2 class="credits__title" id="credits-title">
        Credits
      </h2>

      <div class="credits__rows">
        {shown.length > 0 && (
          <dl class="credits__set">
            {shown.map((row) => (
              <div class="credits__row">
                <dt class="credits__label">{row.label}</dt>

                <dd class="credits__body">
                  {row.items && (
                    <ul class="credits__list">
                      {row.items.map((item) => (
                        <li>{marked(item).map((part, i) => (i % 2 ? <em>{part}</em> : part))}</li>
                      ))}
                    </ul>
                  )}

                  {row.groups?.map((group) => (
                    <div class="credits__group">
                      {group.group && <p class="credits__group-label">{group.group}</p>}

                      <ul class="credits__list">
                        {group.people.map((person) => (
                          <li>{person}</li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  {row.note && <p class="credits__note">{row.note}</p>}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {hidden.length > 0 && (
          /* Native disclosure: the state is the element's own, it opens from
             the keyboard with no script, and the sign is the same one every
             collapsed layer in the article uses. The words carry the meaning —
             the plus only confirms it. */
          <details class="credits__more">
            <summary class="credits__more-sum">
              <span class="credits__more-label">Full credits</span>
            </summary>

            <dl class="credits__set">
              {hidden.map((row) => (
                <div class="credits__row">
                  <dt class="credits__label">{row.label}</dt>

                  <dd class="credits__body">
                    {row.items && (
                      <ul class="credits__list">
                        {row.items.map((item) => (
                          <li>{marked(item).map((part, i) => (i % 2 ? <em>{part}</em> : part))}</li>
                        ))}
                      </ul>
                    )}

                    {row.groups?.map((group) => (
                      <div class="credits__group">
                        {/* A group with no name is just the people: a project
                            whose team divides into contributions labels them,
                            one that does not simply lists who was on it. */}
                        {group.group && <p class="credits__group-label">{group.group}</p>}

                        <ul class="credits__list">
                          {group.people.map((person) => (
                            <li>{person}</li>
                          ))}
                        </ul>
                      </div>
                    ))}

                    {row.note && <p class="credits__note">{row.note}</p>}
                  </dd>
                </div>
              ))}
            </dl>
          </details>
        )}
      </div>
    </section>
  )
}

<style>
  /* The line that separates the article from its credits, drawn in the colour
     every section heading's rule is drawn in — off full strength, so the one
     heavy rule on the page reads as a boundary rather than as the darkest
     thing on it. The title stands well clear: under a 2px line a tighter gap
     read as a caption on the rule rather than as the start of a block. */
  .credits {
    margin-top: var(--sp-96);
    padding-top: var(--sp-40);
    border-top: var(--rule-heavy) solid color-mix(in srgb, var(--rule-strong) 60%, var(--bg));
  }

  /* Set exactly as a section heading is: this closes the same page the
     numbered sections run down, and a larger face would read as a second
     title competing with the project's own. What marks it as the end is the
     rule above it and the column it stands in, not its size. */
  .credits__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-lead);
    line-height: 1.15;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* The same step the article's headings take on a phone. */
  @media (max-width: 639px) {
    .credits__title {
      font-size: 1.75rem;
    }
  }

  .credits__rows {
    margin-top: var(--sp-32);
  }

  /* Phone: label over content, one hairline opening each row. The rules
     separate the rows; they do not box the block. Nothing closes the bottom,
     so the credits end into the space before the next project. */
  .credits__row {
    padding-block: var(--sp-20);
    border-top: var(--rule-hair) solid var(--rule);
  }

  /* The register every other piece of project metadata uses — Role, Timeline,
     the section bar. */
  .credits__label {
    font-family: var(--font-mono);
    /* The same 12px the quick facts and the card chips take: mono runs small,
       and at 11 caps plus letter-spacing read as noise. */
    font-size: 0.75rem;
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .credits__body {
    margin: 0;
    margin-top: var(--sp-12);
  }

  /* No marker. The article's lists carry a hairline dash because their items
     are sentences that need a start; these are names, and a run of them reads
     as a roll on its own. Tight leading is what makes it one. */
  .credits__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Most of the way to the body ink, not all of it. These are set smaller and heavier than
     the article's copy, and at full strength that combination sat darker on
     the page than the paragraphs above it — an epilogue reading louder than
     what it follows. Mixed toward the secondary ink rather than switched to
     it, which would drop them two levels in one go. */
  .credits__list li {
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    font-weight: var(--fw-medium);
    color: color-mix(in srgb, var(--text) 60%, var(--text-2));
  }

  .credits__list li + li {
    margin-top: var(--sp-4);
  }

  /* A product name inside an entry, italic for the same reason the prose sets
     one that way. */
  .credits__list em {
    font-weight: var(--fw-regular);
  }

  /* Quieter than the people under it: this is which kind of contribution, not
     who made it. Set as the drawn keys in the article set their titles — the
     caption size in the quietest ink, one weight step up, because at regular
     it reads as an afterthought rather than as the name of a group. */
  .credits__group-label {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  .credits__group + .credits__group {
    margin-top: var(--sp-16);
  }

  /* The most subordinate line in the block: body copy, no rule, no box. */
  .credits__note {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* ---- the second depth ---- */

  /* The disclosure is a row like the others, so the rule above it belongs to
     the rhythm rather than to a control. The element itself carries nothing:
     no border, no fill, no margin. */
  .credits__more {
    border: 0;
    /* Height-animated by the page's shared disclosure script, so scroll
       anchoring is off here for the same reason it is off on the article's
       disclosures. */
    overflow-anchor: none;
  }

  /* Set as the article's collapsed layers are set: mono caps at the label
     size, the whole row a target, the sign on the right. Those values are
     reproduced here rather than shared, because the prose rules are scoped to
     `.prose` and widening them would restyle three accordions to fix one
     control. Only the bar borrows that language — what it opens is still
     credits, on the credits grid. */
  .credits__more-sum {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
    padding-block: var(--sp-16);
    border-top: var(--rule-hair) solid var(--rule);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Both the standards-track property and the WebKit pseudo-element: between
     them the native triangle is gone everywhere. */
  .credits__more-sum::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 639px) {
    .credits__more-sum {
      font-size: 0.75rem;
    }
  }

  /* Both signs stacked in one place, crossfading — the same device the
     article's collapsed layers use, and for the same reason: `content` cannot
     be transitioned, so the plus and the minus trade opacity instead. The
     words stay in both states; the sign only confirms which one it is. */
  .credits__more-sum::before,
  .credits__more-sum::after {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    line-height: 1;
    color: var(--text-3);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .credits__more-sum::before {
    content: '−';
    opacity: 0;
  }

  .credits__more-sum::after {
    content: '+';
    opacity: 1;
  }

  /* `data-closing` is set by the page's shared disclosure script while the
     height collapses, so the sign turns back as the panel starts to shut. */
  .credits__more[open]:not([data-closing]) > .credits__more-sum::before {
    opacity: 1;
  }

  .credits__more[open]:not([data-closing]) > .credits__more-sum::after {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .credits__more-sum:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }

    .credits__more-sum:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* From 640 the label steps beside its content, and the rows start reading
     across rather than down. */
  @media (min-width: 640px) {
    .credits__row {
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
      column-gap: var(--sp-32);
      padding-block: var(--sp-24);
    }

    .credits__body {
      margin-top: 0;
    }

    .credits__label {
      padding-top: 0.2em;
    }
  }

  /* Desktop: the title holds the left column the table of contents holds
     above it, so the two align down the page and the rows sit in one block to
     the right of both. */
  @media (min-width: 1024px) {
    .credits {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      column-gap: var(--sp-64);
      align-items: start;
    }

    .credits__rows {
      margin-top: 0;
    }

    .credits__row {
      grid-template-columns: 180px minmax(0, 1fr);
    }

    /* The rule above the block is already the line over the first row; a
       hairline under it would be a second one. */
    .credits__set:first-child .credits__row:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
