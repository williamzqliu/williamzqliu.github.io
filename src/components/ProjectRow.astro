---
// A project row: text column on the left, cover on the right, one hairline
// above each row. Text sits in a fixed-width column so every row in the list
// wraps at the same place — ragged edges that line up read as composed rather
// than accidental.
//
// The hover surface fill is gone on purpose. It could either hug the content
// (text touching its edge) or bleed past the rules (escaping the grid), and
// neither looked right; hover now lives on the title and the cover instead.
//
// Cover media is a tone-locked placeholder plate until the loops are recorded
// (SPEC "Open items"). The plate colour does not follow the theme, and while
// `COVERS_ENABLED` is off the column is not rendered at all.

import CoverMedia from './CoverMedia.astro';
import { COVERS_ENABLED } from '../lib/media';
import ExtArrow from './ExtArrow.astro';

interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  /** Omit to render the row without a figure number. */
  index?: number;
  title: string;
  year: number;
  blurb: string;
  stack: string[];
  /** Omit until the case study page exists. */
  href?: string;
  tone: 'dark' | 'light' | 'neutral';
  links: ProjectLink[];
  /** SPEC §9 — the engineering track gives stack lines more prominence. */
  emphasiseStack?: boolean;
}

const { index, title, year, blurb, stack, href, tone, links, emphasiseStack } = Astro.props;
const figure = index === undefined ? undefined : String(index).padStart(2, '0');

// Three keywords is the point at which a stack list stops being a signal and
// starts being an inventory. The full list lives in QuickFacts on the case
// study page.
const keywords = stack.slice(0, 3);

// `#` is a placeholder, not a destination — do not ship it as a link.
const liveLinks = links.filter((link) => link.href !== '#');
---

<article
  class="prow"
  data-linked={href ? 'true' : undefined}
  data-nomedia={COVERS_ENABLED ? undefined : 'true'}
>
  <div class="prow__body">
    {/* The year sits above the title on a wide screen and beside it on a
        narrow one. Same markup either way — only this wrapper's display
        changes, so the reading order stays title-then-year. */}
    <div class="prow__head">
      <p class="prow__meta">
        {figure && <span class="prow__index">{figure}</span>}
        <span class="prow__year">{year}</span>
      </p>

      <h3 class="prow__title">
        {
          href ? (
            <a class="prow__link" href={href}>
              <span class="prow__titletext">{title}</span>
            </a>
          ) : (
            <span class="prow__titletext">{title}</span>
          )
        }
      </h3>
    </div>

    <p class="prow__blurb">{blurb}</p>

    <ul class="prow__kws" data-emphasis={emphasiseStack ? 'true' : undefined}>
      {keywords.map((keyword) => <li class="prow__kw">{keyword}</li>)}
    </ul>

    {liveLinks.length > 0 && (
    <ul class="prow__links">
      {
        liveLinks.map((link) => {
          const external = link.href.startsWith('http');
          return (
            <li>
              <a
                class="prow__linkout"
                href={link.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {external && (
                  <>
                    <ExtArrow />
                    <span class="vh">(opens in a new tab)</span>
                  </>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
    )}
  </div>

  {/* Clips the cover so its hover scale stays inside the frame. */}
  {COVERS_ENABLED && (
    <div class="prow__mediacol">
      <CoverMedia tone={tone} />
    </div>
  )}
</article>

<style>
  .prow {
    position: relative;
    display: grid;
    gap: var(--sp-24);
    padding-block: var(--sp-32);
    border-top: var(--rule-hair) solid var(--rule);
  }

  /* Only a row that leads somewhere behaves like one. */
  .prow[data-linked] {
    cursor: pointer;
  }

  /* ---- text column ---- */

  .prow__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Wide: the year is a line of metadata above the title, as before. */
  .prow__head {
    align-self: stretch;
  }

  .prow__meta {
    display: flex;
    align-items: baseline;
    gap: var(--sp-12);
  }

  /* Narrow: title left, year hard right, on one row.
     
     `align-items: baseline` is what does the work — a flex item's baseline is
     its *first* line's baseline, so the year lands level with the lower edge
     of the title's first line and stays there when the title wraps to two.
     No per-card offsets, and nothing to keep in sync with the title's size. */
  @media (max-width: 639px) {
    .prow__head {
      display: flex;
      align-items: baseline;
      /* Wide enough that a long title and the year cannot meet. */
      gap: var(--sp-24);
    }

    .prow__head .prow__title {
      order: 1;
      /* Takes the rest of the row and wraps inside it. */
      flex: 1 1 auto;
      min-width: 0;
      /* The gap above the title belongs to the row, not to the title. */
      margin-top: 0;
    }

    .prow__head .prow__meta {
      order: 2;
      /* Never shrinks, never wraps, never drops below the title. */
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }

  .prow__index {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
  }

  .prow__year {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* Display face: project titles are one of the few places the character of
     the type is allowed to show. */
  .prow__title {
    margin-top: var(--sp-12);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-cardtitle);
    line-height: 1.2;
    font-weight: var(--fw-strong);
    letter-spacing: -0.015em;
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Stretches the link over the whole row (SPEC §4). */
  .prow__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Hover highlight, not an underline. The padding is reserved here, in the
     default state, and cancelled by an equal negative margin — so the box that
     appears on hover occupies no space and nothing on the row moves when it
     arrives. Fixed pixels rather than em, so the inset stays 3/5 at every step
     of the title's fluid size. `box-decoration-break: clone` gives a wrapped
     title the same padding on both lines.
     
     `position: relative` is what makes the title hoverable at all: the link's
     stretched ::after covers the whole row, including these words, so without
     a layer of its own the overlay takes every hit and the title can never
     tell that the pointer is on it specifically. */
  .prow__titletext {
    position: relative;
    z-index: 1;
    padding: 3px 5px;
    margin: -3px -5px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background: transparent;
    transition:
      background-color var(--dur-hover-out) var(--ease-out),
      color var(--dur-hover-out) var(--ease-out);
  }

  .prow__blurb {
    margin-top: var(--sp-16);
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  /* One step down on a phone, so the card's own copy matches the long-form
     copy on the case study rather than out-sizing it. */
  @media (max-width: 639px) {
    .prow__blurb {
      font-size: 1rem;
    }
  }

  /* Three keywords, as tags rather than a sentence: mono, caps, on a quiet
     surface. Square corners, no border, no shadow — a tag, not a pill. */
  .prow__kws {
    display: flex;
    flex-wrap: wrap;
    /* One pixel under --sp-8: three chips read as a set rather than as three
       separate blocks. Local, so nothing else on the site moves. */
    gap: 7px;
    margin-top: var(--sp-20);
  }

  .prow__kw {
    padding: 5px var(--sp-8);
    background: var(--surface);
    font-family: var(--font-mono);
    /* One step above --fs-micro (11px): mono runs small, and at 11px the caps
       plus letter-spacing were harder to read than the year beside them. Local
       rather than a token change, so nothing else in the site moves. */
    font-size: 0.75rem;

    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  /* The engineering track leans on its stack, so those tags carry the ink. */
  .prow__kws[data-emphasis] .prow__kw {
    color: var(--text);
  }

  /* Slightly larger step than the one above it, and the tap padding on the
     links themselves adds the rest. */
  .prow__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-24);
    margin-top: var(--sp-12);
  }

  /* Above the row-wide link overlay, so these reach their own destinations. */
  .prow__links li {
    position: relative;
    z-index: 1;
  }

  /* Text and arrow change colour together; nothing underlines, nothing moves.
     The vertical padding is the tap target, not a visual gap. */
  .prow__linkout {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-2);
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }


  /* ---- cover ---- */

  /* The container is what holds the row's geometry: fixed ratio, clipped, and
     never transformed itself — only the plate inside it moves. */
  .prow__mediacol {
    overflow: hidden;
  }

  /* Muted, not treated: saturation comes down a little and nothing else
     changes. The point is that the project's own colours arrive on hover, not
     that the site puts its orange over them — so no overlay, no duotone, no
     grey, no blur, no opacity. At 0.82 a chart or a diagram is still fully
     readable at rest.
     
     360ms, on exactly the two properties that change. */
  .prow[data-linked] .prow__mediacol :global(.cover) {
    filter: saturate(0.82);
    transition:
      filter 360ms var(--ease-out),
      transform 360ms var(--ease-out);
  }

  /* Touch has no hover to restore the colour, so there is nothing to mute. */
  @media (hover: none) {
    .prow[data-linked] .prow__mediacol :global(.cover) {
      filter: none;
    }
  }

  /* ---- states (SPEC §4) ---- */

  /* Three levels, because the row has more than one thing in it.
     
       default            dark title, no fill
       anywhere on the row   title text takes the accent
       on the title itself   accent fill, cream text
     
     The second says "this row leads somewhere"; the third says "and this is
     the link". Only `background-color` and `color` move between them, both
     already transitioned above, so every step fades in either direction and
     nothing is added or resized on hover. */
  @media (hover: hover) and (pointer: fine) {
    .prow[data-linked]:hover .prow__titletext {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }

    .prow[data-linked] .prow__titletext:hover {
      background: var(--accent);
      /* Locked light, so the text stays legible on orange in both themes. */
      color: var(--tone-light);
      /* Slower than the site's other hovers on purpose: this is a block of
         colour rather than a colour change on text, and at the standard 200ms
         it arrives as a flash. */
      transition-duration: calc(var(--dur-hover-in) + 100ms);
    }

    /* Anywhere on the row, not just on the media: the row is one thing, and
       the image coming to full colour is the row answering. The zoom is meant
       to be almost imperceptible — it is the colour that carries the change. */
    .prow[data-linked]:hover .prow__mediacol :global(.cover) {
      filter: saturate(1);
      transform: scale(1.015);
    }

    .prow__linkout:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }

    .prow[data-linked] .prow__titletext:active {
      background: var(--accent);
      color: var(--tone-light);
      transition-duration: var(--dur-press);
    }
  }

  /* The colour change is the point and it stays; the 1.5% of movement does
     not. */
  @media (prefers-reduced-motion: reduce) {
    .prow[data-linked]:hover .prow__mediacol :global(.cover) {
      transform: none;
    }
  }

  /* Touch gets one quiet acknowledgement and no fill. `:active` cannot be used
     for it: the browser keeps that state through a drag, so a press that turns
     into a scroll leaves the card lit up and, on some devices, still fires the
     link. `data-pressed` is set on pointerdown and dropped the moment the
     finger moves far enough to be scrolling — see the script below.
     
     No orange background here either: a block of colour on a press that may
     turn out to be a scroll is too loud a promise. */
  @media (hover: none) {
    .prow[data-linked][data-pressed] .prow__titletext {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }

    /* Both conditions: the row is still a tap, and this link is the target. */
    .prow[data-linked][data-pressed] .prow__linkout:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* ---- layout tiers (SPEC §5) ---- */

  @media (max-width: 1023px) {
    /* Cover leads on narrow screens: it is the fastest read. */
    .prow__mediacol {
      order: -1;
    }
  }

  @media (min-width: 640px) {
    .prow {
      padding-block: var(--sp-48);
      gap: var(--sp-32);
    }
  }

  @media (min-width: 1024px) {
    /* Fixed text column, so every row wraps at the same width and the cover
       takes whatever is left. */
    .prow:not([data-nomedia]) {
      grid-template-columns: 380px minmax(0, 1fr);
      column-gap: var(--sp-64);
      align-items: start;
    }
  }

  /* Without a cover the row is one column, so the text needs its own measure
     — otherwise the title and blurb run the full 1200px. */
  .prow[data-nomedia] .prow__body {
    max-width: var(--measure);
  }
</style>

<script>
  // Touch only: a press that becomes a vertical scroll must not read as a tap.
  //
  // Native links already cancel most of these, but not all of them — the
  // pressed state survives the drag, and a synthetic click still arrives on
  // some devices. This watches the gesture instead of trusting `:active`.
  //
  // Delegated to the document, so one listener covers every row on the page
  // and it survives a client-side navigation. Nothing calls preventDefault on
  // the pointer events, so scrolling stays entirely native.
  const TAP_SLOP = 10; // px of travel before a press is treated as a scroll

  let gesture: { id: number; x: number; y: number; row: HTMLElement } | null = null;
  let cancelled = false;

  const rowFrom = (target: EventTarget | null) =>
    (target as HTMLElement | null)?.closest<HTMLElement>('.prow[data-linked]') ?? null;

  const release = () => {
    if (gesture) delete gesture.row.dataset.pressed;
    gesture = null;
  };

  document.addEventListener(
    'pointerdown',
    (event) => {
      // Mouse and pen keep their hover behaviour untouched.
      if (event.pointerType === 'mouse' || !window.matchMedia('(hover: none)').matches) return;
      const row = rowFrom(event.target);
      if (!row) return;
      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, row };
      cancelled = false;
      row.dataset.pressed = 'true';
    },
    { passive: true }
  );

  document.addEventListener(
    'pointermove',
    (event) => {
      if (!gesture || event.pointerId !== gesture.id) return;
      const moved =
        Math.abs(event.clientY - gesture.y) > TAP_SLOP ||
        Math.abs(event.clientX - gesture.x) > TAP_SLOP;
      if (!moved) return;
      // This is a scroll. Drop the state now, and the click that may follow.
      cancelled = true;
      release();
    },
    { passive: true }
  );

  // `pointercancel` is the browser saying it has taken the gesture over for
  // scrolling, which is the other way this ends.
  document.addEventListener('pointerup', release, { passive: true });
  document.addEventListener(
    'pointercancel',
    () => {
      cancelled = true;
      release();
    },
    { passive: true }
  );

  // Capture, so this runs before the anchor's own default action. Only ever
  // suppresses a click that a cancelled gesture produced, so a real tap and
  // every keyboard activation pass straight through.
  document.addEventListener(
    'click',
    (event) => {
      if (!cancelled) return;
      cancelled = false;
      if (!rowFrom(event.target)) return;
      event.preventDefault();
      event.stopPropagation();
    },
    true
  );
</script>
