---
// A project row: text column on the left, cover on the right, one hairline
// above each row. Text sits in a fixed-width column so every row in the list
// wraps at the same place — ragged edges that line up read as composed rather
// than accidental.
//
// The hover surface fill is gone on purpose. It could either hug the content
// (text touching its edge) or bleed past the rules (escaping the grid), and
// neither looked right; hover now lives on the title and the cover instead.
//
// Cover media is a tone-locked placeholder plate until the loops are recorded
// (SPEC "Open items"). The plate colour does not follow the theme, and while
// `COVERS_ENABLED` is off the column is not rendered at all.

import CoverMedia from './CoverMedia.astro';
import { COVERS_ENABLED } from '../lib/media';
import ExtArrow from './ExtArrow.astro';
import KeywordTags from './KeywordTags.astro';

interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  /** Omit to render the row without a figure number. */
  index?: number;
  title: string;
  year: number;
  blurb: string;
  stack: string[];
  /** Omit until the case study page exists. */
  href?: string;
  tone: 'dark' | 'light' | 'neutral';
  /** The project's 16:9 cover. Omit while the artwork is still the tone plate. */
  coverSrc?: string;
  coverAlt?: string;
  links: ProjectLink[];
  /** SPEC §9 — the engineering track gives stack lines more prominence. */
  emphasiseStack?: boolean;
}

const { index, title, year, blurb, stack, href, tone, coverSrc, coverAlt, links, emphasiseStack } =
  Astro.props;
const figure = index === undefined ? undefined : String(index).padStart(2, '0');

// `#` is a placeholder, not a destination — do not ship it as a link.
const liveLinks = links.filter((link) => link.href !== '#');
---

{/* Two boxes on purpose. The outer one owns the rhythm — the space between
    projects and the rule that separates them — and answers to nothing. The
    inner one is the card: it is the grid, the hover target and the click
    target, and it is exactly as tall as the row's content. Whitespace above
    and below stays whitespace. */}
<article class="prow">
  <div
    class="prow__card"
    data-linked={href ? 'true' : undefined}
    data-nomedia={COVERS_ENABLED ? undefined : 'true'}
  >
    <div class="prow__body">
      {/* The year sits above the title on a wide screen and beside it on a
          narrow one. Same markup either way — only this wrapper's display
          changes, so the reading order stays title-then-year. */}
      <div class="prow__head">
        <p class="prow__meta">
          {figure && <span class="prow__index">{figure}</span>}
          <span class="prow__year">{year}</span>
        </p>

        <h3 class="prow__title">
          {
            href ? (
              <a class="prow__link" href={href}>
                <span class="prow__titletext">{title}</span>
              </a>
            ) : (
              <span class="prow__titletext">{title}</span>
            )
          }
        </h3>
      </div>

      <p class="prow__blurb">{blurb}</p>

      <div class="prow__kws">
        <KeywordTags items={stack} limit={3} emphasise={emphasiseStack} />
      </div>

      {liveLinks.length > 0 && (
      <ul class="prow__links">
        {
          liveLinks.map((link) => {
            const external = link.href.startsWith('http');
            return (
              <li>
                <a
                  class="prow__linkout"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  {external && (
                    <>
                      <ExtArrow />
                      <span class="vh">(opens in a new tab)</span>
                    </>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
      )}
    </div>

    {/* Clips the cover so its hover scale stays inside the frame. */}
    {COVERS_ENABLED && (
      <div class="prow__mediacol">
        <CoverMedia tone={tone} src={coverSrc} alt={coverAlt} />
      </div>
    )}
  </div>
</article>

<style>
  /* Spacing and the divider, nothing else. No hover, no cursor, no click
     target: the padding here is the gap between two projects, and a gap is
     not part of either of them. */
  .prow {
    padding-block: var(--sp-32);
    border-top: var(--rule-hair) solid var(--rule);
  }

  /* The card. `position: relative` also scopes the stretched link below, so
     the click target ends where the content does. */
  .prow__card {
    position: relative;
    display: grid;
    gap: var(--sp-24);
  }

  /* Only a card that leads somewhere behaves like one. */
  .prow__card[data-linked] {
    cursor: pointer;
  }

  /* ---- text column ---- */

  .prow__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Wide: the year is a line of metadata above the title, as before. */
  .prow__head {
    align-self: stretch;
  }

  .prow__meta {
    display: flex;
    align-items: baseline;
    gap: var(--sp-12);
  }

  /* Narrow: title left, year hard right, on one row.
     
     `align-items: baseline` is what does the work — a flex item's baseline is
     its *first* line's baseline, so the year lands level with the lower edge
     of the title's first line and stays there when the title wraps to two.
     No per-card offsets, and nothing to keep in sync with the title's size. */
  @media (max-width: 639px) {
    .prow__head {
      display: flex;
      align-items: baseline;
      /* Wide enough that a long title and the year cannot meet. */
      gap: var(--sp-24);
    }

    .prow__head .prow__title {
      order: 1;
      /* Takes the rest of the row and wraps inside it. */
      flex: 1 1 auto;
      min-width: 0;
      /* The gap above the title belongs to the row, not to the title. */
      margin-top: 0;
    }

    .prow__head .prow__meta {
      order: 2;
      /* Never shrinks, never wraps, never drops below the title. */
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }

  .prow__index {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    text-transform: uppercase;
  }

  .prow__year {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* Display face: project titles are one of the few places the character of
     the type is allowed to show. */
  .prow__title {
    margin-top: var(--sp-12);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-cardtitle);
    line-height: 1.2;
    font-weight: var(--fw-strong);
    letter-spacing: -0.015em;
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Stretches the link over the whole row (SPEC §4).

     `z-index` is not decoration here, it is the click target. The cover
     carries a `filter`, and a filter makes its element a stacking context —
     painted with the positioned boxes rather than under them, and painted in
     tree order, where the media column comes after the text. Without a layer
     of its own this overlay ends up beneath the picture and the cover swallows
     every click on it. At 1 it clears the picture and still sits under the
     outbound links, which carry the same 1 and come later in the row. */
  .prow__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The title takes the accent while the card is hovered and nothing else —
     no fill, so no padding to reserve, no layer of its own to be hoverable in,
     no clone rule for a wrapped highlight. One transitioned property.

     On the site's hover pair, 200ms in and 280ms out, like every other hover
     on the page. This used to run 360ms symmetrically, chosen for arriving at
     a card from nowhere. Moving between two cards is the commoner gesture in
     a list, and there 360 both ways left a long stretch where neither row was
     clearly the live one: the outgoing card was still lit while the incoming
     one had barely started. Out slower than in on purpose — the old row lets
     go just after the new one lands, so attention transfers instead of
     falling through a gap.

     Both ends then took 200ms more than the pair's own values, so the row
     answers slowly rather than snapping. Written as `calc` off the tokens so
     the 80ms the exit trails the entrance by is still the pair's, and stays
     the pair's if those values ever move. */
  .prow__titletext {
    transition: color calc(var(--dur-hover-out) + 200ms) var(--ease-out);
  }

  .prow__blurb {
    margin-top: var(--sp-16);
    max-width: var(--measure-meta);
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  /* The chips themselves are KeywordTags; this only places the row. */
  .prow__kws {
    margin-top: var(--sp-20);
  }

  .prow__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-24);
    margin-top: var(--sp-12);
  }

  /* Above the row-wide link overlay, so these reach their own destinations. */
  .prow__links li {
    position: relative;
    z-index: 1;
  }

  /* Text and arrow change colour together; nothing underlines, nothing moves.
     The vertical padding is the tap target, not a visual gap. */
  .prow__linkout {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-2);
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }


  /* ---- cover ---- */

  /* The container is what holds the row's geometry: fixed ratio, clipped, and
     never transformed itself — only the plate inside it moves. */
  /* The frame carries a fill of its own. At rest the plate does not cover it,
     and an uncovered frame in the page's own colour is not a frame — it is a
     hole where the picture should be. One step off --bg, the same step the
     chips take, so the empty part reads as the space the image is about to
     grow into. */
  .prow__mediacol {
    overflow: hidden;
    background: var(--surface);
  }

  /* Grey at rest, the project's own colour on hover. Saturation at 0.82 was
     an 18% change over a picture the eye was not looking at — technically
     present, practically invisible. Colour arriving across the whole surface
     at once is a global change, and global changes are the ones peripheral
     vision picks up; that is why this reads and a crop shift did not.

     It also happens to suit what these covers are. A network coloured by
     college is grey structure at rest and becomes an argument the moment the
     colour lands — the hover reveals the encoding rather than just brightening
     a thumbnail.

     Both properties on the same hover pair as the title, so the row answers
     as one thing. The stagger comes from the easing rather than from two
     different numbers: `--ease-out` decelerates, so the zoom reads as
     settling while the colour, a plain value change, arrives flat. Never
     `all`. */
  .prow__card[data-linked] .prow__mediacol :global(.cover) {
    /* Not all the way. At full grayscale a cover reads as switched off; a
       fifth of its colour left in keeps it a picture that has not been
       arrived at yet, and the hover still has somewhere to travel. */
    filter: grayscale(0.8);
    transition:
      transform calc(var(--dur-hover-out) + 200ms) var(--ease-out),
      filter calc(var(--dur-hover-out) + 200ms) var(--ease-out);
  }

  /* Touch has no hover to restore the colour, so there is nothing to mute. */
  @media (hover: none) {
    .prow__card[data-linked] .prow__mediacol :global(.cover) {
      filter: none;
    }
  }

  /* ---- states (SPEC §4) ---- */

  /* Two ways in, and only ever one of them at a time.

     `[data-hovered]` is the state arriving from the script below: Chrome does
     not re-evaluate `:hover` while the page scrolls under a still mouse, so a
     wheel past a row lit it a beat late. The script hit-tests each frame
     instead.

     While it is holding a row it marks the document, and that mark switches
     `:hover` off. Both at once is exactly the bug: during a scroll the stale
     `:hover` sits on the row the pointer entered while the attribute has
     already moved to the row now under it, and an `:is(:hover, [data-hovered])`
     union lights both. Before the first pointer move the script knows nothing,
     so the mark is absent and `:hover` still answers on its own.

     One response, not two. Anywhere inside the card and the row answers as a
     whole: the title takes the accent and the image steps closer, arriving at
     its own colour as it does. The pointer being on the title itself used to
     mean something more; it was a second layer on a row that only ever led to
     one place. Only colour, filter and transform move — nothing is added,
     resized or re-weighted. */
  @media (hover: hover) and (pointer: fine) {
    .prow__card[data-linked][data-hovered] .prow__titletext,
    :root:not([data-rowhover]) .prow__card[data-linked]:hover .prow__titletext {
      color: var(--accent);
      transition-duration: calc(var(--dur-hover-in) + 200ms);
    }

    /* Anywhere on the row, not just on the media: the row is one thing, and
       the colour arriving is the row answering. The zoom is the second voice,
       and at 10% it is a push rather than a nudge: the frame is fixed and
       clipped, so all that travels is the crop — the picture comes towards you
       and the row does not move a pixel.

       The asset never changes. A looping cover keeps looping — hover scales
       the same frame it was already showing and does not restart, swap or
       reveal anything. */
    .prow__card[data-linked][data-hovered] .prow__mediacol :global(.cover),
    :root:not([data-rowhover]) .prow__card[data-linked]:hover .prow__mediacol :global(.cover) {
      filter: grayscale(0);
      transform: scale(1.1);
      transition-duration: calc(var(--dur-hover-in) + 200ms);
    }

    /* An outbound link is a second destination on the same row, so it answers
       for itself — and only for itself. */
    .prow__linkout:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  /* The colour change is the point and it stays; the 1.5% of movement does
     not. */
  @media (prefers-reduced-motion: reduce) {
    .prow__card[data-linked][data-hovered] .prow__mediacol :global(.cover),
    :root:not([data-rowhover]) .prow__card[data-linked]:hover .prow__mediacol :global(.cover) {
      transform: none;
    }
  }

  /* Touch gets none of that. It gets the scrim the platform draws under a
     finger — the same one the case study's Sections bar shows, from the same
     token, so the two feel like one interface.
     
     The browser owns the state: it appears with the touch and the browser
     itself takes it away the moment the gesture becomes a scroll. That is why
     the card paints no pressed fill of its own — `:active` lingers through a
     drag, and anything hand-rolled here is a second implementation of what the
     platform already does. The stretched ::after belongs to this link, so the
     scrim covers the card rather than just the title. */
  .prow__link {
    -webkit-tap-highlight-color: var(--tap-press);
  }

  @media (hover: none) {
    .prow__linkout:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* ---- layout tiers (SPEC §5) ---- */

  @media (max-width: 1023px) {
    /* Cover leads on narrow screens: it is the fastest read. */
    .prow__mediacol {
      order: -1;
    }
  }

  @media (min-width: 640px) {
    .prow {
      padding-block: var(--sp-48);
      gap: var(--sp-32);
    }
  }

  @media (min-width: 1024px) {
    /* Fixed text column, so every row wraps at the same width and the cover
       takes whatever is left. */
    .prow__card:not([data-nomedia]) {
      /* 42/58 rather than a fixed 380px text column: the media was taking
         about 66% of the grid and out-weighing the project's own words. This
         takes ~12% off its width without touching the 16:9 ratio, and being
         proportional it holds at every width. */
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      column-gap: var(--sp-64);
      align-items: start;
    }
  }

  /* Without a cover the row is one column, so the text needs its own measure
     — otherwise the title and blurb run the full 1200px. */
  .prow__card[data-nomedia] .prow__body {
    max-width: var(--measure);
  }
</style>

<script>
  // Touch only: a press that becomes a vertical scroll must not read as a tap.
  //
  // The visual side belongs to the platform (see --tap-press above). What is
  // left is the click a cancelled gesture still emits on some devices; this
  // watches the gesture and swallows that one.
  //
  // Delegated to the document, so one listener covers every row on the page
  // and it survives a client-side navigation. Nothing calls preventDefault on
  // the pointer events, so scrolling stays entirely native.
  // Fine pointers only: `:hover` is not recomputed while the page scrolls
  // under a still mouse, so a row the cursor passes over only lights up once
  // the scroll stops. This hit-tests the cursor's last position on every
  // frame that the pointer moved or the page scrolled, and mirrors the result
  // onto `data-hovered`, which the CSS above reads alongside `:hover`.
  //
  // One `elementFromPoint` per frame, and only while something is actually
  // moving. Nothing here runs on touch, where there is no cursor to track.
  function trackHoverThroughScroll() {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (!fine.matches) return;

    let x = -1;
    let y = -1;
    let queued = false;
    let current: HTMLElement | null = null;

    const settle = (row: HTMLElement | null) => {
      if (row === current) return;
      current?.removeAttribute('data-hovered');
      row?.setAttribute('data-hovered', 'true');
      current = row;
      // The mark is what suppresses `:hover`, so it goes up only while there
      // is a row to suppress it for.
      document.documentElement.toggleAttribute('data-rowhover', row !== null);
    };

    const sync = () => {
      queued = false;
      if (x < 0) return;
      const el = document.elementFromPoint(x, y) as HTMLElement | null;
      settle(el?.closest<HTMLElement>('.prow__card[data-linked]') ?? null);
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(sync);
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        x = event.clientX;
        y = event.clientY;
        schedule();
      },
      { passive: true }
    );

    // The cursor left the window, so nothing is under it any more.
    document.addEventListener('pointerleave', () => {
      x = -1;
      settle(null);
    });

    window.addEventListener('scroll', schedule, { passive: true });
  }

  trackHoverThroughScroll();

  const TAP_SLOP = 10; // px of travel before a press is treated as a scroll

  let gesture: { id: number; x: number; y: number } | null = null;
  let cancelled = false;

  const rowFrom = (target: EventTarget | null) =>
    (target as HTMLElement | null)?.closest<HTMLElement>('.prow__card[data-linked]') ?? null;

  const release = () => {
    gesture = null;
  };

  document.addEventListener(
    'pointerdown',
    (event) => {
      // Mouse and pen keep their hover behaviour untouched.
      if (event.pointerType === 'mouse' || !window.matchMedia('(hover: none)').matches) return;
      if (!rowFrom(event.target)) return;
      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
      cancelled = false;
    },
    { passive: true }
  );

  document.addEventListener(
    'pointermove',
    (event) => {
      if (!gesture || event.pointerId !== gesture.id) return;
      const moved =
        Math.abs(event.clientY - gesture.y) > TAP_SLOP ||
        Math.abs(event.clientX - gesture.x) > TAP_SLOP;
      if (!moved) return;
      // This is a scroll. Drop the state now, and the click that may follow.
      cancelled = true;
      release();
    },
    { passive: true }
  );

  // `pointercancel` is the browser saying it has taken the gesture over for
  // scrolling, which is the other way this ends.
  document.addEventListener('pointerup', release, { passive: true });
  document.addEventListener(
    'pointercancel',
    () => {
      cancelled = true;
      release();
    },
    { passive: true }
  );

  // Capture, so this runs before the anchor's own default action. Only ever
  // suppresses a click that a cancelled gesture produced, so a real tap and
  // every keyboard activation pass straight through.
  document.addEventListener(
    'click',
    (event) => {
      if (!cancelled) return;
      cancelled = false;
      if (!rowFrom(event.target)) return;
      event.preventDefault();
      event.stopPropagation();
    },
    true
  );
</script>
