---
// A zoomable map for a case study that names specific places. Included on
// every case study page the way Lightbox is, but it loads nothing until it
// finds a `[data-sitemap]` container: Leaflet and its stylesheet are a dynamic
// import, so Vite splits them into a chunk no other page ever fetches.
//
// The markup lives in the project's own markdown, because the map belongs at
// one point in the argument and only the prose knows where that is. This file
// is behaviour and nothing else.
---

<script>
  // One compared site. `oid` is MAPC's stable site_oid and `id` the display
  // name; `rank` is the equal-weight rank of the main comparison, with `tied`
  // set where another site holds the same rank. `km` is a straight-line
  // distance and `daily` counts boardings and alightings, not riders.
  type Site = {
    oid: number;
    id: string;
    code: string;
    station: string;
    muni: string;
    line: string;
    acres: number;
    ppa: number;
    daily: number;
    peak: number;
    km: number;
    frontier: boolean;
    rank: number;
    tied: boolean;
    score: number;
    lat: number;
    lng: number;
  };
  type Line = { line: string; branch: string; pts: [number, number][] };
  type MapData = { lines: Line[]; sites: Site[]; total: number; frontier: number };

  // The MBTA's own line colours, which are the ones on every station sign and
  // the ones the charts in this case study already use.
  const LINE_COLOR: Record<string, string> = {
    Red: '#DA291C',
    Orange: '#ED8B00',
    Blue: '#003DA5',
    Green: '#00843D',
    Mattapan: '#DA291C',
  };

  // OpenStreetMap's own tiles, credited as their licence requires. CARTO's
  // greyscale styles sit behind orange markers better, but their raster
  // service now needs a key that has to be restricted to one domain, which
  // leaves the map blank on localhost and on any other host the site answers
  // to. A busier basemap is worth more than a key to keep working.
  const TILES = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  const ATTRIB =
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

  const money = (v: number) =>
    v >= 1e6 ? `$${(v / 1e6).toFixed(2)}M` : `$${Math.round(v / 1e3)}K`;

  // What the markers mean is under the figure, where it stays in a printout
  // and in the fallback. This is the part that only makes sense while the map
  // is live: how to read a code and how to work the thing.
  function resting(_d: MapData) {
    return (
      '<p class="smap__side-head">Reading the map</p>' +
      '<p>A labelled marker is a non-dominated site, named by a short code:' +
      ' three letters for the station, then the site\u2019s number. MAL-1 is' +
      ' Malden Center #1.</p>' +
      '<p>Every marker takes the colour of its nearest station’s line.</p>' +
      '<p>Zoom in to separate the sites that share a station and to read the' +
      ' names in full.</p>' +
      '<p class="smap__cue">Select any site for its values, and the map' +
      ' itself to put it down again.</p>'
    );
  }

  function detail(s: Site, total: number) {
    // Four pairs, in the order a reader asks the questions: where is it, what
    // is the parcel, what is the station, what does the model make of it. Each
    // pair is its own `tbody`, which buys a little air between the groups
    // without a heading per group or a line of extra height.
    //
    // Labels short enough to hold one line in the column, so the figures
    // beside them start on a single left edge instead of stepping in and out
    // around two-line headings.
    // Label over value, the way the case study's own quick facts read, so each
    // label can say exactly what the figure is without squeezing the figure
    // into a narrow column beside it.
    const rows: [string, string][] = [
      ['Community', s.muni],
      ['Line', `${s.line} Line`],
      ['Straight-line distance to station', `${s.km.toFixed(2)} km`],
      ['Buildable area', `${s.acres.toFixed(2)} acres`],
      ['Assessed land value per acre', money(s.ppa)],
      ['Boardings and alightings', `${s.daily.toLocaleString()} a day`],
      // Described, not scored: the main comparison gives peak share no
      // direction, so nothing here rewards a low or a high value.
      ['Peak share (described only)', `${s.peak}% of weekday activity`],
      ['Equal-weight rank', `${s.rank}${s.tied ? ' (tied)' : ''} of ${total}`],
    ];
    // The code is on the marker the reader just clicked, so repeating it here
    // spends a line of the heading on something already in view.
    const head = s.id;
    const body = rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
    const note = s.frontier
      ? '<p class="smap__win">Non-dominated: no other compared site is at least as good' +
        ' on all three indicators and better on one.</p>'
      : '<p class="smap__note">Dominated: another compared site is at least as good on' +
        ' all three indicators and better on at least one.</p>';
    return `<p class="smap__side-head">${head}</p><dl class="smap__facts">${body}</dl>${note}`;
  }

  async function build(host: HTMLElement) {
    const src = host.dataset.sitemap;
    if (!src) return;
    host.dataset.state = 'loading';

    const [{ default: L }, res] = await Promise.all([
      import('leaflet'),
      fetch(src),
    ]);
    await import('leaflet/dist/leaflet.css');
    const data: MapData = await res.json();

    // The map pane and the detail panel are built here rather than written
    // into the markdown: they are two halves of one control, and the prose
    // should only have to say where the control goes.
    const canvas = document.createElement('div');
    canvas.className = 'smap__canvas';
    const side = document.createElement('aside');
    side.className = 'smap__side';
    side.setAttribute('aria-live', 'polite');
    side.innerHTML = resting(data);
    host.prepend(canvas, side);

    const map = L.map(canvas, {
      // A map that eats the page scroll is a map that traps a reader on a
      // phone. Wheel zoom turns on once the map is deliberately clicked.
      scrollWheelZoom: false,
      zoomControl: false,
      // Quarter steps for fitting the view, so a little more margin round the
      // sites widens it a little instead of dropping a whole zoom level. The
      // buttons still step by one.
      zoomSnap: 0.25,
      zoomDelta: 1,
      attributionControl: true,
    });

    L.tileLayer(TILES, {
      attribution: ATTRIB,
      maxZoom: 18,
      minZoom: 9,
    }).addTo(map);

    // Each line on a white casing. Drawn pale, Orange sank into the basemap's
    // orange trunk roads and Blue into the harbour; the casing separates the
    // line from whatever is under it, and the sites stay distinct because
    // they are ringed dots rather than strokes.
    for (const ln of data.lines) {
      L.polyline(ln.pts, {
        color: '#FFFFFF',
        weight: 6,
        opacity: 0.7,
        lineCap: 'round',
        lineJoin: 'round',
        interactive: false,
      }).addTo(map);
    }
    for (const ln of data.lines) {
      L.polyline(ln.pts, {
        color: LINE_COLOR[ln.line] ?? '#6E685A',
        weight: 3,
        opacity: 0.6,
        lineCap: 'round',
        lineJoin: 'round',
        interactive: false,
      }).addTo(map);
    }

    let chosen: HTMLElement | null = null;
    let chosenSite: Site | null = null;

    function clearSelection() {
      if (chosen) chosen.classList.remove('is-on');
      chosen = null;
      chosenSite = null;
      side.innerHTML = resting(data);
    }

    function select(s: Site, el: HTMLElement | null) {
      // A second click on the parcel already open closes it. Selecting is the
      // only way in, so it should be the way back out too.
      if (chosenSite === s) return clearSelection();
      if (chosen) chosen.classList.remove('is-on');
      if (el) el.classList.add('is-on');
      chosen = el;
      chosenSite = s;
      side.innerHTML = detail(s, data.total);
    }

    // The parcels the dominance step discarded. Two objects each: the circle a
    // reader sees, and an empty 30-pixel marker carrying the tap.
    //
    // An SVG shape is hit-tested against the shape itself, so a four-pixel dot
    // is a nine-pixel target and a finger never lands on one. A grid of taps
    // across the map at phone size hit a numbered marker 114 times and a grey
    // dot not once. The catcher is a marker rather than a wider invisible
    // circle because a marker is a DOM element in the marker pane, which is
    // the same thing the numbered parcels already use and the same thing that
    // already takes a tap reliably.
    //
    // The visible dots are held in a list because their size follows the zoom:
    // four pixels reads on a regional view and disappears into a street map at
    // zoom sixteen, where the basemap has its own grey shapes at that size.
    const dots: ReturnType<typeof L.circleMarker>[] = [];
    for (const s of data.sites) {
      if (s.frontier) continue;
      // The line of the site's nearest station, as the labels and the drawn
      // lines carry it, but quiet: a pale fill and a thin ring in the line's
      // colour. Full saturation is kept for the fifteen non-dominated sites,
      // which are the ones the section is about.
      const dot = L.circleMarker([s.lat, s.lng], {
        radius: 4,
        color: LINE_COLOR[s.line] ?? '#6E685A',
        weight: 1.2,
        opacity: 0.85,
        fillColor: '#FFFFFF',
        fillOpacity: 0.9,
        interactive: false,
      }).addTo(map);
      dots.push(dot);

      const catcher = L.marker([s.lat, s.lng], {
        icon: L.divIcon({ className: 'smap__catch', html: '',
                          iconSize: [30, 30], iconAnchor: [15, 15] }),
        keyboard: false,
        // Under the numbered markers: where a pill sits over a grey dot the
        // pill is the thing worth opening.
        zIndexOffset: -1000,
      }).addTo(map);
      catcher.on('click', (e) => {
        L.DomEvent.stopPropagation(e.originalEvent);
        select(s, null);
      });
    }

    // The non-dominated sites last, labelled, so they sit above the field.
    const pins: { s: Site; marker: ReturnType<typeof L.marker> }[] = [];
    for (const s of data.sites) {
      if (!s.frontier) continue;
      const marker = L.marker([s.lat, s.lng], {
        icon: L.divIcon({
          className: `smap__pin smap__pin--${s.line.toLowerCase()}`,
          // The short code, because a marker has room for five characters
          // and two dozen of them sit side by side at the zoom the map opens
          // at. The name the rest of the page uses replaces it on zooming in,
          // which is also what teaches the reader that MAL-1 is Malden
          // Center #1.
          html: '<i class="smap__lead"></i>' +
            `<span class="smap__pin-short">${s.code}</span>` +
            `<span class="smap__pin-full">${s.id}</span>`,
          // A zero-size anchor. The visible pill is an inner element that
          // centres itself with its own transform, so the label can be any
          // width without moving the point it marks.
          iconSize: [0, 0],
          iconAnchor: [0, 0],
        }),
        keyboard: true,
        title: `${s.code}, ${s.id}`,
        // Leaflet stacks markers by latitude, so a northern site goes behind
        // whatever sits just south of it. The two sites tied first share
        // Malden Center with a third label, so they are lifted above it.
        zIndexOffset: s.rank === 1 ? 1000 : 0,
      }).addTo(map);
      marker.on('click keypress', (e) => {
        if (e.originalEvent) L.DomEvent.stopPropagation(e.originalEvent);
        select(s, marker.getElement() as HTMLElement | null);
      });
      // The element does not exist until the map has a view, so it is looked
      // up when the labels are placed.
      pins.push({ s, marker });
    }

    // Labels at one station sat on top of one another: four at Harvard, three
    // at Malden Center. Each zoom, the labels are placed in rank order, and a
    // label that would overlap one already placed moves to the nearest free
    // spot around its site, with a leader line and a dot in the line's colour
    // left at the site itself. Placement only depends on distances in pixels,
    // so panning does not change it; zoom and a change of size do.
    const GAP = 3;
    function placeLabels() {
      const placed: DOMRect[] = [];
      const hits = (x: number, y: number, w: number, h: number) =>
        placed.some((r) => x < r.right + GAP && x + w > r.left - GAP &&
                           y < r.bottom + GAP && y + h > r.top - GAP);
      const order = [...pins].sort((a, b) => a.s.rank - b.s.rank || a.s.oid - b.s.oid);
      for (const { s, marker } of order) {
        const el = marker.getElement() as HTMLElement | undefined;
        if (!el) continue;
        el.style.setProperty('--c', LINE_COLOR[s.line] ?? '#6E685A');
        el.style.setProperty('--dx', '0px');
        el.style.setProperty('--dy', '0px');
        el.removeAttribute('data-moved');
        const label = [...el.querySelectorAll('span')].find((n) => n.offsetWidth > 0);
        if (!label) continue;
        const w = label.offsetWidth, h = label.offsetHeight;
        const p = map.latLngToContainerPoint([s.lat, s.lng]);
        const tries: [number, number][] = [[0, 0]];
        for (let k = 1; k <= 4; k++) {
          const dy = k * (h + GAP), dx = k * (w / 2 + GAP + 4);
          tries.push([0, -dy], [0, dy], [dx, 0], [-dx, 0], [dx, -dy], [-dx, -dy], [dx, dy], [-dx, dy]);
        }
        let best: [number, number] = [0, 0];
        for (const [dx, dy] of tries) {
          if (!hits(p.x + dx - w / 2, p.y + dy - h / 2, w, h)) { best = [dx, dy]; break; }
        }
        const [dx, dy] = best;
        placed.push(new DOMRect(p.x + dx - w / 2, p.y + dy - h / 2, w, h));
        el.style.setProperty('--dx', `${dx}px`);
        el.style.setProperty('--dy', `${dy}px`);
        if (dx || dy) {
          el.dataset.moved = '';
          el.style.setProperty('--len', `${Math.hypot(dx, dy)}px`);
          el.style.setProperty('--ang', `${Math.atan2(dy, dx)}rad`);
        }
      }
    }

    const bounds = L.latLngBounds(data.sites.map((s) => [s.lat, s.lng]));
    // More margin on the right and at the bottom, where the controls and the
    // credit sit, so no labelled site starts out underneath them.
    const FIT = { paddingTopLeft: [40, 40] as [number, number], paddingBottomRight: [72, 56] as [number, number] };
    map.fitBounds(bounds, FIT);
    map.setMaxBounds(bounds.pad(1.2));

    // No legend box. The panel carries the key while nothing is selected, and
    // at any width a legend would cover the map it explains. A scale bar is
    // the one thing the panel cannot supply.
    L.control.scale({ imperial: false, position: 'bottomleft' }).addTo(map);

    const wheel = (on: boolean) => {
      if (on) map.scrollWheelZoom.enable();
      else map.scrollWheelZoom.disable();
      // Mirrors `data-state` and `data-zoom`: the component's states are
      // readable from the DOM, which is what makes them checkable.
      host.dataset.wheel = on ? 'on' : 'off';
    };

    // Two buttons under the zoom pair, the same size as they are. Full screen
    // takes the whole component, map and panel together, so a reader working
    // through the inner core has room and keeps the figures beside the map.
    // Reset returns the view to the whole region and the panel to its key.
    const ICON = {
      expand: '<path d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4"/>',
      shrink: '<path d="M6 2v4H2M10 2v4h4M6 14v-4H2M10 14v-4h4"/>',
      target: '<circle cx="8" cy="8" r="5.2"/><circle cx="8" cy="8" r="1.4"/>' +
        '<path d="M8 0.8v2.4M8 12.8v2.4M0.8 8h2.4M12.8 8h2.4"/>',
    };
    const svg = (d: string) =>
      '<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none"' +
      ' stroke="currentColor" stroke-width="1.6" stroke-linecap="round"' +
      ' stroke-linejoin="round">' + d + '</svg>';
    const canFull = !!(host.requestFullscreen && document.fullscreenEnabled);

    const controls = L.control({ position: 'bottomright' });
    controls.onAdd = () => {
      const bar = L.DomUtil.create('div', 'leaflet-bar smap__reset');
      const make = (label: string, title: string, icon: string, act: () => void) => {
        const button = L.DomUtil.create('a', '', bar) as HTMLAnchorElement;
        button.href = '#';
        button.setAttribute('role', 'button');
        button.title = title;
        button.setAttribute('aria-label', label);
        button.innerHTML = svg(icon);
        L.DomEvent.on(button, 'click', (event: Event) => {
          L.DomEvent.stop(event);
          act();
        });
        return button;
      };
      make('Reset the map', 'Show the whole region again and clear the selection', ICON.target, () => {
        map.fitBounds(bounds, FIT);
        clearSelection();
      });
      if (canFull) {
        const full = make('Full screen', 'Show the map full screen', ICON.expand, () => {
          if (document.fullscreenElement === host) document.exitFullscreen();
          else host.requestFullscreen().catch(() => {});
        });
        document.addEventListener('fullscreenchange', () => {
          const on = document.fullscreenElement === host;
          full.innerHTML = svg(on ? ICON.shrink : ICON.expand);
          full.title = on ? 'Leave full screen' : 'Show the map full screen';
          full.setAttribute('aria-label', on ? 'Leave full screen' : 'Full screen');
          host.dataset.full = on ? 'on' : 'off';
          // The box changed size under Leaflet, which has to measure again, and
          // a full-screen map takes the wheel without waiting for the pointer.
          map.invalidateSize();
          wheel(on);
        });
      }
      L.DomEvent.disableClickPropagation(bar);
      return bar;
    };
    controls.addTo(map);
    // Added after the buttons: in a bottom corner Leaflet stacks each new
    // control above the last, so zoom sits on top and reset and full screen
    // below it, by the credit line.
    const zoom = L.control.zoom({ position: 'bottomright' });
    zoom.addTo(map);
    zoom.getContainer()?.classList.add('smap__zoom');

    // Station names appear once there is room for them, and the grey dots grow
    // to stay legible as the basemap fills with detail. The white ring widens
    // with them: it is what separates a parcel from whatever the map draws
    // underneath it.
    const NAMES_FROM = 12;
    const dotRadius = (z: number) => (z >= 16 ? 9 : z >= 14 ? 7 : z >= 12 ? 5 : 4);
    const onZoom = () => {
      const z = map.getZoom();
      host.dataset.zoom = z >= NAMES_FROM ? 'in' : 'out';
      const r = dotRadius(z);
      for (const dot of dots) {
        dot.setRadius(r);
        dot.setStyle({ weight: r >= 7 ? 1.8 : 1.2 });
      }
    };
    map.on('zoomend', onZoom);
    onZoom();
    // After onZoom, which switches the labels between code and full name.
    map.on('zoomend resize', placeLabels);
    placeLabels();

    // The wheel follows the pointer: over the map it zooms, off the map the
    // page scrolls. Requiring a click first meant a reader who hovered and
    // scrolled got neither, which reads as a broken map rather than as a
    // protected page.
    //
    // DOM `mouseenter`/`mouseleave` rather than Leaflet's own `mouseout`,
    // which also fires when the pointer crosses onto a marker inside the map.
    // Anywhere on the map that is not a parcel puts the open one down, which
    // is the gesture a reader tries before looking for a control.
    map.on('click', clearSelection);

    canvas.addEventListener('mouseenter', () => wheel(true));
    canvas.addEventListener('mouseleave', () => wheel(document.fullscreenElement === host));
    wheel(false);

    host.dataset.state = 'ready';
  }

  function watch(host: HTMLElement) {
    const go = () =>
      build(host).catch((err) => {
        // The fallback picture is still in the container, so a failure here
        // degrades to the static map rather than to an empty box.
        host.dataset.state = 'failed';
        console.error('site map', err);
      });
    if (!('IntersectionObserver' in window)) return go();

    const obs = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        clearTimeout(timer);
        go();
      },
      { rootMargin: '400px' }
    );
    obs.observe(host);

    // Not every context delivers an intersection: a background tab and an
    // embedded webview can both leave the callback unfired indefinitely. The
    // map is the reason its section exists, so after a few seconds it loads
    // whether or not anyone has scrolled to it.
    const timer = setTimeout(() => {
      obs.disconnect();
      go();
    }, 4000);
  }

  function init() {
    for (const host of document.querySelectorAll<HTMLElement>('[data-sitemap]')) {
      // Claimed synchronously. `build` only reaches its first assignment after
      // two awaits, and Leaflet refuses to initialise a container twice.
      if (host.dataset.state) continue;
      host.dataset.state = 'waiting';
      watch(host);
    }
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  /* The map runs at the full figure width, not the prose measure: it is the
     one picture on the page a reader is meant to work inside rather than
     glance at, and the inner core is unreadable in a 905px column. Map above,
     panel below on a phone; side by side once there is room. */
  .smap {
    position: relative;
    display: grid;
    /* No aspect ratio on a phone. A fixed box would have to divide its height
       between the map and the panel, and the panel holds eight rows and a
       sentence: at 375px that is a 200px window scrolling over 260px of text,
       which is the one thing a detail panel must not do. The map takes a fixed
       height and the panel takes whatever it needs underneath, so the parcel's
       figures are always there in full and the page scrolls, not the panel. */
    grid-template-rows: min(62vh, 26rem) auto;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .smap {
      grid-template-rows: none;
      grid-template-columns: 1fr 17rem;
      aspect-ratio: 3 / 2;
    }
  }

  @media (min-width: 1024px) {
    .smap {
      /* Wide enough that `Riders at the station` and `7,065` each hold one
         line with the figures on a single left edge. Narrower and the labels
         wrap, which steps the figures in and out down the column. */
      grid-template-columns: 1fr 20rem;
      aspect-ratio: 16 / 9;
    }
  }

  .smap__canvas {
    min-width: 0;
    min-height: 0;
  }

  .smap__side {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--sp-16, 1rem);
    border-top: 1px solid var(--rule);
    background: var(--bg);
    color: var(--text-2);
    /* A caption's size. The panel is chrome around the map, not a column of
       the article, and at the body size it read as the louder of the two. */
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .smap__side {
      /* Beside the map it is a fixed column again, so here the scrollbar is
         the right answer: the page cannot grow sideways. */
      overflow-y: auto;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }

  /* A 30 by 18 pixel marker is a hard target for a thumb. Bigger on a phone,
     where there is also less need to fit two dozen of them across the width. */
  @media (max-width: 639px) {
    .smap .smap__pin > span {
      padding: 0.3125rem 0.5rem;
      font-size: 0.75rem;
    }
  }

  /* `.prose p` is scoped to the case study page and carries two classes' worth
     of weight, which beat a single class here: the panel's paragraphs were
     rendering at the article's copy size and ink while its table obeyed the
     panel. Three classes, the same fix the table needed. */
  .prose .smap .smap__side p {
    margin: 0;
    max-width: none;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .prose .smap .smap__side b {
    color: var(--text);
  }

  .prose .smap .smap__side p.smap__side-head {
    color: var(--text);
    font-weight: 600;
  }

  .prose .smap .smap__side p.smap__cue {
    color: var(--text-3);
  }

  /* Before the script runs, and if it never does: the same map as a picture. */
  .smap__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--sp-16, 1rem);
  }

  /* Three classes, because `.prose figure img` sets full width and an auto
     height, which let a tall picture run out of the box and over the caption.
     The box has a definite size, so the picture fills it and letterboxes. */
  .prose .smap .smap__fallback img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

