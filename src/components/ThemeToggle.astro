---
// One quiet icon button, no track and no box. It shows the mode you are
// switching *to*: a moon in light, a sun in dark. That reads as an action here,
// where a sliding track read as a second boxed control sitting beside the nav.
//
// Both icons are in the DOM and cross-fade, because `display` cannot animate
// and swapping the markup would make the button jump.
---

<button
  type="button"
  class="tsw"
  data-theme-toggle
  aria-label="Switch to dark theme"
>
  <span class="tsw__icon tsw__icon--moon" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="15" height="15" focusable="false">
      <path
        d="M13.4 10.1A5.7 5.7 0 0 1 6 2.6a5.7 5.7 0 1 0 7.4 7.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  <span class="tsw__icon tsw__icon--sun" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="15" height="15" focusable="false">
      <circle cx="8" cy="8" r="3.1" fill="none" stroke="currentColor" stroke-width="1.3" />
      <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <path d="M8 1.4v1.6M8 13v1.6M14.6 8H13M3 8H1.4" />
        <path d="M12.7 3.3l-1.1 1.1M4.4 11.6l-1.1 1.1M12.7 12.7l-1.1-1.1M4.4 4.4L3.3 3.3" />
      </g>
    </svg>
  </span>
</button>

<style>
  .tsw {
    position: relative;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    background: transparent;
    color: var(--text-3);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* Keeps the real tap target at 44 x 44 without a 44px control in the nav. */
  .tsw::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--tap);
    height: var(--tap);
    transform: translate(-50%, -50%);
  }

  /* Stacked, so the two can cross-fade in place. Nudged up a pixel: both
     glyphs read low against the nav's cap height when they are optically
     centred in the 20px box. */
  .tsw__icon {
    position: absolute;
    display: grid;
    place-items: center;
    transform: translateY(-1px);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .tsw__icon--sun {
    opacity: 0;
  }

  :root[data-theme='dark'] .tsw__icon--moon {
    opacity: 0;
  }

  :root[data-theme='dark'] .tsw__icon--sun {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .tsw:hover {
      color: var(--text);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .tsw:active {
      color: var(--text);
      transition-duration: var(--dur-press);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  function resolved(): 'light' | 'dark' {
    const pref = root.getAttribute('data-theme-pref');
    if (pref === 'dark' || pref === 'light') return pref;
    return mq.matches ? 'dark' : 'light';
  }

  // Label only. Kept separate from apply() so syncing the button never writes a
  // preference — an unchosen theme has to stay unchosen for the OS to lead.
  function label(theme: 'light' | 'dark') {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (button) {
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    }
  }

  let clearSwitching: number | undefined;

  function apply(theme: 'light' | 'dark') {
    // Colours fade instead of snapping. The class is temporary: leaving these
    // transitions on permanently would make every other state change laggy.
    root.classList.add('is-theme-switching');
    window.clearTimeout(clearSwitching);
    // Just past --dur-theme (150ms). While the class is on, its !important
    // transitions override every hover on the page, so it should not outlive
    // the fade by much.
    clearSwitching = window.setTimeout(() => {
      root.classList.remove('is-theme-switching');
    }, 190);

    root.setAttribute('data-theme', theme);
    root.setAttribute('data-theme-pref', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode — the session still switches, it just will not persist */
    }
    label(theme);
  }

  // This module runs once, but the button is a new element after every
  // client-side navigation, so binding happens per page load. The theme itself
  // is re-applied by the inline script in Base.astro on `astro:after-swap`.
  function bind() {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      apply(resolved() === 'dark' ? 'light' : 'dark');
    });
    label(resolved());
  }

  // Still follows the OS while nothing has been chosen.
  mq.addEventListener('change', () => {
    if (root.getAttribute('data-theme-pref') === 'system') {
      const theme = mq.matches ? 'dark' : 'light';
      root.setAttribute('data-theme', theme);
      label(theme);
    }
  });

  document.addEventListener('astro:page-load', bind);
  bind();
</script>
