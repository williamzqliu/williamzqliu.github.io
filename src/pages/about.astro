---
import Base from '../layouts/Base.astro';

// SPEC §9 — real specifics, no "T-shaped designer", no "passionate about".
// TODO: placeholder dates and details to be confirmed.
const allLinks = [
  { label: 'Email', href: '#' },
  { label: 'Resume', href: '#' },
  { label: 'GitHub', href: 'https://github.com/williamzqliu' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/william-zqliu' },
];
const links = allLinks.filter((link) => link.href !== '#');
---

<Base
  title="About — Zhuoqi Liu"
  description="Designer and developer building interactive tools for network and relational data."
  current="/about"
>
  <section class="about">
    <div class="container">
      <h1 class="about__title">About</h1>

      <div class="about__prose">
        <p>
          I am a designer and developer working on interactive tools for network and relational
          data. I am finishing an MFA in Information Design and Data Visualization at Northeastern
          in December 2026.
        </p>
        <p>
          Before that I read computer science at Tongji University. I wrote embedded C++ at Axis
          Communications, and worked on data-driven storytelling at Shanghai Media Group. The two
          halves are the reason I build rather than specify: the design decisions I care about are
          usually the ones that only surface once something is running at real scale.
        </p>
        <p>
          Recent work has been presented at NetSci 2026 and EMNLP 2026. Most of it involves graphs
          that are large enough to be awkward — the interesting problem is rarely the layout
          algorithm, it is deciding what a reader should be able to do with 2,000 nodes on a screen.
        </p>
        <p>TODO: expand. Add what you are looking for and what you will not do.</p>
      </div>

      <ul class="about__links">
        {
          links.map((link) => (
            <li>
              <a class="about__link" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
                <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path d="M4.5 1.5H10.5V7.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M10.5 1.5L4 8" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M8.5 10.5H1.5V3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
                <span class="vh">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about {
    padding-block: var(--sp-48) var(--sp-96);
  }

  .about__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .about__prose {
    margin-top: var(--sp-32);
    max-width: 62ch;
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
  }

  .about__prose p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-24);
    margin-top: var(--sp-48);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .about__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-2);
    padding-block: var(--sp-12);
    border-bottom: var(--rule-hair) solid var(--rule);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .about__link:hover {
      color: var(--text);
      border-bottom-color: var(--rule-strong);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (min-width: 1024px) {
    .about {
      padding-block: var(--sp-64) var(--sp-96);
    }
  }
</style>
