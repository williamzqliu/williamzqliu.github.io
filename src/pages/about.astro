---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import IdentityLine from '../components/IdentityLine.astro';
import ExploreAllWork from '../components/ExploreAllWork.astro';

// The portrait is a file in public/, so its presence is checked at build time
// rather than assumed: a missing photo leaves a framed placeholder instead of
// a broken image (missing media must not block publishing).
const PORTRAIT_CANDIDATES = ['/media/about/portrait.webp', '/media/about/portrait.jpg'];
const portrait = PORTRAIT_CANDIDATES.find((file) =>
  fs.existsSync(path.join(process.cwd(), 'public', file.replace(/^\//, '')))
);

// Contact lives in the footer now — one contact point per site, not one per
// page.
---

<Base
  title="About — Zhuoqi Liu"
  description="Data visualization and information designer combining research communication, visual design, and front-end development."
  current="/about"
>
  <section class="about">
    <div class="container">
      {/* Same composition as the homepage, one size instead of two: on this
          page the line is a page title, not the opening moment. */}
      <div class="about__identity">
        {/* Pronunciation parked for now — it still runs on the homepage, and
            IdentityLine renders it again the moment `respelling` comes back. */}
        <IdentityLine as="h1" greeting="Hi, I’m" name="Zhuoqi." />
      </div>

      <div class="about__grid" data-totop-from>
        <div class="about__prose">
          {/* <strong> carries the emphasis semantically; the styling is weight
              and ink only — no size change, no italics, no colour accent. */}
          <p>
            I’m a <strong>data visualization and information designer</strong> based in Boston,
            building visual explanations and interactive tools for complex data. I’m completing an
            MFA in Information Design and Data Visualization at Northeastern University in
            December&nbsp;2026.
          </p>
          <p>
            I’m currently a research assistant with Northeastern’s{' '}
            <strong><a class="link" href="https://gamesforlife.sites.northeastern.edu/" target="_blank" rel="noopener noreferrer">Games for Life</a></strong>{' '}
            initiative, developing visuals for an industry-facing report and helping update its
            website. The NSF-funded project focuses on age-friendly gaming and responsible AI.
          </p>
          <p>
            For a research team at Northeastern University London, I designed and developed{' '}
            <a class="link" href="/work/ai-ethics-network/">AI Ethics Network</a>. I also presented a
            poster at NetSci 2026 and co-authored a paper accepted to the{' '}
            <a class="link" href="/work/citing-less-critically/">EMNLP 2026 Main Conference</a>.
          </p>
          <p>
            I bring a computer science background to my design work and like testing ideas in a
            running prototype. I’m seeking roles in <strong>data visualization and information
            design</strong>, alongside design engineering work focused on data interfaces.
          </p>
          {/* Explore all work's label and rule, at the text column's width and
              pointed at the resume. */}
          <ExploreAllWork href="/resume" label="View resume" />
        </div>

        <figure class="about__photo">
          {
            portrait ? (
              <>
                <img
                  src={portrait}
                  alt="Zhuoqi Liu on the opening day of the MFA thesis exhibition, standing beside the project panels"
                  width="640"
                  height="800"
                  loading="lazy"
                />
                <figcaption>Opening day of my MFA thesis exhibition</figcaption>
              </>
            ) : (
              <div class="about__photo-pending">
                <span>portrait</span>
                <span>public/media/about/portrait.webp</span>
              </div>
            )
          }
        </figure>
      </div>

      {/* Publications block parked for now. Restore by uncommenting; the
          styles below are still in place.
      <h2 class="about__pubs-label section-label">Publications</h2>
      <div class="about__pub">
        <p class="about__pub-authors">
          Yixuan Liu, Lin Chen, <strong>Zhuoqi Liu</strong>, Jianglin Lu, Dakota Murray.
        </p>
        <p class="about__pub-title">
          Citing Less Critically: LLMs Reshape the Rhetoric and Reach of Scientific Citation.
        </p>
        <p class="about__pub-venue">
          EMNLP 2026 (Main Conference). <a class="link" href="https://arxiv.org/abs/2609.01432" target="_blank" rel="noopener noreferrer">arXiv:2609.01432</a>
        </p>
      </div>
      */}

    </div>
  </section>
</Base>

<style>
  /* The bottom is shorter than the page's other sections on purpose. The
     footer brings 40px of its own margin plus its rule, so --sp-96 here left
     136px of nothing between the last paragraph and the boundary — half again
     the gap a case study closes on. */
  .about {
    padding-block: var(--sp-48) var(--sp-56);
  }

  /* Greeting and name at the same size here — the step-up belongs to the
     homepage, where the name is the opening moment. */
  .about__identity {
    --idl-greet: var(--fs-hello-greet);
    /* A step larger, upright. The name stands out on face, colour and size —
       it does not need the slant as well. */
    --idl-name: calc(var(--fs-hello-greet) * 1.18);
    --idl-gap: 10px;
  }

  .about__grid {
    display: grid;
    gap: var(--sp-32);
    margin-top: var(--sp-32);
  }

  .about__prose {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
  }

  /* Portrait ratio, square corners like everything else. The frame belongs to
     the image, not to the figure — a border around both would turn the photo
     and its caption into a card. */
  .about__photo {
    order: -1;
    align-self: start;
  }

  .about__photo img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-hair) solid var(--rule);
    /* The file is already 4:5, so `cover` crops nothing — it is here so a
       later replacement at another ratio cannot break the column. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__photo figcaption {
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* Same 4:5 box while the file is missing, so the layout is already right. */
  .about__photo-pending {
    border: var(--rule-hair) solid var(--rule);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--sp-4);
    aspect-ratio: 4 / 5;
    padding: var(--sp-12);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    color: var(--text-3);
    text-transform: uppercase;
  }

  /* Body copy sits a step back from full ink so the emphasised phrases can
     come forward without changing size, style or colour. */
  /* `pretty` so no paragraph ends on a single word, the way the hero and the
     quick facts already wrap. Where it is not supported, the date is held
     together in the markup instead. */
  .about__prose p {
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
    text-wrap: pretty;
  }

  .about__prose strong {
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  /* The resume link's rule belongs to the link, not to the paragraph above
     it: more room over the rule than under it, so the two read as one closing
     line rather than an underline on the last sentence. */
  .about__prose :global(.more) {
    margin-top: var(--sp-16);
    padding-top: var(--sp-24);
  }

  /* The rule under the label matches the column it heads, not the container.
     A full-width rule over a 62ch citation reads as a stray line. */
  .about__pubs-label {
    margin-top: var(--sp-48);
    max-width: var(--measure);
  }

  .about__pub {
    margin-top: var(--sp-16);
    max-width: var(--measure);
  }

  .about__pub-authors,
  .about__pub-venue {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .about__pub-title {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    font-style: italic;
    color: var(--text);
  }




  @media (min-width: 1024px) {
    .about {
      padding-block: var(--sp-64) var(--sp-56);
    }

    /* Prose left, portrait right. The photo column is fixed so the prose keeps
       its measure instead of stretching to fill. */
    .about__grid {
      grid-template-columns: minmax(0, 1fr) 440px;
      column-gap: var(--sp-64);
      align-items: start;
    }

    /* Wide enough that the gutter between the columns is the gap and nothing
       else, and pinned right so both columns meet the page's own edges. */
    .about__photo {
      order: 0;
      justify-self: end;
      width: 440px;
      max-width: none;
    }

    /* The block — image plus caption — stretches to the prose column, so the
       caption's last line ends where the last paragraph does at any length of
       copy. The image takes whatever the caption leaves (a zero basis keeps
       its own height out of the row), and the difference from 4:5 comes off
       the edges, biased upward so the crop takes ceiling and floor rather
       than the face. */
    .about__photo {
      display: flex;
      flex-direction: column;
      align-self: stretch;
    }

    .about__photo img {
      flex: 1 1 0;
      min-height: 0;
      aspect-ratio: auto;
      height: auto;
      object-position: 50% 30%;
    }
  }
</style>
