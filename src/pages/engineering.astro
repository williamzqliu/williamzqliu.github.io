---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FilterRow from '../components/FilterRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featuredProjects, deriveTags, projectLinks, caseStudyHref } from '../lib/projects';

// SPEC §9 — same structure as `/`, different hero line and project set.
// One source, two curations: this reads `tracks: [engineering]`.
const projects = await featuredProjects('engineering');
const tags = deriveTags(projects);
---

<Base
  title="Zhuoqi Liu — Data visualization engineer"
  description="Engineer building interactive tools for network and relational data."
  current="/engineering"
>
  <Hero
    statement="I ship interactive graph tools that stay fast at scale."
    bio="Frontend and data visualization. Computer science at Tongji, embedded C++ at Axis, now an MFA in Information Design and Data Visualization at Northeastern."
  />

  <section class="work rule-heavy-top" aria-labelledby="work-heading">
    <div class="container">
      <div class="work__head">
        <h2 class="work__heading" id="work-heading">Selected work</h2>
        <FilterRow tags={tags} />
      </div>

      <div class="work__list">
        {
          projects.map((project, i) => (
            <ProjectRow
              index={i + 1}
              title={project.data.title}
              year={project.data.year}
              blurb={project.data.blurb}
              stack={project.data.stack}
              href={caseStudyHref(project)}
              tone={project.data.cover.tone}
              links={projectLinks(project)}
              emphasiseStack
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .work {
    padding-top: var(--sp-32);
  }

  .work__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-8);
    padding-bottom: var(--sp-16);
  }

  .work__heading {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-regular);
    color: var(--text-3);
  }

  .work__list {
    border-bottom: var(--rule-hair) solid var(--rule);
  }

  @media (min-width: 640px) {
    .work {
      padding-top: var(--sp-48);
    }

    .work__head {
      gap: var(--sp-16);
    }
  }
</style>
