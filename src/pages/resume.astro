---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import ExtArrow from '../components/ExtArrow.astro';

// Two focuses, one shown at a time. Each has a two-column PDF, which the
// preview, View PDF and Download PDF all use, and a single-column PDF offered
// as a second download. Every address on the page comes from this one table,
// so no control can point at the other focus or the other layout. The files
// are in public/, not build inputs, so their presence is checked at build
// time rather than assumed: a focus whose two-column PDF is missing is left
// out, one whose single-column PDF is missing loses only that link, and with
// none left the page shows a placeholder instead of a dead link (missing
// media must not block publishing). `updated` is stated per focus rather than
// read from the file's mtime, which a copy or checkout resets.
//
// /resume/Zhuoqi_Liu_Resume.pdf is the address older links point at. It is a
// copy of the Data Visualization two-column PDF, kept so those links still
// open a resume.
const VERSIONS = [
  {
    key: 'data-visualization',
    label: 'Data Visualization',
    note: 'Information design, scientific figures, and research visualization.',
    pdf: '/resume/Zhuoqi_Liu_Resume_Data_Visualization.pdf',
    single: '/resume/Zhuoqi_Liu_Resume_Data_Visualization_Single_Column.pdf',
    preview: '/resume/preview-data-visualization.webp',
    updated: 'October 2026',
  },
  {
    key: 'design-engineering',
    label: 'Design Engineering',
    note: 'Interactive data interfaces, front-end development, and workflow automation.',
    pdf: '/resume/Zhuoqi_Liu_Resume_Design_Engineering.pdf',
    single: '/resume/Zhuoqi_Liu_Resume_Design_Engineering_Single_Column.pdf',
    preview: '/resume/preview-design-engineering.webp',
    updated: 'October 2026',
  },
];

const publicFile = (file: string) => path.join(process.cwd(), 'public', file.replace(/^\//, ''));

// The accessible names start with the visible label and add the focus, so a
// screen reader hears which resume a link opens without the label changing.
const versions = VERSIONS.filter((version) => fs.existsSync(publicFile(version.pdf))).map(
  (version) => {
    const hasSingle = fs.existsSync(publicFile(version.single));
    return {
      ...version,
      file: path.basename(version.pdf),
      single: hasSingle ? version.single : null,
      singleFile: hasSingle ? path.basename(version.single) : null,
      alt: `First page of the ${version.label} resume`,
      open: `Open the ${version.label} resume PDF in a new tab`,
      viewName: `View PDF, ${version.label} resume`,
      downloadName: `Download PDF, ${version.label} resume`,
      singleName: `Download Single-Column PDF, ${version.label} resume`,
      hasPreview: fs.existsSync(publicFile(version.preview)),
    };
  }
);

// The first version is the default: what the page shows with no `focus`
// parameter, or with one it does not recognise.
const initial = versions[0];
---

<Base
  title="Resume — Zhuoqi Liu"
  description="Resumes for data visualization and design engineering roles."
  current="/resume"
>
  <section class="resume">
    <div class="container">
      <h1 class="resume__title">Resume</h1>

      {
        initial ? (
          <div data-resume>
            {versions.length > 1 && <p class="resume__intro">Choose a focus to view and download my resume.</p>}

            {/* The filter row's chips, in title case: the two labels are names
                of the focuses, not categories in the work index's register. */}
            {versions.length > 1 && (
              <div class="resume__switch" role="group" aria-label="Resume focus">
                {versions.map((version) => (
                  <button
                    type="button"
                    class="resume__chip"
                    data-version={version.key}
                    aria-pressed={version === initial ? 'true' : 'false'}
                  >
                    {version.label}
                  </button>
                ))}
              </div>
            )}

            <p class="resume__note" data-resume-note aria-live="polite">
              {initial.note}
            </p>

            <p class="resume__actions">
              <a
                class="resume__action"
                data-resume-view
                href={initial.pdf}
                target="_blank"
                rel="noopener"
                aria-label={initial.viewName}
              >
                View PDF
                <ExtArrow />
              </a>

              <a
                class="resume__action"
                data-resume-download
                href={initial.pdf}
                download={initial.file}
                aria-label={initial.downloadName}
              >
                Download PDF
                <svg
                  class="resume__down"
                  viewBox="0 0 10 10"
                  width="10"
                  height="10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M5 1.6v6.8M2 5.4l3 3 3-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              {/* The same file in one column, for forms that read a resume
                  top to bottom. Second in rank, so second in ink and weight:
                  the same link, a step back. */}
              <a
                class="resume__action resume__action--secondary"
                data-resume-single
                href={initial.single ?? undefined}
                download={initial.singleFile ?? undefined}
                aria-label={initial.singleName}
                hidden={!initial.single}
              >
                Download Single-Column PDF
                <svg
                  class="resume__down"
                  viewBox="0 0 10 10"
                  width="10"
                  height="10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M5 1.6v6.8M2 5.4l3 3 3-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              {/* Last in the row and pushed to the far edge: the things you can
                  do with the file come first, and the date is what the row
                  ends on. It is about the file's state, not its format. */}
              <span class="resume__updated" data-resume-updated>
                Updated {initial.updated}
              </span>
            </p>

            {/* A rendered first page, not the browser's PDF viewer: no toolbar,
                no scrollbars, and it keeps the page's own proportions. The
                image has no `src` in the markup: the script below gives it the
                requested focus's preview before the first paint, so a link to
                Design Engineering never fetches the Data Visualization page
                first. Without JS, the default focus's preview comes from the
                noscript copy instead. */}
            <a
              class="resume__preview"
              data-totop-from
              data-resume-preview
              href={initial.pdf}
              target="_blank"
              rel="noopener"
              aria-label={initial.open}
              hidden={!initial.hasPreview}
            >
              <img data-resume-img alt={initial.alt} width="1520" height="2151" hidden />
              <noscript>
                <img src={initial.preview} alt={initial.alt} width="1520" height="2151" />
              </noscript>
            </a>
          </div>
        ) : (
          <div class="resume__pending">
            <p class="t-body-lg">The PDF is not published yet.</p>
            <p class="resume__hint">
              {/* Instruction for the repo owner, not a claim about the resume. */}
              Drop the exports in <code>public/resume/</code> and this page picks
              it up on the next build. Until then, nothing here links anywhere
              dead.
            </p>
            <p class="resume__actions">
              <a class="resume__action" href="/about">
                About, with the same background in prose
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>

  {/* Inline and right after the markup, so the version a link asks for is in
      place before the first paint, on a full load and after a client-side
      navigation alike. `data-astro-rerun` because the router otherwise skips
      an inline script it has already run, which a move from one version's
      link to the other's, both this page, would be. The version lives in
      `?focus=`; a switch replaces the current history entry rather than
      adding one, keeping the router's own state, so Back and Forward move
      between pages and each entry reopens the version it was left on. */}
  <script is:inline data-astro-rerun define:vars={{ versions }}>
  (() => {
    const root = document.querySelector('[data-resume]');
    if (!root || !versions.length) return;

    const byKey = (key) => versions.find((version) => version.key === key);

    const apply = (version) => {
      for (const chip of root.querySelectorAll('.resume__chip')) {
        chip.setAttribute('aria-pressed', String(chip.dataset.version === version.key));
      }

      root.querySelector('[data-resume-note]').textContent = version.note;
      root.querySelector('[data-resume-updated]').textContent = `Updated ${version.updated}`;

      const view = root.querySelector('[data-resume-view]');
      view.href = version.pdf;
      view.setAttribute('aria-label', version.viewName);

      const download = root.querySelector('[data-resume-download]');
      download.href = version.pdf;
      download.setAttribute('download', version.file);
      download.setAttribute('aria-label', version.downloadName);

      const single = root.querySelector('[data-resume-single]');
      single.hidden = !version.single;
      if (version.single) {
        single.href = version.single;
        single.setAttribute('download', version.singleFile);
      } else {
        single.removeAttribute('href');
        single.removeAttribute('download');
      }
      single.setAttribute('aria-label', version.singleName);

      const preview = root.querySelector('[data-resume-preview]');
      preview.href = version.pdf;
      preview.setAttribute('aria-label', version.open);
      preview.hidden = !version.hasPreview;
      const img = preview.querySelector('[data-resume-img]');
      if (version.hasPreview && img.getAttribute('src') !== version.preview) {
        img.src = version.preview;
      }
      img.alt = version.alt;
      img.hidden = false;
    };

    const requested = byKey(new URLSearchParams(location.search).get('focus')) ?? versions[0];
    apply(requested);

    for (const chip of root.querySelectorAll('.resume__chip')) {
      chip.addEventListener('click', () => {
        const version = byKey(chip.dataset.version);
        if (!version) return;
        apply(version);

        const url = new URL(location.href);
        url.searchParams.set('focus', version.key);
        history.replaceState(history.state, '', url);
      });
    }
  })();
  </script>
</Base>

<style>
  .resume {
    /* The width of the page itself once there is room for it, shared by the
       preview and the rows of controls above it. */
    --resume-w: 760px;
    padding-block: var(--sp-48) var(--sp-96);
  }

  .resume__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-hello-greet);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .resume__intro {
    margin-top: var(--sp-16);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* The focus switch, set as the work index's filter row: nav-size labels,
     the accent and its underline on the chosen one. Two entries fit on one
     line at most widths, and where they do not, they wrap rather than
     scroll. */
  .resume__switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-24);
    margin-top: var(--sp-8);
  }

  .resume__chip {
    position: relative;
    display: block;
    font-size: var(--fs-nav);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-2);
    /* Reaches the 44px minimum tap target even though the type is small. */
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .resume__chip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--sp-8);
    height: var(--rule-heavy);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-draw) var(--ease-out);
  }

  .resume__chip[aria-pressed='true'] {
    color: var(--accent);
  }

  .resume__chip[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__chip:hover {
      color: var(--text);
      transition-duration: var(--dur-hover-in);
    }

    .resume__chip[aria-pressed='true']:hover {
      color: var(--accent);
    }

    .resume__chip:active,
    .resume__chip:active::after {
      transition-duration: var(--dur-press);
    }
  }

  /* What the chosen version is for, one line under the switch. */
  .resume__note {
    margin-top: var(--sp-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* Baseline, not centre. The date is mono at 14px with a tight line box and
     the actions are sans at 15px with 8px of tap padding — centring those
     boxes puts their text on two different lines. */
  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* No row gap: where the links wrap on a phone, their own tap padding is
       already the space between the lines. */
    gap: 0 var(--sp-24);
    margin-top: var(--sp-16);
  }

  /* A chip, the same one the project cards use for their stack: mono caps on
     the surface fill, at the same size and padding. It is the same kind of
     thing — a small fixed fact about the item, not a link — and the page had
     no reason to invent a second treatment for it.

     `margin-left: auto` sends it to the far edge of the row. If the row has to
     wrap, the auto margin still resolves against the free space on the line it
     lands on, so it stays right-aligned there too. */
  .resume__updated {
    margin-left: auto;
    align-self: center;
    padding: 5px var(--sp-8);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  @media (min-width: 640px) {
    .resume__updated {
      font-size: 0.75rem;
    }
  }

  /* Text links. The arrow and the caret inherit the text colour and never move
     on their own. */
  .resume__action {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    padding-block: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .resume__action--secondary {
    font-weight: var(--fw-regular);
    color: var(--text-2);
  }

  /* `display: inline-flex` above would otherwise outrank the attribute. */
  .resume__action[hidden] {
    display: none;
  }

  .resume__down {
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* The resume is the content of this page, so the frame around it is one
     hairline on the image and nothing else — no divider above it. */
  .resume__preview {
    display: block;
    margin-top: var(--sp-32);
  }

  .resume__preview[hidden],
  .resume__preview img[hidden] {
    display: none;
  }

  .resume__preview img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-hair) solid var(--rule);
  }

  .resume__pending {
    max-width: var(--measure);
    margin-top: var(--sp-24);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .resume__hint {
    margin-top: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .resume__hint code {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: 0.9em;
  }

  @media (min-width: 1024px) {
    /* Wide enough to read the layout, narrow enough that the page does not
       turn into a scroll of one image. The rows above it are capped to the
       same width, so the date chip ends on the page's right edge rather than
       out at the container's — one column, not two. */
    .resume__preview img,
    .resume__actions {
      max-width: var(--resume-w);
    }
  }
</style>
