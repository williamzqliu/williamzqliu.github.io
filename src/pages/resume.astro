---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import ExtArrow from '../components/ExtArrow.astro';

// The PDF and its preview are files in public/, not build inputs, so their
// presence is checked at build time rather than assumed. Missing asset =
// visible placeholder, never a dead link (SPEC §7: missing media must not
// block publishing).
const PDF_PATH = '/resume/Zhuoqi_Liu_Resume.pdf';
const PREVIEW_PATH = '/resume/preview.webp';

const publicFile = (file: string) => path.join(process.cwd(), 'public', file.replace(/^\//, ''));
const stat = fs.existsSync(publicFile(PDF_PATH)) ? fs.statSync(publicFile(PDF_PATH)) : null;
const published = stat !== null;
const hasPreview = fs.existsSync(publicFile(PREVIEW_PATH));

const updated = stat
  ? stat.mtime.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;
---

<Base
  title="Resume — Zhuoqi Liu"
  description="Resume for Zhuoqi Liu, designer and developer."
  current="/resume"
>
  <section class="resume">
    <div class="container">
      <h1 class="resume__title">Resume</h1>

      {
        published ? (
          <>
            <p class="resume__actions">
              {/* The date sits with the actions rather than in the cell strip:
                  it is about the file's state, not its format. */}
              <span class="resume__updated">Updated {updated}</span>

              <a class="resume__action" href={PDF_PATH} target="_blank" rel="noopener">
                View Resume
                <ExtArrow />
              </a>

              <a class="resume__action" href={PDF_PATH} download>
                Download
                <svg
                  class="resume__down"
                  viewBox="0 0 10 10"
                  width="10"
                  height="10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M5 1.6v6.8M2 5.4l3 3 3-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </p>

            {/* A rendered first page, not the browser's PDF viewer: no toolbar,
                no scrollbars, and it keeps the page's own proportions. */}
            {hasPreview && (
              <a
                class="resume__preview"
                href={PDF_PATH}
                target="_blank"
                rel="noopener"
                aria-label="Open resume PDF in a new tab"
              >
                <img src={PREVIEW_PATH} alt="First page of the resume" width="1240" height="1755" />
              </a>
            )}
          </>
        ) : (
          <div class="resume__pending">
            <p class="t-body-lg">The PDF is not published yet.</p>
            <p class="resume__hint">
              {/* Instruction for the repo owner, not a claim about the resume. */}
              Drop the export at <code>public{PDF_PATH}</code> and this page picks
              it up on the next build. Until then, nothing here links anywhere
              dead.
            </p>
            <p class="resume__actions">
              <a class="resume__action" href="/about">
                About, with the same background in prose
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .resume {
    padding-block: var(--sp-48) var(--sp-96);
  }

  .resume__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-hello-greet);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-24);
    margin-top: var(--sp-24);
  }

  /* On narrow screens the date takes its own line so the two actions can sit
     together instead of stacking into three rows. */
  @media (max-width: 639px) {
    .resume__updated {
      flex-basis: 100%;
    }
  }

  /* The only metadata left on the page, so it reads at the navigation size
     rather than the caption size. */
  .resume__updated {
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  /* Text links. The arrow and the caret inherit the text colour and never move
     on their own. */
  .resume__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .resume__down {
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  .resume__action:active {
    color: var(--accent);
    transition-duration: var(--dur-press);
  }

  /* The resume is the content of this page, so the frame around it is one
     hairline on the image and nothing else — no divider above it. */
  .resume__preview {
    display: block;
    margin-top: var(--sp-32);
  }

  .resume__preview img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-hair) solid var(--rule);
  }

  .resume__pending {
    max-width: 62ch;
    margin-top: var(--sp-24);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .resume__hint {
    margin-top: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .resume__hint code {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: 0.9em;
  }

  @media (min-width: 1024px) {
    /* Wide enough to read the layout, narrow enough that the page does not
       turn into a scroll of one image. */
    .resume__preview img {
      max-width: 760px;
    }
  }
</style>
