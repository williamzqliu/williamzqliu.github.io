---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import ExtArrow from '../components/ExtArrow.astro';

// One resume, shown page by page. The PDF and the rendered pages are files in
// public/, not build inputs, so their presence is checked at build time rather
// than assumed: pages are picked up in order for as long as their previews
// exist, and a missing PDF leaves a placeholder instead of a dead link
// (missing media must not block publishing). `updated` is stated rather than
// read from the file's mtime, which a copy or checkout resets.
//
// /resume/Zhuoqi_Liu_Resume.pdf is also the address older links point at, so
// they open the current resume.
const RESUME = {
  pdf: '/resume/Zhuoqi_Liu_Resume.pdf',
  pagePreview: (n: number) => `/resume/preview-page-${n}.webp`,
  file: 'Zhuoqi_Liu_Resume.pdf',
  updated: 'October 2026',
};

const publicFile = (file: string) => path.join(process.cwd(), 'public', file.replace(/^\//, ''));

const published = fs.existsSync(publicFile(RESUME.pdf));

const pages: string[] = [];
for (let n = 1; fs.existsSync(publicFile(RESUME.pagePreview(n))); n++) {
  pages.push(RESUME.pagePreview(n));
}
---

<Base
  title="Resume — Zhuoqi Liu"
  description="View and download Zhuoqi Liu’s resume for data visualization and design engineering roles."
  current="/resume"
>
  <section class="resume">
    <div class="container">
      <h1 class="resume__title">Resume</h1>

      {
        published ? (
          <>
            <p class="resume__actions">
              <a class="resume__action" href={RESUME.pdf} target="_blank" rel="noopener">
                View PDF
                <ExtArrow />
              </a>

              <a class="resume__action" href={RESUME.pdf} download={RESUME.file}>
                Download PDF
                <svg
                  class="resume__down"
                  viewBox="0 0 10 10"
                  width="10"
                  height="10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M5 1.6v6.8M2 5.4l3 3 3-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              {/* Last in the row and pushed to the far edge: the two things you
                  can do with the file come first, and the date is what the row
                  ends on. It is about the file's state, not its format. */}
              <span class="resume__updated">Updated {RESUME.updated}</span>
            </p>

            {/* Rendered pages, not the browser's PDF viewer: no toolbar, no
                scrollbars, and each keeps the page's own proportions. Each page
                opens the PDF at that page; the first loads with the page, the
                rest when they come near. */}
            {pages.length > 0 && (
              <ol class="resume__pages" data-totop-from>
                {pages.map((src, i) => (
                  <li>
                    <a
                      class="resume__page"
                      href={i === 0 ? RESUME.pdf : `${RESUME.pdf}#page=${i + 1}`}
                      target="_blank"
                      rel="noopener"
                    >
                      <img
                        src={src}
                        alt={`Resume, page ${i + 1} of ${pages.length}`}
                        width="1520"
                        height="2151"
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </>
        ) : (
          <div class="resume__pending">
            <p class="t-body-lg">The PDF is not published yet.</p>
            <p class="resume__hint">
              {/* Instruction for the repo owner, not a claim about the resume. */}
              Drop the export in <code>public/resume/</code> and this page picks
              it up on the next build. Until then, nothing here links anywhere
              dead.
            </p>
            <p class="resume__actions">
              <a class="resume__action" href="/about">
                About, with the same background in prose
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .resume {
    /* The width of one page once there is room for it, shared by the pages
       and the row of controls above them. */
    --resume-w: 760px;
    padding-block: var(--sp-48) var(--sp-96);
  }

  .resume__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-hello-greet);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* Baseline, not centre. The date is mono at 14px with a tight line box and
     the actions are sans at 15px with 8px of tap padding — centring those
     boxes puts their text on two different lines. */
  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* No row gap: where the links wrap on a phone, their own tap padding is
       already the space between the lines. */
    gap: 0 var(--sp-24);
    margin-top: var(--sp-16);
  }

  /* A chip, the same one the project cards use for their stack: mono caps on
     the surface fill, at the same size and padding. It is the same kind of
     thing — a small fixed fact about the item, not a link — and the page had
     no reason to invent a second treatment for it.

     `margin-left: auto` sends it to the far edge of the row. If the row has to
     wrap, the auto margin still resolves against the free space on the line it
     lands on, so it stays right-aligned there too. */
  .resume__updated {
    margin-left: auto;
    align-self: center;
    padding: 5px var(--sp-8);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  @media (min-width: 640px) {
    .resume__updated {
      font-size: 0.75rem;
    }
  }

  /* On a phone the date always takes a line of its own, under the links and
     on their left edge: it no longer fits beside them, and wrapped to the far
     right it read as a stray tag. The zero-height item ahead of it is the
     line break. */
  @media (max-width: 639px) {
    .resume__actions::after {
      content: '';
      order: 1;
      flex-basis: 100%;
    }

    .resume__updated {
      order: 2;
      margin-left: 0;
      margin-top: var(--sp-4);
    }
  }

  /* Text links. The arrow and the caret inherit the text colour and never move
     on their own. */
  .resume__action {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    padding-block: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .resume__down {
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* The resume is the content of this page, so the frame around each page is
     one hairline on the image and nothing else — no divider above it. The
     gap between pages is the paper's own edge, not a section break. */
  .resume__pages {
    display: grid;
    gap: var(--sp-24);
    margin-top: var(--sp-32);
  }

  .resume__page {
    display: block;
  }

  .resume__page img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-hair) solid var(--rule);
  }

  .resume__pending {
    max-width: var(--measure);
    margin-top: var(--sp-24);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .resume__hint {
    margin-top: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .resume__hint code {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: 0.9em;
  }

  @media (min-width: 1024px) {
    /* One page under the other, each wide enough to read, rather than side
       by side: two pages across the content width set the type too small to
       read without opening the PDF. The row above is capped to the same
       width, so the date chip ends on the page's right edge rather than out
       at the container's — one column, not two. */
    .resume__pages,
    .resume__actions {
      max-width: var(--resume-w);
    }

    .resume__pages {
      gap: var(--sp-32);
    }
  }
</style>
