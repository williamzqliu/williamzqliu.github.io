---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import ExtArrow from '../components/ExtArrow.astro';

// The PDF and its preview are files in public/, not build inputs, so their
// presence is checked at build time rather than assumed. Missing asset =
// visible placeholder, never a dead link (SPEC §7: missing media must not
// block publishing).
const PDF_PATH = '/resume/Zhuoqi_Liu_Resume.pdf';
const PREVIEW_PATH = '/resume/preview.webp';

const publicFile = (file: string) => path.join(process.cwd(), 'public', file.replace(/^\//, ''));
const stat = fs.existsSync(publicFile(PDF_PATH)) ? fs.statSync(publicFile(PDF_PATH)) : null;
const published = stat !== null;
const hasPreview = fs.existsSync(publicFile(PREVIEW_PATH));

const updated = stat
  ? stat.mtime.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;
---

<Base
  title="Resume — Zhuoqi Liu"
  description="Resume for Zhuoqi Liu, designer and developer."
  current="/resume"
>
  <section class="resume">
    <div class="container">
      <h1 class="resume__title">Resume</h1>

      {
        published ? (
          <>
            <p class="resume__actions">
              <a class="resume__action" href={PDF_PATH} target="_blank" rel="noopener">
                Full Screen
                <ExtArrow />
              </a>

              <a class="resume__action" href={PDF_PATH} download>
                Download
                <svg
                  class="resume__down"
                  viewBox="0 0 10 10"
                  width="10"
                  height="10"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M5 1.6v6.8M2 5.4l3 3 3-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>

              {/* Last in the row and pushed to the far edge: the two things you
                  can do with the file come first, and the date is what the row
                  ends on. It is about the file's state, not its format. */}
              <span class="resume__updated">Updated {updated}</span>
            </p>

            {/* A rendered first page, not the browser's PDF viewer: no toolbar,
                no scrollbars, and it keeps the page's own proportions. */}
            {hasPreview && (
              <a
                class="resume__preview"
                data-totop-from
                href={PDF_PATH}
                target="_blank"
                rel="noopener"
                aria-label="Open resume PDF in a new tab"
              >
                <img src={PREVIEW_PATH} alt="First page of the resume" width="1240" height="1755" />
              </a>
            )}
          </>
        ) : (
          <div class="resume__pending">
            <p class="t-body-lg">The PDF is not published yet.</p>
            <p class="resume__hint">
              {/* Instruction for the repo owner, not a claim about the resume. */}
              Drop the export at <code>public{PDF_PATH}</code> and this page picks
              it up on the next build. Until then, nothing here links anywhere
              dead.
            </p>
            <p class="resume__actions">
              <a class="resume__action" href="/about">
                About, with the same background in prose
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .resume {
    /* The width of the page itself once there is room for it, shared by the
       preview and the row of controls above it. */
    --resume-w: 760px;
    padding-block: var(--sp-48) var(--sp-96);
  }

  .resume__title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-hello-greet);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* Baseline, not centre. The date is mono at 14px with a tight line box and
     the actions are sans at 15px with 8px of tap padding — centring those
     boxes puts their text on two different lines. */
  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-24);
    margin-top: var(--sp-24);
  }

  /* A chip, the same one the project cards use for their stack: mono caps on
     the surface fill, at the same size and padding. It is the same kind of
     thing — a small fixed fact about the item, not a link — and the page had
     no reason to invent a second treatment for it.

     `margin-left: auto` sends it to the far edge of the row. If the row has to
     wrap, the auto margin still resolves against the free space on the line it
     lands on, so it stays right-aligned there too. */
  .resume__updated {
    margin-left: auto;
    align-self: center;
    padding: 5px var(--sp-8);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  @media (min-width: 640px) {
    .resume__updated {
      font-size: 0.75rem;
    }
  }

  /* Text links. The arrow and the caret inherit the text colour and never move
     on their own. */
  .resume__action {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    padding-block: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--text);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .resume__down {
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .resume__action:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* The resume is the content of this page, so the frame around it is one
     hairline on the image and nothing else — no divider above it. */
  .resume__preview {
    display: block;
    margin-top: var(--sp-32);
  }

  .resume__preview img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-hair) solid var(--rule);
  }

  .resume__pending {
    max-width: var(--measure);
    margin-top: var(--sp-24);
    padding-top: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .resume__hint {
    margin-top: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .resume__hint code {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: 0.9em;
  }

  @media (min-width: 1024px) {
    /* Wide enough to read the layout, narrow enough that the page does not
       turn into a scroll of one image. The row above it is capped to the same
       width, so the date chip ends on the page's right edge rather than out
       at the container's — one column, not two. */
    .resume__preview img,
    .resume__actions {
      max-width: var(--resume-w);
    }
  }
</style>
