---
import { getCollection, render } from 'astro:content';
import ExtArrow from '../../components/ExtArrow.astro';
import Base from '../../layouts/Base.astro';
import CoverMedia from '../../components/CoverMedia.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectCredits from '../../components/ProjectCredits.astro';
import KeywordTags from '../../components/KeywordTags.astro';
import Lightbox from '../../components/Lightbox.astro';
import { projectLinks, hasCaseStudy, nextStep, isPublic } from '../../lib/projects';
import { COVERS_ENABLED, shippedMedia } from '../../lib/media';

// SPEC §7 — only projects with body content get a case study page.
export async function getStaticPaths() {
  const projects = (await getCollection('projects', isPublic)).filter(
    hasCaseStudy
  );

  // Only the page's own project travels as a prop. What comes next is a
  // curation decision, so it is resolved from the tiers rather than from this
  // array's order — see `nextStep`.
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const next = await nextStep(project);

const links = projectLinks(project);

// The head only carries a caption when it is carrying a picture: under a tone
// plate, a sentence describing the artwork would be describing nothing.
const heroSrc = shippedMedia(project.data.cover.heroWide ?? project.data.cover.wide);
const heroCaption = heroSrc ? project.data.cover.caption : undefined;
const sections = headings.filter((heading) => heading.depth === 2);

// Three fields, the same three on every project: when, what I did, and what
// came of it. Read by name rather than by position, so a project missing one
// simply shows two — and the timeline comes from `dates`, which is already the
// one place that fact lives.
const named = (label: string) =>
  project.data.quickFacts.find((fact) => fact.label === label)?.value;

const facts = [
  { label: 'Timeline', value: project.data.dates },
  { label: 'Role', value: named('Role') },
  { label: 'Outcome', value: named('Outcome') },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<Base
  title={`${project.data.title} — Zhuoqi Liu`}
  description={project.data.blurb}
  current="/work"
>
  <article class="cs">
    <div class="container">
      {/* Identity, then context, then the picture. No back link — the header
          carries Work on every page — and no date above the title: the title
          is the first thing under the header, and the date is one of the facts
          below it rather than a label in front of it. */}
      <header class="cs__head">
        <h1 class="cs__title">{project.data.title}</h1>
        <p class="cs__summary">{project.data.blurb}</p>

        {/* The card's chips, unabridged: the detail page is where the full
            stack belongs. */}
        <div class="cs__stack">
          <KeywordTags items={project.data.stack} />
        </div>

        {
          links.length > 0 && (
            <ul class="cs__links" data-count={links.length}>
              {links.map((link) => (
                <li>
                  <a class="cs__link" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <ExtArrow />
                    <span class="vh">(opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="cs__facts">
        <QuickFacts facts={facts} />
      </div>

      {
        COVERS_ENABLED && (
          <figure class="cs__media" data-nozoom={project.data.cover.zoom ? undefined : 'true'}>
            <CoverMedia
              tone={project.data.cover.tone}
              ratio="hero"
              src={heroSrc}
              mobileSrc={shippedMedia(project.data.cover.heroMobile)}
              alt={project.data.cover.alt}
            />

            {heroCaption && <figcaption class="cs__caption">{heroCaption}</figcaption>}
          </figure>
        )
      }

      <div class="cs__body" data-totop-from>
        {
          /* One list, two presentations: a sticky column on desktop, and a
             collapsed disclosure on narrow screens. `open` is in the markup so
             the list is reachable with no JavaScript; the script closes it
             below the desktop breakpoint. */
          sections.length > 0 && (
            <details class="cs__toc" open>
              <summary class="cs__tocsum">
                <span class="cs__tocsum-label">Section</span>
                <span class="cs__tocsum-now" data-toc-now />
              </summary>

              <nav aria-label="Sections">
                <ol class="cs__toclist">
                  {sections.map((section, i) => (
                    <li>
                      <a class="cs__toclink" href={`#${section.slug}`} data-toclink={section.slug}>
                        <span class="cs__tocnum">{String(i + 1).padStart(2, '0')}</span>
                        <span class="cs__toctext">{section.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }

        {/* `data-reading` is what the header's progress bar measures: reading
            ends with the article, not with the footer. */}
        <div class="prose" data-reading>
          <Content />
        </div>
      </div>

      {/* The epilogue. Outside `.cs__body`, so it is outside the reading
          measure the progress bar tracks and outside the numbered narrative;
          before the hand-off, because it belongs to this project. */}
      <ProjectCredits credits={project.data.credits} />

      <div class="cs__next">
        {
          next.kind === 'project' ? (
            <NextProject
              label={next.label}
              title={next.project.data.title}
              year={next.project.data.year}
              href={`/work/${next.project.id}`}
            />
          ) : (
            /* End of the curated sequence: out to the full list, not back to
               the start and not down into the archive. */
            <NextProject title="Explore all work" href="/work" />
          )
        }
      </div>
    </div>
  </article>

  <Lightbox />
</Base>

<style>
  /* The opening is the project card opened up: the same face at the next size,
     the same description treatment under it, the same metadata register below
     that. Mobile first — 640 and 1024 are the only two steps. */
  .cs__head {
    padding-block: var(--sp-40);
  }

  @media (min-width: 640px) {
    .cs__head {
      padding-block: var(--sp-56) var(--sp-40);
    }
  }

  /* Bricolage, one step above the card title. Title case, and no wider than
     the display measure so a long name breaks where it should. */
  .cs__title {
    max-width: var(--measure-display);
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-casetitle);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* The card's blurb treatment, on a line length that suits a page rather than
     a column. Same family, tone and leading. */
  .cs__summary {
    margin-top: var(--sp-16);
    max-width: 560px;
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  /* One row on a phone, and whatever does not fit is simply not shown. The
     chips are ordered, so the first row is the useful part of the list; a
     second and third row of them would push the facts and the hero off the
     screen to say less than the first row already said. The height is one
     chip — its line box plus its own vertical padding — so nothing is cut
     through the middle and no label is truncated.

     The full list is still in the markup for anyone reading it another way,
     and from 640px up it wraps as before. */
  .cs__stack {
    margin-top: var(--sp-24);
    overflow: hidden;
    max-height: calc(var(--fs-micro) * var(--lh-micro) + 10px);
  }

  @media (min-width: 640px) {
    .cs__stack {
      overflow: visible;
      max-height: none;
    }
  }

  /* 12px, matching the card. The links carry 12px of tap padding of their own,
     so at 8px the chips above them were closer to the links than to anything
     else and the two rows read as one block. */
  .cs__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-24);
    margin-top: var(--sp-12);
  }

  /* Phone: a grid whose column count comes from the number of links, rather
     than whatever the line happens to fit. Four links wrapping 3 + 1 reads as
     a mistake; 2 x 2 reads as a decision. 1-3 stay on one row, 4 splits 2 x 2,
     5 splits 3 + 2 — the last two items land in the first two cells of row two
     on their own, so nothing needs placing by hand.

     `row-gap` is 0 on purpose: the space between rows is the links' own tap
     padding, doubled, and a row-gap would be added to it rather than blended
     into it. So the row spacing is set by that padding — 10px here rather
     than the 12px of the flex row above, which brings the rows from 24px
     apart to 20px and still leaves a 40px target.

     Six or more falls through to the flex row above — no project has that
     many, and inventing a column count for a case that does not exist would
     be guessing. */
  @media (max-width: 639px) {
    .cs__links[data-count='1'],
    .cs__links[data-count='2'],
    .cs__links[data-count='3'],
    .cs__links[data-count='4'],
    .cs__links[data-count='5'] {
      display: grid;
      column-gap: var(--sp-12);
      row-gap: 0;
    }

    /* Two class names, because the rule this narrows sits further down the
       sheet and would otherwise win on source order alone.

       The two gaps in this block are both made of this padding: rows are 2p
       apart and the chips above are m + p away. 7.5 and 16.5 put them at 15
       and 24 — the same 24 the chips take from the summary above them, with
       the rows of one group closer together than the groups are. */
    .cs__links .cs__link {
      padding-block: 7.5px;
    }

    .cs__links {
      margin-top: 16.5px;
    }

    .cs__links[data-count='1'] {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The second column opens on the middle of the screen, not on the middle
       of the list: the first track is half the width less the gutter, so the
       column edge lands exactly on the centre line. */
    .cs__links[data-count='2'],
    .cs__links[data-count='4'] {
      grid-template-columns: calc(50% - var(--sp-12)) minmax(0, 1fr);
    }

    .cs__links[data-count='3'],
    .cs__links[data-count='5'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Same treatment as the project rows: text and arrow change colour together,
     nothing underlines, nothing moves. */
  .cs__link {
    display: inline-flex;
    align-items: center;
    /* 4px, not 6: the arrow is a mark on the word, not a second item
       beside it. */
    gap: 4px;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-2);
    padding-block: var(--sp-12);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* On the content grid rather than full bleed: the hero is the end of the
     introduction, so it lines up with the title that started it. */
  .cs__media {
    margin-bottom: var(--sp-56);
  }

  /* The same caption the about page's portrait uses: one step down in size,
     the quietest of the three text colours, sitting close under the frame it
     belongs to. */
  .cs__caption {
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  .cs__facts {
    margin-bottom: var(--sp-56);
  }

  @media (min-width: 640px) {
    .cs__facts {
      margin-bottom: var(--sp-64);
    }
  }

  /* `minmax(0, 1fr)`, not the implicit `auto`. An auto track takes its width
     from its widest item, and the parked bar's current-section label is one
     unbreakable nowrap line — a long section title pushed the whole column
     past the container and scrolled the phone sideways. The label already
     knows how to truncate; it just needed a column that would not grow for
     it. */
  .cs__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-32);
  }

  /* ---- table of contents ---- */

  /* Sticky at both sizes, for the same reason: the sections stay reachable
     from anywhere in the article. Layering is explicit — header and progress
     line at 50, this bar at 30, the article under both. */
  .cs__toc {
    /* Animated by the same script as the article's disclosures; see the note
       on `.prose details`. */
    overflow-anchor: none;
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: var(--bg);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }

  /* The mobile control. Hidden on desktop, where the list is simply open. */
  .cs__tocsum {
    display: flex;
    align-items: baseline;
    gap: var(--sp-12);
    padding-block: var(--sp-12);
    cursor: pointer;
    list-style: none;
    border-top: var(--rule-hair) solid var(--rule-strong);
    border-bottom: var(--rule-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    transition:
      color var(--dur-hover-out) var(--ease-out),
      border-top-color var(--dur-hover-out) var(--ease-out);
  }

  .cs__tocsum::-webkit-details-marker {
    display: none;
  }

  /* ---- the parked bar (phones) ----
     
     Three things make this seam-proof, and none of them is a line:
     
     1. The bar starts 2px *inside* the header rather than flush against its
        bottom edge. The header is 50 and paints over those two pixels, and
        both surfaces are --bg, so the overlap cannot be seen — where a gap of
        half a pixel, which is what a fractional header height leaves on a
        real device, shows a stripe of moving article text.
     2. The background bleeds to both screen edges. The case study's cover
        plate above it is full-bleed, so a bar the width of the text column
        would let the plate slide past through the page gutters.
     The rules move to the wrapper here so they span the surface rather than
     stopping short of it at both ends.
     
     There is no third trick under the bottom rule. Two pixels of background
     were masking a seam there, but nothing scrolls between the border and the
     box — the mask only put a 2px band of page colour between the rule and the
     first line of text, which reads as a light edge hanging off the bar. */
  @media (max-width: 639px) {
    .cs__toc {
      top: calc(var(--header-h) - 2px);
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
      border-top: var(--rule-hair) solid var(--rule-strong);
      border-bottom: var(--rule-hair) solid var(--rule);
      transition: border-top-color var(--dur-hover-out) var(--ease-out);
    }

    .cs__tocsum {
      border-top: 0;
      border-bottom: 0;
    }

    /* The list is a panel here, not a column, so it needs a floor: without
       this the last title sits on the bar's bottom rule. */
    .cs__toclist {
      padding-bottom: var(--sp-16);
    }

    /* Parked, the top rule has nothing above it left to divide, and the orange
       progress line is already sitting there. Transparent rather than removed,
       so nothing moves by a pixel. */
    .cs__toc[data-stuck] {
      border-top-color: transparent;
    }
  }

  /* Which section you are in, for the case where the list is closed. */
  .cs__tocsum-now {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: right;
    color: var(--accent);
  }

  /* The name changes while the bar is parked at the top of the screen, so it
     crossfades instead of being replaced between two frames. The script drives
     the attribute; the swap happens while it is out. */
  .cs__tocsum-now {
    transition: opacity 140ms var(--ease-out);
  }

  .cs__tocsum-now[data-swapping] {
    opacity: 0;
  }

  .cs__toc[open] .cs__tocsum-now {
    opacity: 0;
  }

  .cs__toclist {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-top: var(--sp-12);
  }

  /* Two columns, fixed on the left: every title starts at the same x whatever
     the number is, and the two sit on one baseline instead of on two. */
  .cs__toclink {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--sp-12);
    color: var(--text-2);
    padding-block: var(--sp-4);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  .cs__tocnum {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: var(--fs-micro);
    /* Matches the title's line box, so baseline alignment holds at any size. */
    line-height: var(--lh-small);
    letter-spacing: -0.02em;
    color: var(--text-3);
    transition: color var(--dur-hover-out) var(--ease-out);
    text-transform: uppercase;
  }

  /* The section being read. One at a time, set by the script from the scroll
     position — the same source the progress bar reads. */
  .cs__toclink[aria-current] {
    color: var(--accent);
  }

  .cs__toclink[aria-current] .cs__tocnum {
    color: var(--accent);
  }

  .cs__next {
    margin-top: var(--sp-96);
  }

  @media (hover: hover) and (pointer: fine) {
    .cs__toclink:hover {
      color: var(--text);
      transition-duration: var(--dur-hover-in);
    }

    .cs__toclink[aria-current]:hover {
      color: var(--accent);
    }

    .cs__tocsum:hover,
    .cs__link:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (min-width: 1024px) {
    .cs__body {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--sp-64);
      align-items: start;
    }

    /* Clears the sticky header, or the first item sits underneath it. The
       max-height keeps a long list scrollable inside its own column instead of
       pushing the page. */
    .cs__toc {
      top: calc(var(--header-h) + var(--sp-32));
      background: none;
      max-height: calc(100svh - var(--header-h) - var(--sp-64));
      overflow-y: auto;
      /* No `overscroll-behavior: contain`. With six sections this column never
         overflows, so containment had nothing to contain — it only stopped the
         wheel from reaching the page, and the article froze whenever the
         pointer came to rest over the list. */
      scrollbar-width: none;
    }

    .cs__toc::-webkit-scrollbar {
      display: none;
    }

    .cs__tocsum {
      display: none;
    }

    .cs__toclist {
      border-top: var(--rule-hair) solid var(--rule);
      padding-top: var(--sp-16);
      gap: var(--sp-8);
    }
  }
</style>

<style is:global>
  /* Numbered headings come from a counter, so the markdown stays plain. */
  .prose {
    counter-reset: section;
    /* The measure lives on the text children, so a figure or a table can be
       wider than the paragraphs without breaking the column. */
    max-width: none;
  }

  /* The measure is the default, not an opt-in. 62ch of 17px body copy is about
     65 characters a line, and anything drawn rather than photographed — a
     formula, an encoding key, a small diagram — belongs on the same left and
     right edges as the sentences that introduce it. Whatever needs the whole
     column says so below. */
  .prose > * {
    max-width: var(--measure);
  }

  /* Primary media: screenshots, video, comparisons, data. These are the
     evidence, not an aside, and they take the whole article column. */
  .prose > figure,
  .prose > table {
    max-width: 100%;
  }

  /* Back to the measure, per figure. Some pictures belong with the sentences
     rather than with the evidence — a photograph of a session, a small
     explanatory shot — and at full column width they read as a claim the
     picture is not making. `--measure` is in `ch`, so the figure has to carry
     the copy size for it to resolve to the paragraphs' width. */
  .prose > figure[data-width='prose'] {
    max-width: var(--measure);
    font-size: var(--fs-copy);
  }

  /* A new section is recognisable from the space above it alone: five times
     the gap between paragraphs. */
  .prose h2 {
    counter-increment: section;
    margin-top: var(--sp-80);
    padding-top: var(--sp-16);
    /* Clears the sticky header when the heading is scrolled to by anchor. On a
       phone the collapsed section bar is parked under the header too, so the
       heading has to clear both. */
    scroll-margin-top: calc(var(--header-h) + 41px + var(--sp-24));
    /* Off full strength. At --rule-strong these lines are the darkest thing in
       the article and repeat every section, so scrolling reads as a stack of
       bars with text between them; the space above the heading is what marks a
       new section, and the rule only has to confirm it. */
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--rule-strong) 60%, var(--bg));
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-lead);
    line-height: 1.15;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* No parked section bar in the desktop column: the heading only has to clear
     the header. */
  @media (min-width: 1024px) {
    .prose h2 {
      scroll-margin-top: calc(var(--header-h) + var(--sp-32));
    }
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  /* The rule over a heading separates it from the section before it, and the
     first heading has none — on a phone the section bar sits directly above,
     closing with a rule of its own, so this one only drew a second line 20px
     under the first. The desktop column keeps it: there the bar is off to the
     side and this rule starts the article. */
  @media (max-width: 639px) {
    .prose h2:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }

  .prose h2::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: var(--sp-8);
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    font-size: var(--fs-micro);
    letter-spacing: -0.02em;
    color: var(--text-3);
    text-transform: uppercase;
  }

  .prose p {
    margin-top: var(--sp-16);
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    /* Full contrast. Long-form copy in --text-2 was the thinnest text on the
       site and the hardest to read. */
    color: var(--text);
  }

  /* Paragraph and list sizes come from --fs-copy, which steps down on a
     phone on its own. The headings still need the size back here to stay
     ahead of the copy. */
  @media (max-width: 639px) {
    .prose h2 {
      font-size: 1.75rem;
    }
  }

  /* A blockquote in this article is never a quotation. It is the question a
     section turns on, and it is set off by a label, a rule and air rather than
     by size — a sentence three points bigger than the body is not a callout,
     it is oversized body copy.

     Two paragraphs by convention: the first is the label, the last is the
     statement. A one-paragraph blockquote is all statement and still reads
     correctly.

     `:not(.participant-quote)` on all four rules: a verbatim participant
     sentence is also a blockquote, and it is a different editorial object.
     Excluding it here keeps the two apart without either one having to win a
     specificity race against the other. */
  .prose blockquote:not(.participant-quote) {
    margin-block: var(--sp-40);
    max-width: 720px;
    padding-left: var(--sp-20);
    border-left: var(--rule-heavy) solid var(--accent);
  }

  /* The register the metadata labels use — Role, Timeline, Next project. */
  .prose blockquote:not(.participant-quote) p:first-child:not(:only-child) {
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* `**Challenge**` is how the label is written in the content file; mono caps
     already carry the emphasis, so the bold does not also apply. */
  .prose blockquote:not(.participant-quote) p:first-child strong {
    font-weight: inherit;
    color: inherit;
  }

  /* The statement is the second paragraph, or the only one. Written as
     `:last-child` this was the same thing until a callout needed a line under
     its statement, at which point the last paragraph was the quiet one. */
  .prose blockquote:not(.participant-quote) p:only-child,
  .prose blockquote:not(.participant-quote) p:nth-child(2) {
    margin-top: var(--sp-12);
    font-size: var(--fs-title);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* A third paragraph carries what the statement leaves out, at copy size in
     the supporting tone: the statement is the finding, this is the detail
     behind it. */
  .prose blockquote:not(.participant-quote) p:nth-child(3) {
    margin-top: var(--sp-8);
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  /* The closing callout of a case study. Its label takes the accent instead of
     the quiet grey every other label uses — the one exception, and it earns it
     by being the last line on the page: the colour is what says this is the
     end rather than another note along the way. One per case study. */
  .prose blockquote[data-close]:not(.participant-quote) p:first-child:not(:only-child) {
    color: var(--accent);
  }

  /* Editorial emphasis, not highlighting: a weight step and nothing else. No
     colour change, no rule, no fill — inside a paragraph those all read as UI.
     The phrases themselves come from the content files. */
  .prose strong {
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  /* A point down. The italic here is always a product name sitting inside a
     roman sentence, and at the same size the slant made it look larger than
     the words around it. Relative, so it holds in a caption as well as in a
     paragraph. */
  .prose em {
    font-style: italic;
    font-size: 0.945em;
  }

  /* Inline technical values, in the site's mono rather than the browser's.
     The face alone was not enough to separate them: mono at 0.88em in
     --text-2 is smaller and paler than the sentence around it, so a field
     name read as an aside rather than as a literal. It now takes the same
     surface fill the stack chips use, at full ink — the one fill on the site
     that means "this is a token, not prose".

     `box-decoration-break` so a value that wraps keeps one continuous fill
     instead of two half-boxes. No radius: nothing here has one. */
  .prose code {
    font-family: var(--font-mono);
    font-weight: var(--fw-mono);
    /* A point under the 0.9em it used to take. Mono sets wider than the body
       face at the same size, so matching them optically means going below. */
    font-size: 0.84em;
    /* Colour instead of a fill: a value in a sentence stops looking like a
       pill. Its own token, because the two themes want two different hues
       rather than two lightnesses of one. */
    color: var(--code-ink);
  }

  .prose ul,
  .prose ol {
    margin-top: var(--sp-16);
  }

  /* Real source from the project, set the way this page sets everything else:
     mono, one ink, no fill and no colour. Syntax highlighting is off site-wide
     (see astro.config.mjs) because a themed rectangle would be the only
     coloured surface on a page made of rules and space.

     Hairlines above and below, like every other block that interrupts the
     prose, and the scroll is contained so a long line moves the block rather
     than the page. Twelve, because these are read line by line rather than
     scanned, and mono sets wide. */
  .prose pre {
    margin-top: var(--sp-24);
    padding-block: var(--sp-20);
    border-top: var(--rule-hair) solid var(--rule);
    border-bottom: var(--rule-hair) solid var(--rule);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .prose pre code {
    display: block;
    /* Not the 0.84em an inline literal takes: that is sized to sit inside a
       sentence, and a block has no sentence to match. */
    font-size: calc(var(--fs-small) - 1px);
    line-height: 1.75;
    font-weight: var(--fw-mono);
    /* The supporting tone rather than `--code-ink`. A word in a sentence
       wants the hue to mark it as a literal; twenty lines of it would be a
       wash. */
    color: var(--text-2);
    white-space: pre;
  }

  /* One line about the excerpt above, in the caption register a figure uses:
     what the code means for the reader, not what it does line by line. */
  .prose .code-note {
    margin-top: var(--sp-12);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  .prose .code-note + p,
  .prose pre + p {
    margin-top: var(--sp-32);
  }

  .prose li {
    position: relative;
    padding-left: var(--sp-20);
    margin-top: var(--sp-8);
    font-size: var(--fs-copy);
    line-height: var(--lh-body-lg);
    color: var(--text);
  }

  /* A hairline rather than a bullet, to match the rules the page already
     uses. */
  .prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 8px;
    height: var(--rule-hair);
    background: var(--rule-strong);
  }

  /* Figures are part of the article: same left edge, square corners, no panel,
     no shadow. */
  .prose figure {
    margin-top: var(--sp-32);
  }

  .prose figure img,
  .prose figure video,
  .prose img,
  .prose video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Ink on a transparent ground gets the ground it was drawn on, dark theme
     included — see `--paper` in tokens.css. Opt-in per image: an export with
     its own background does not need one. */
  .prose img[data-ground='paper'] {
    background: var(--paper);
  }

  /* As wide as the thing it belongs to, not as wide as a line of prose. A
     caption capped at the meta measure broke mid-sentence under a full-width
     picture, which reads as a mistake rather than as a measure. */
  .prose figcaption {
    margin-top: var(--sp-12);
    max-width: 100%;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  .prose figure + p {
    margin-top: var(--sp-32);
  }

  /* A disclosure closes on a hairline, and at the paragraph's own 16 the
     sentence after it sat under that rule as though it were still inside.
     The same 32 every other block hands to the paragraph following it. */
  .prose details + p {
    margin-top: var(--sp-32);
  }

  /* Two pictures of one thing, side by side from 640px up and stacked below
     it. No shared frame and no crop: a square and a 16:9 in equal columns
     come to different heights, and levelling them would mean letterboxing one
     or cutting the other. `align-items: start` puts their tops on one line,
     which is the edge the comparison is read from. */
  .media-pair {
    display: grid;
    gap: var(--sp-24);
  }

  .media-pair > figure {
    margin-top: 0;
  }

  /* Opt-in: a pair that has to be read as a pair. Two states of one panel mean
     nothing apart — stacked, the second is a screen away from the first, and
     the reader is comparing a picture with a memory. Narrower on a phone is
     the lesser cost.

     `--pair-split` applies here too, so a row of three frames of one moment
     holds its shape and its single height at every width instead of coming
     apart into three pictures on a phone. Without the variable this is the
     equal-column pair it has always been. */
  .media-pair[data-abreast] {
    grid-template-columns: var(--pair-split, repeat(2, minmax(0, 1fr)));
    align-items: start;
    gap: var(--sp-12);
  }

  @media (min-width: 640px) {
    /* Equal columns unless the instance says otherwise. `--pair-split` is for
       two pictures of different shapes that should come out the same height:
       give the columns the ratio of the pictures' own aspects and nothing has
       to be cropped to line their bottoms up. Same mechanism as the mosaic's
       `--mosaic-split`, passed from the content file. */
    .media-pair {
      grid-template-columns: var(--pair-split, repeat(2, minmax(0, 1fr)));
      align-items: start;
    }

    .media-pair[data-abreast] {
      gap: var(--sp-24);
    }
  }

  /* The wrapper carries the space a figure would have carried on its own. */
  .prose .media-pair {
    margin-top: var(--sp-32);
    max-width: 100%;
  }

  .prose .media-pair + p {
    margin-top: var(--sp-32);
  }

  /* A row inside one figure, under one caption: three frames of a single
     moment are one picture as far as the reader is concerned. The figure
     already carries the space above, so the row starts flush with it.

     Same for a pair nested inside a pair, which is how a column of captioned
     frames sits beside a single one. `.prose .media-pair` is a descendant
     selector, so without this the inner row took the block margin again and
     started 32px below the column next to it. */
  .prose figure > .media-pair,
  .prose .media-pair > .media-pair {
    margin-top: 0;
  }

  /* A nested column that becomes a row on a phone. Three frames stacked under
     a full-width one run the block off the bottom of the screen, and the
     reader scrolls past a caption that is still claiming them as one group.
     Side by side under the big frame they stay that group, and the block keeps
     the shape it has on a desktop.

     Opt-in, because the two-frame nest in the same article wants the opposite:
     two frames stacked are still readable on a phone, and each of them carries
     its own caption. `grid-auto-flow` rather than a column count, so the rule
     does not care how many frames are in the nest.

     Matched on the attribute alone: a nested pair sits inside a figure in one
     arrangement and directly inside the outer pair in the other, and the
     opt-in is what carries the intent either way. */
  @media (max-width: 639px) {
    .prose .media-pair[data-phone-row] {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--sp-12);
    }
  }

  /* A caption sits under the left edge of its picture, which is right until
     the picture has no left edge. The network plate is a circle on a
     transparent ground, so the only edge it really has is its centre — this
     centres the line under it. Opt-in per figure, because it is wrong for
     anything that fills its box. */
  .prose figure[data-caption='center'] figcaption {
    max-width: none;
    text-align: center;
  }

  /* Several pictures of one moment, tiled into a rectangle instead of a row,
     and the tile turns with the viewport.

     Phone: the same idea one turn rotated. The wide one takes the full width
     and the other two share the row under it, so the block is still a
     rectangle and the reading order is left to right — which is also the
     order the lightbox steps through.

     The two on the bottom row get columns in the ratio of their own aspects
     (`--mosaic-stack` from the content file, the same way `--mosaic-split`
     works above), so their bottoms land on one line with nothing cropped.
     16px between tiles rather than 24: the tiles are a third the size. */
  .media-mosaic {
    display: grid;
    grid-template-columns: var(--mosaic-stack, 1fr 1fr);
    gap: var(--sp-16);
  }

  .media-mosaic > figure {
    margin-top: 0;
  }

  .media-mosaic > :nth-child(1) {
    grid-column: 1 / -1;
  }

  .media-mosaic > :nth-child(3) {
    grid-column: 1;
    grid-row: 2;
  }

  .media-mosaic > :nth-child(2) {
    grid-column: 2;
    grid-row: 2;
  }

  @media (min-width: 640px) {
    .media-mosaic {
      grid-template-columns: var(--mosaic-split, 1fr 1fr);
      gap: var(--sp-24);
      align-items: start;
    }

    /* Back to document order in a two-column frame. */
    .media-mosaic > :nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }

    /* The tall one. It stretches to whatever the left column comes to and its
       picture fills that box, which is what squares the block off at every
       width — the alternative is arithmetic that only lands at one viewport,
       because a caption's height does not scale with its column. The cost is
       a few per cent off the sides of a centred image, taken from margin. */
    .media-mosaic > :nth-child(2) {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }

    .media-mosaic > :nth-child(2) img {
      flex: 1;
      min-height: 0;
      object-fit: cover;
    }

    .media-mosaic > :nth-child(3) {
      grid-column: 1;
      grid-row: 2;
    }
  }

  /* The wrapper carries the space a figure would have carried on its own. */
  .prose > .media-mosaic {
    margin-top: var(--sp-32);
    max-width: 100%;
  }

  /* Only a paragraph. A callout keeps its own margin on both sides — it is
     the one block here whose spacing has to read as symmetrical, and taking
     the top from the figure above it made the gap under it look twice as
     large. */
  .prose > .media-mosaic + p {
    margin-top: var(--sp-32);
  }

  /* A drawn metric, set the way the rest of the page's metadata is set: a mono
     label, the arithmetic in body type, and a hairline. No panel, no fill, no
     rounded box — the case study has no other boxes and this is not the place
     to start. The words are the tool's own; the geometry of the rings below is
     lifted from what the Collaboration Map actually draws. */
  /* No rule of its own: this sits inside a disclosure that is already drawn
     with two, and a third line above the arithmetic read as a stray. */
  .formula {
    margin-top: var(--sp-24);
  }

  /* The body face, in the caption's size and colour — this labels the key the
     way a figcaption labels a picture. Two class names because `.prose p` sets
     the copy size and would otherwise win. */
  .tier-key .tier-key__title {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    /* One step up from body copy. At caption size in the quietest ink, regular
       weight reads as an afterthought rather than as the name of the key. */
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* Wraps to the next line on a phone rather than scrolling sideways: the
     three terms are words, not symbols, and a ratio that has to be scrolled
     is not a ratio anyone reads. */
  .formula__eq {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-12);
    font-size: var(--fs-copy);
    line-height: var(--lh-body);
    color: var(--text);
  }

  /* Two stacked spans and a rule. A two-term ratio needs nothing else, and
     nothing else keeps the line height of the paragraph around it. */
  .formula__frac {
    display: inline-flex;
    flex-direction: column;
    text-align: center;
  }

  .formula__frac span:last-child {
    margin-top: 3px;
    padding-top: 3px;
    border-top: var(--rule-hair) solid var(--rule-strong);
  }

  /* The operator travels with the term it applies to, so a wrap never leaves a
     multiplication sign hanging at the end of a line. */
  .formula__term {
    white-space: nowrap;
  }

  /* The name of the metric, not a term of the sum. It carries a word space on
     one side and an operator on the other, which is not the same distance —
     2px puts the equals sign where the eye expects it. The 1px lift is optical:
     the row is centred on the fraction, whose weight sits at its rule, and a
     line of text centred against that reads a hair low. */
  .formula__eq > .formula__term:first-child {
    translate: 0 -1px;
    /* One step up from the terms it introduces: this is the name of the thing,
       and the arithmetic after it is the definition. */
    font-weight: var(--fw-medium);
  }

  .formula__eq > .formula__term:first-child .formula__op {
    margin-left: 2px;
  }

  .formula__op {
    color: var(--text-3);
  }

  .formula__parts {
    display: grid;
    gap: var(--sp-8);
    margin-top: var(--sp-16);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-2);
  }

  .formula__parts b {
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  @media (min-width: 640px) {
    .formula__parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-24);
    }
  }

  /* The key to the ring, at the size and opacity the map draws it. Four steps,
     quietest first, so the row reads as one scale rather than four states. */
  /* `--measure` is in `ch`, which resolves against this element's own font
     size, not the paragraphs'. Without the body size here the key came out
     124px narrower than the prose it sits under. */
  .tier-key {
    margin-top: var(--sp-32);
    padding-top: var(--sp-16);
    border-top: var(--rule-hair) solid var(--rule);
    font-size: var(--fs-copy);
  }

  .tier-key__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-16) var(--sp-12);
    margin-top: var(--sp-12);
  }

  @media (min-width: 640px) {
    .tier-key__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-24);
    }
  }

  .tier-key__item {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
  }

  .tier-key__item svg {
    flex: none;
  }

  .tier-key__item span {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    letter-spacing: 0.04em;
    color: var(--text-2);
    text-transform: uppercase;
  }

  /* Two numbers the section is built on, framed the way this page frames a
     section: a hairline above and below, air inside them, and nothing else.
     Not a card and not a dashboard — no fill, no corners, no shadow, no icon.
     Prose width, because it is drawn rather than photographed, and it carries
     the copy size because `--measure` is in `ch`. */
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Two is the default because two numbers is what a section usually turns
       on. Three needs saying, per instance. */
    column-gap: var(--sp-32);
    row-gap: var(--sp-24);
    /* The rules already open and close the block, and it carries 24 of its own
       air inside them. Another 40 outside pushed it away from the sentence it
       belongs to. */
    margin-top: var(--sp-24);
    padding-block: var(--sp-24);
    border-top: var(--rule-hair) solid var(--rule);
    border-bottom: var(--rule-hair) solid var(--rule);
    font-size: var(--fs-copy);
  }

  .prose .stat-strip + p {
    margin-top: var(--sp-24);
  }

  .prose .process-steps + p {
    margin-top: var(--sp-40);
  }

  .stat-strip__cell {
    position: relative;
  }

  /* Between the two, not around them: lighter than the rules that close the
     block and held clear of them at both ends, so the strip reads as one
     thing divided rather than as two boxes. */
  .stat-strip__cell + .stat-strip__cell::before {
    content: '';
    position: absolute;
    left: calc(var(--sp-16) * -1);
    top: var(--sp-8);
    bottom: var(--sp-8);
    border-left: var(--rule-hair) solid color-mix(in srgb, var(--rule) 55%, var(--bg));
  }

  /* The number is the thing being read. Mono because it is a data value —
     the same reason the resume sets its figures in mono — and one size up
     from body copy so it anchors the block. */
  .stat-strip .stat-strip__value {
    margin-top: 0;
    font-family: var(--font-mono);
    /* Two under the display size. Mono runs wide, and at the full 28 a row of
       percentages sat a step louder than the section it belongs to. */
    font-size: calc(var(--fs-display) - 2px);
    line-height: 1.1;
    font-weight: var(--fw-strong);
    /* None. Mono already sets its own even width, and any negative tracking
       closes the gap between the digits and the decimal point. */
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-transform: uppercase;
  }

  /* A pixel over the caption size: these two lines are read, not glanced at,
     and at 13 they sat a step too far below the number. */
  .stat-strip .stat-strip__label {
    margin-top: var(--sp-8);
    font-size: calc(var(--fs-small) + 1px);
    line-height: var(--lh-small);
    font-weight: var(--fw-medium);
    color: var(--text-2);
  }

  /* The count the percentage came from. Quietest of the three lines: it is
     there to be checked, not read. */
  .stat-strip .stat-strip__note {
    margin-top: var(--sp-4);
    font-size: calc(var(--fs-small) + 1px);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  /* Where the figures came from, set as a caption because that is what it is:
     the same size, tone and leading `.prose figcaption` uses under a picture.
     Tight to the block above it so it reads as that block's attribution, and
     the paragraph after it keeps the section's own spacing. */
  .prose .stat-strip + .stat-strip__source {
    margin-top: var(--sp-12);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--text-3);
  }

  .prose .stat-strip__source + p {
    margin-top: var(--sp-32);
  }

  /* Four values, two by two, with the dividers closed into a cross. The strip
     proper is one row of figures and needs only the line between them; once it
     wraps, a column divider on its own leaves the second row floating under
     the first. Gaps go to zero and the space moves inside the cells, so the
     two rules meet exactly at the centre and the block reads as one divided
     field rather than four boxes.

     Column one keeps no left padding, so its figures stay on the same left
     edge as the prose. */
  .stat-strip[data-grid] {
    column-gap: 0;
    row-gap: 0;
  }

  .stat-strip[data-grid] .stat-strip__cell {
    padding: 0 var(--sp-24) var(--sp-20) 0;
  }

  .stat-strip[data-grid] .stat-strip__cell + .stat-strip__cell::before {
    content: none;
  }

  .stat-strip[data-grid] .stat-strip__cell:nth-child(even) {
    padding-right: 0;
    padding-left: var(--sp-24);
    border-left: var(--rule-hair) solid color-mix(in srgb, var(--rule) 55%, var(--bg));
  }

  .stat-strip[data-grid] .stat-strip__cell:nth-child(n + 3) {
    padding-bottom: 0;
    padding-top: var(--sp-20);
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--rule) 55%, var(--bg));
  }

  /* Three across only where the cells can hold a 28px figure: below 640 the
     phone rule takes over and wraps them instead. Outside the query this
     would outrank that rule and leave three numbers touching. */
  @media (min-width: 640px) {
    .stat-strip[data-cols='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Phone: the two figures stay side by side while both cells can still hold
     their longest line — `Recorded internal tie`, 136px — and drop under each
     other when they cannot. `auto-fit` is what decides, so the strip reflows
     on its own rather than on a width someone guessed: at 375 it is two
     columns, at 320 it is one. The divider goes either way; between two
     narrow cells the line crowds them, and stacked there is nothing for it to
     divide. */
  @media (max-width: 639px) {
    .stat-strip {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }

    .stat-strip__cell + .stat-strip__cell::before {
      content: none;
    }
  }

  /* The stages of a method, in order. An ordered list because the order is
     the content: the numbers are drawn so the columns can be read across, and
     the element carries the same sequence for anything that is not looking.

     Not the stat strip, which this resembles: there the number is the thing
     being read and takes the display size. Here the number is only a position
     and the verb is what the reader is after, so the hierarchy is inverted —
     name in full ink at copy size, description under it, number smallest and
     quietest of the three.

     Prose width, not the article column, and a single hairline above rather
     than rules on both sides: this block introduces the figure below it and
     should not compete with it. Generic to case studies; nothing about it is
     specific to one project. */
  .prose .process-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--sp-24);
    margin-top: var(--sp-32);
    padding-top: var(--sp-20);
    border-top: var(--rule-hair) solid var(--rule);
    list-style: none;
    font-size: var(--fs-copy);
  }

  /* The article's list marker and indent are for items that are sentences in
     a run. These are columns. */
  .prose .process-steps li {
    position: relative;
    margin-top: 0;
    padding-left: 0;
  }

  /* The dash is drawn with a width, a height and a background, so dropping
     `content` alone is not enough: the divider below reuses this pseudo
     element, and it inherited an 8px bar that showed up over every number. */
  /* A cell whose first line is the name rather than a number starts flush
     with the rule, like the numbered ones do. */
  .prose .process-steps li > :first-child {
    margin-top: 0;
  }

  .prose .process-steps li::before {
    content: none;
    width: auto;
    height: auto;
    background: none;
  }

  /* Two class names: `.prose p` sets the copy size and colour and would
     otherwise win on element count.

     A small margin rather than none: this line leads a stage but follows a
     name when the cell is a person rather than a step, and the rule below
     zeroes it in the first case. */
  .prose .process-steps__num {
    margin-top: calc(var(--sp-8) - 1px);
    font-family: var(--font-mono);
    /* A pixel over the mono micro size. It carries a stage number in one
       block and a person's age in another, and at 11 the age read as a
       footnote to the name rather than as part of it. */
    font-size: calc(var(--fs-micro) + 1px);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    text-transform: uppercase;
  }

  /* The word the reader is scanning for. A weight step and full ink, no size
     jump: at the copy size it already leads the two lines under it. */
  .prose .process-steps__name {
    margin-top: var(--sp-8);
    font-size: var(--fs-copy);
    line-height: var(--lh-small);
    font-weight: var(--fw-strong);
    color: var(--text);
  }

  /* Eight under the quiet line against seven above it, so the description
     reads as the next thing rather than as more of the name. Only where it
     follows that line: where the note follows a name directly, as it does
     under a stage, the four below still applies. */
  .prose .process-steps__num + .process-steps__note {
    margin-top: var(--sp-8);
  }

  .prose .process-steps__note {
    margin-top: var(--sp-4);
    /* Two over the caption size. These are three sentences a reader is meant
       to read, not labels to glance at, and they sit under a 17px name. */
    font-size: calc(var(--fs-small) + 2px);
    line-height: var(--lh-small);
    color: var(--text-2);
  }

  /* Stacked, for items that read in sequence rather than in parallel. The
     columns are for a set the eye compares; a retrospective is a list you go
     down, and three reflections side by side ask to be weighed against each
     other instead of read in order. Rows are separated by the hairline the
     issue list uses rather than by space, so the block stays compact, and the
     specificity carries over the 640px rules below without needing a query of
     its own. */
  .prose .process-steps[data-stack] {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0;
  }

  .prose .process-steps[data-stack] li {
    padding-bottom: var(--sp-20);
  }

  .prose .process-steps[data-stack] li + li {
    padding-top: var(--sp-20);
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--rule) 55%, var(--bg));
  }

  .prose .process-steps[data-stack] li:last-child {
    padding-bottom: 0;
  }

  .prose .process-steps[data-stack] li + li::before {
    content: none;
  }

  /* Three across from 640, with the same inset hairline the stat strip puts
     between its cells: lighter than the rule that opens the block and held
     clear of it, so the row reads as one thing divided rather than as three
     boxes. */
  @media (min-width: 640px) {
    /* `.prose` on this too: the base rule above needs it to outrank
       `.prose ul, .prose ol`, and without it here the single column wins on
       specificity and the row never forms. */
    .prose .process-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--sp-32);
    }

    /* Two where the block divides a responsibility rather than stepping
       through stages: three columns holding two items leaves a third of the
       row empty, and the gap reads as a missing item. Same name the stat
       strip uses for the same job. */
    .prose .process-steps[data-cols='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .prose .process-steps li + li::before {
      content: '';
      position: absolute;
      left: calc(var(--sp-16) * -1);
      top: 0;
      bottom: var(--sp-4);
      border-left: var(--rule-hair) solid color-mix(in srgb, var(--rule) 55%, var(--bg));
    }
  }

  /* An exact sentence from a study participant. A vertical rule rather than a
     horizontal one: the stat strip and the section rules already cut across
     this column, and a third full-width line would keep slicing the page
     instead of marking a voice. Same rule weight as the callout, in the same
     colour: the two never appear in the same section, and what tells them
     apart is the shorter measure and the source underneath. Verbatim
     participant speech only — not conclusions, not summaries.

     `--measure` is in `ch` and resolves against this element's own font size,
     so the block stays at copy size and the sentence inside it steps up. */
  .prose .participant-quote {
    max-width: calc(var(--measure) * 0.85);
    margin-block: var(--sp-32);
    padding-left: var(--sp-20);
    border-left: var(--rule-heavy) solid var(--accent);
    font-size: var(--fs-copy);
  }

  /* One size up from the body, tight enough that two lines read as one
     utterance. Medium, not bold: this is someone talking, not a headline. */
  .prose .participant-quote p {
    margin-top: 0;
    font-size: var(--fs-title);
    line-height: 1.4;
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  /* The label register the rest of the page uses for metadata, under the
     sentence rather than over it: the words come first, the attribution only
     qualifies them. A pixel over the mono micro size — under a 20px sentence
     the 11px label sat too far back to be read as part of the same block. */
  .prose .participant-quote cite {
    display: block;
    margin-top: var(--sp-12);
    font-family: var(--font-mono);
    font-size: calc(var(--fs-micro) + 1px);
    font-style: normal;
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* A finding from testing and the change it points to. A definition list
     because that is what the pair is: the term is the problem, the description
     is the response. Two columns from 640px so a pair reads across in one
     line. Hairlines between the rows and nothing else — a fill, an icon or an
     arrow glyph would turn three sentences into a dashboard. */
  .issue-response {
    max-width: var(--measure);
    margin-top: var(--sp-32);
    font-size: var(--fs-copy);
    border-top: var(--rule-hair) solid var(--rule);
  }

  .prose .issue-response + p {
    margin-top: var(--sp-32);
  }

  .issue-response > div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    column-gap: var(--sp-24);
    padding-block: var(--sp-16);
  }

  .issue-response > div + div {
    border-top: var(--rule-hair) solid var(--rule);
  }

  .issue-response dt {
    line-height: var(--lh-body-lg);
    font-weight: var(--fw-medium);
    color: var(--text);
  }

  .issue-response dd {
    margin: 0;
    line-height: var(--lh-body-lg);
    color: var(--text-2);
  }

  /* Phone: the response under its issue, close enough that the two still read
     as one row rather than as six lines. */
  @media (max-width: 639px) {
    .issue-response > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-4);
    }
  }

  /* Data keeps the metadata treatment: mono heads, hairline rows, no fills. */
  .prose table {
    width: 100%;
    margin-top: var(--sp-24);
    border-collapse: collapse;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .prose th {
    text-align: left;
    padding: var(--sp-8) var(--sp-16) var(--sp-8) 0;
    border-bottom: var(--rule-hair) solid var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .prose td {
    padding: var(--sp-8) var(--sp-16) var(--sp-8) 0;
    border-bottom: var(--rule-hair) solid var(--rule);
    vertical-align: baseline;
    /* Most of the way to the body ink. The head is the quiet part of a table;
       the cells are the reading, and at the secondary tone a column of figures
       sat fainter than the sentence that introduced it. */
    color: color-mix(in srgb, var(--text) 55%, var(--text-2));
  }

  /* A ranked shortlist, on the table. Six rows that each carry a name and one
     figure are a table by the rule this system already follows, so this is a
     modifier rather than a pattern: what it adds is the reading order.

     The two number columns are fixed and centred in their own width, so the
     positions and the figures each stack into a column the eye can run down
     without either one being pushed against an edge, and the name takes
     whatever is left.

     `--measure` is in `ch` and resolves against the element's own font size.
     The table sets the body size for its cells, so the max-width is stated at
     the copy size here and handed back to the cells below; otherwise the block
     runs to the article column while the paragraphs around it stop at the
     prose measure. */
  .prose table[data-ranked] {
    max-width: var(--measure);
    font-size: var(--fs-copy);
  }

  .prose table[data-ranked] td {
    font-size: var(--fs-body);
    /* Full ink. Mono at 15 on a cream ground already reads a step lighter than
       the sans beside it, and the mixed tone the general table cell carries
       took it below legible. */
    color: var(--text);
  }

  .prose table[data-ranked] th:first-child,
  .prose table[data-ranked] td:first-child {
    width: 3rem;
    padding-right: var(--sp-12);
    text-align: center;
  }

  .prose table[data-ranked] td:first-child {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    /* A step down from the cells, not two: the position is the quiet column,
       but it is still being read. */
    color: var(--text-2);
  }

  .prose table[data-ranked] th:last-child,
  .prose table[data-ranked] td:last-child {
    width: 4rem;
    padding-right: 0;
    text-align: center;
  }

  .prose table[data-ranked] td:last-child {
    font-family: var(--font-mono);
    /* A pixel under the name beside it, at the regular weight. The figure is
       what the ranking was built from, not what the row is read for. */
    font-size: calc(var(--fs-body) - 1px);
    font-variant-numeric: tabular-nums;
  }

  /* Collapsed layers. Eleven case studies use native <details>/<summary> for
     their engineering notes, so this styles the element rather than adding a
     component. No JavaScript, and no animation beyond what the browser does
     on its own. */
  /* `--measure` is in `ch`, which resolves against the element's own font
     size — so a block that inherited a different size than the paragraphs got
     a different measure, and the rules across this bar stopped short of the
     text above them. Stating the copy size here makes the two agree. */
  .prose details {
    margin-top: var(--sp-32);
    font-size: var(--fs-copy);
    border-top: var(--rule-hair) solid var(--rule-strong);
    border-bottom: var(--rule-hair) solid var(--rule);
    /* Off, because this element's height is animated. Scroll anchoring picks a
       node to hold still and corrects the scroll offset when layout moves it;
       against a 320ms height animation that correction runs every frame, and
       whether it fires at all depends on where the reader happens to be
       scrolled. That is the twitch. The element is opened by a deliberate
       click, so there is nothing here for anchoring to protect. */
    overflow-anchor: none;
  }

  .prose summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-16);
    padding-block: var(--sp-16);
    cursor: pointer;
    /* Mono earns it here: this is the label on a technical layer. The prose
       inside stays in the body face — mono paragraphs would be a wall. */
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-mono);
    line-height: var(--lh-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color var(--dur-hover-out) var(--ease-out);
  }

  /* The default disclosure triangle is replaced by a sign on the right, so the
     label starts on the same left edge as the prose. */
  @media (max-width: 639px) {
    .prose summary {
      font-size: 0.75rem;
    }
  }

  .prose summary::-webkit-details-marker {
    display: none;
  }

  .prose summary {
    list-style: none;
  }

  /* Both signs, stacked in the same place, crossfading. `content` cannot be
     transitioned — swapping the character is a single frame — so the plus and
     the minus are two pseudo-elements that trade opacity instead. Absolutely
     positioned, so neither one takes part in the row's layout and the label
     stays exactly where it was.

     The body face, not the label's mono: mono draws a plus with arms of
     different lengths and different weights, which at this size reads as a
     mistake rather than as a sign. The minus is the literal character rather
     than a CSS escape — a four-digit escape needs a terminating space to be
     read as one codepoint, and without it it rendered as the digit 2. */
  .prose summary::before,
  .prose summary::after {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    line-height: 1;
    color: var(--text-3);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .prose summary::before {
    content: '−';
    opacity: 0;
  }

  .prose summary::after {
    content: '+';
    opacity: 1;
  }

  /* `data-closing` is on the element while the height collapses, so the sign
     turns back at the same moment the panel starts to shut rather than after
     it has. */
  .prose details[open]:not([data-closing]) > summary::before {
    opacity: 1;
  }

  .prose details[open]:not([data-closing]) > summary::after {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .prose summary:hover {
      color: var(--accent);
      transition-duration: var(--dur-hover-in);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .prose summary:active {
      color: var(--accent);
      transition-duration: var(--dur-press);
    }
  }

  /* Breathing room for the contents, and a floor under the last paragraph. */
  .prose details > *:not(summary):last-child {
    margin-bottom: var(--sp-24);
  }

  /* A link inside a sentence should be findable without pulling the eye off
     the sentence, so it rests a step back from the accent and comes up to it
     under the pointer. The rule mixes toward the page rather than toward the
     ink, so both themes soften the same way. */
  .prose a {
    color: color-mix(in srgb, var(--accent) 90%, var(--bg));
    /* Half a pixel over the hairline. The rule only shows on hover, and at 1
       it read as thin against the type it sits under. */
    border-bottom: 1.5px solid transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .prose a {
      transition:
        color var(--dur-hover-out) var(--ease-out),
        border-color var(--dur-hover-out) var(--ease-out);
    }

    .prose a:hover {
      color: var(--accent);
      border-bottom-color: currentColor;
      transition-duration: var(--dur-hover-in);
    }
  }
</style>

<script>
  // The table of contents, the header's progress bar and the URL hash all read
  // from one thing: the window's scroll position. Nothing here keeps its own
  // idea of where the reader is, so the three cannot drift apart.
  let listeners: AbortController | undefined;

  function initToc() {
    listeners?.abort();
    listeners = undefined;

    const toc = document.querySelector<HTMLDetailsElement>('.cs__toc');
    if (!toc) return;

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toclink]'));
    if (links.length === 0) return;
    const headings = links.map((link) => document.getElementById(link.dataset.toclink ?? ''));
    const now = toc.querySelector<HTMLElement>('[data-toc-now]');

    listeners = new AbortController();
    const { signal } = listeners;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1024px)');

    // Collapsed on phones and tablets, open in the desktop column. The markup
    // ships open, so the list survives with no JavaScript.
    const fitViewport = () => {
      toc.open = desktop.matches;
    };
    fitViewport();
    desktop.addEventListener('change', fitViewport, { signal });

    // A section counts as current once its heading reaches the upper third of
    // the viewport, not when it first appears at the bottom edge.
    let current = -1;
    let queued = false;
    let swap: number | undefined;

    // The collapsed bar sits under the header while you read, so its label
    // changes under the reader's eye. It fades out, swaps, and fades back in
    // rather than being replaced between two frames. The first paint has
    // nothing to fade from.
    function showCurrent(text: string) {
      if (!now || now.textContent === text) return;
      if (!now.textContent || reduced.matches) {
        now.textContent = text;
        return;
      }
      window.clearTimeout(swap);
      now.dataset.swapping = 'true';
      swap = window.setTimeout(() => {
        now.textContent = text;
        delete now.dataset.swapping;
      }, 140); // matches the transition on .cs__tocsum-now
    }

    function paint() {
      queued = false;

      // Its own computed `top` is the sticky offset, so this needs no second
      // copy of the header's height.
      const offset = parseFloat(window.getComputedStyle(toc).top) || 0;
      if (toc.getBoundingClientRect().top <= offset + 0.5) {
        toc.dataset.stuck = 'true';
      } else {
        delete toc.dataset.stuck;
      }

      const line = window.innerHeight / 3;
      let index = 0;
      for (let i = 0; i < headings.length; i += 1) {
        const heading = headings[i];
        if (!heading) continue;
        if (heading.getBoundingClientRect().top <= line) index = i;
        else break;
      }
      if (index === current) return;
      current = index;

      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      showCurrent(links[index].querySelector('.cs__toctext')?.textContent ?? '');

      // Keeps the active row in view when the list is taller than its column.
      if (toc.scrollHeight > toc.clientHeight + 1) {
        const box = toc.getBoundingClientRect();
        const item = links[index].getBoundingClientRect();
        if (item.top < box.top) toc.scrollTop -= box.top - item.top;
        else if (item.bottom > box.bottom) toc.scrollTop += item.bottom - box.bottom;
      }
    }

    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { passive: true, signal });

    // Smooth to the section, and let the scroll itself update the highlight and
    // the progress bar on the way — no state is set here, and nothing is
    // corrected once the scroll settles.
    toc.addEventListener(
      'click',
      (event) => {
        const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
          '[data-toclink]'
        );
        if (!link) return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        const slug = link.dataset.toclink ?? '';
        const target = document.getElementById(slug);
        if (!target) return;
        if (!desktop.matches) toc.open = false;
        // Reduced motion: fall through to the browser's own instant jump.
        if (reduced.matches) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        // Keeps the URL honest without a second jump.
        history.replaceState(null, '', `#${slug}`);
      },
      { signal }
    );

    // Anywhere else on the page closes it. The open panel covers the top of
    // the article, and until now the only way out was back to the summary —
    // which is not where the reader is looking. The close is routed through
    // the summary's own click so it uses the same glide a tap on the bar
    // does, rather than snapping shut. Clicks inside the panel are left
    // alone: choosing a section already closes it, in the handler above.
    document.addEventListener(
      'click',
      (event) => {
        if (desktop.matches || !toc.open) return;
        const target = event.target as Node | null;
        if (target && toc.contains(target)) return;
        const summary = toc.querySelector<HTMLElement>('summary');
        if (summary) summary.click();
        else toc.open = false;
      },
      { signal }
    );

    paint();
  }

  // ---- disclosure blocks -------------------------------------------------
  // <details> has no animatable height of its own: the browser shows or hides
  // its content in one frame. This animates the element's own height around
  // that switch, so the engineering notes and the mobile section list open and
  // close instead of jumping. Nothing is animated when the state changes
  // programmatically (the breakpoint opening the table of contents), and with
  // reduced motion the native behaviour is left alone.
  const DISCLOSURE_MS = 320;
  const DISCLOSURE_EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';

  function smoothDisclosures() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const blocks = document.querySelectorAll<HTMLDetailsElement>(
      '.prose details, details.cs__toc, details.credits__more'
    );

    for (const details of blocks) {
      const summary = details.querySelector('summary');
      if (!summary || details.dataset.smooth) continue;
      details.dataset.smooth = 'true';

      let running: Animation | undefined;

      const settle = () => {
        details.style.height = '';
        details.style.overflow = '';
        delete details.dataset.closing;
        running = undefined;
      };

      const glide = (from: number, to: number, done?: () => void) => {
        details.style.overflow = 'hidden';
        const animation = details.animate(
          [{ height: `${from}px` }, { height: `${to}px` }],
          { duration: DISCLOSURE_MS, easing: DISCLOSURE_EASE }
        );
        animation.addEventListener('finish', () => {
          done?.();
          settle();
        });
        animation.addEventListener('cancel', settle);
        return animation;
      };

      summary.addEventListener('click', (event) => {
        if (reduced.matches) return;
        event.preventDefault();
        running?.cancel();

        const box = window.getComputedStyle(details);
        const borders =
          parseFloat(box.borderTopWidth || '0') + parseFloat(box.borderBottomWidth || '0');
        const from = details.offsetHeight;

        if (details.open) {
          // The marker flips now rather than when the animation lands.
          details.dataset.closing = 'true';
          const shut = summary.getBoundingClientRect().height + borders;
          running = glide(from, shut, () => {
            details.open = false;
          });
        } else {
          details.open = true;
          running = glide(from, details.scrollHeight + borders);
        }
      });
    }
  }

  /* Eleven 1080p loops on one page is eleven simultaneous decodes, and a
     browser runs all of them whether or not they are on screen. That, not the
     file size, is what makes a long media section stutter, so the fix is to
     decode less rather than to ship less: only the clips in view play, the
     rest hold their frame and cost nothing. Resolution is untouched, because
     the sharpness is the reason they are 1920 in the first place.

     `autoplay` stays in the markup so the clips still run with no JavaScript;
     this only takes the ones that are nowhere near the reader back out. */
  let watching: IntersectionObserver | undefined;

  function playVisibleClips() {
    watching?.disconnect();
    watching = undefined;

    const clips = Array.from(document.querySelectorAll<HTMLVideoElement>('.prose video[autoplay]'));
    if (clips.length === 0) return;

    // A fixed lead rather than a share of the viewport: a clip starts a couple
    // of hundred pixels before it arrives, which is enough for a decoder to
    // spin up and short enough that a dense media section does not end up
    // running six of them at once.
    watching = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const clip = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) void clip.play().catch(() => {});
          else clip.pause();
        }
      },
      { rootMargin: '200px 0px' }
    );

    for (const clip of clips) {
      clip.pause();
      watching.observe(clip);
    }
  }

  document.addEventListener('astro:page-load', () => {
    initToc();
    smoothDisclosures();
    playVisibleClips();
  });
  initToc();
  smoothDisclosures();
  playVisibleClips();
</script>
