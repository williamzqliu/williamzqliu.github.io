---
import Base from '../../layouts/Base.astro';
import FilterRow from '../../components/FilterRow.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import {
  CATEGORIES,
  archiveProjects,
  curatedProjects,
  cardLinks,
  caseStudyHref,
} from '../../lib/projects';
import { shippedMedia } from '../../lib/media';

// Two lists, deliberately separate. The main one is every project that is not
// archived, in MAIN_ORDER (lib/projects.ts); the archive is its own list.
// All work therefore means the main list, never the archive.
const projects = await curatedProjects();
const archive = await archiveProjects();

// All work, one entry per public category, then the archive. A category or
// an archive with nothing published in it gets no chip: a chip that selects
// nothing is a broken control.
const options = [
  { value: 'all', label: 'All work' },
  ...CATEGORIES.filter((category) =>
    projects.some((project) => project.data.category === category.value)
  ).map((category) => ({ value: category.value, label: category.label })),
  ...(archive.length ? [{ value: 'archive', label: 'Archive' }] : []),
];
---

<Base
  title="Work — Zhuoqi Liu"
  description="Every published project: the main work by category, and the archive."
  current="/work"
>
  <section class="work" aria-labelledby="work-heading">
    <div class="container">
      <div class="work__head">
        <h1 class="work__heading" id="work-heading">Work</h1>
        <FilterRow options={options} />
      </div>

      {/* `data-loop`: a case study opened from a list hands on within that
          list. See lib/loop.ts. */}
      <div class="work__list" data-filter-list data-totop-from data-loop="main">
        {
          projects.map((project) => (
            <div class="work__item" data-category={project.data.category}>
            <ProjectRow
              title={project.data.title}
              year={project.data.year}
              blurb={project.data.blurb}
              stack={project.data.stack}
              href={caseStudyHref(project)}
              tone={project.data.cover.tone}
              coverSrc={shippedMedia(project.data.cover.wide)}
              coverAlt={project.data.cover.alt}
              links={cardLinks(project)}
            />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    archive.length > 0 && (
      <section class="archive" aria-labelledby="archive-heading" data-archive-section data-loop="archive">
        <div class="container">
          <h2 class="archive__heading section-label" id="archive-heading">
            Archive
          </h2>
          <p class="archive__note">
            Projects kept outside the main list, each still open in full.
          </p>
          <ArchiveList projects={archive} />
        </div>
      </section>
    )
  }
</Base>

<script>
  import { rememberLoop } from '../../lib/loop';
  rememberLoop();

  // The filters partition the page: a category narrows the main list, and
  // `archive` swaps to the archive instead. Archive projects never appear
  // under All work: that is what makes the archive a status and not a
  // category.
  //
  // With JS off none of this runs and everything stays visible, the archive
  // under the main list, which is the honest fallback for a page whose whole
  // content is the list.
  function apply(filter: string) {
    const items = document.querySelectorAll<HTMLElement>('[data-category]');
    const archiveSection = document.querySelector<HTMLElement>('[data-archive-section]');
    const primaryList = document.querySelector<HTMLElement>('[data-filter-list]');
    const showingArchive = filter === 'archive';

    for (const item of items) {
      const match = filter === 'all' || item.dataset.category === filter;
      item.hidden = showingArchive || !match;
    }

    // Whichever row ends up first loses its top rule, so the list never opens
    // with two hairlines a few pixels apart.
    let first = true;
    for (const item of items) {
      if (!item.hidden && first) {
        item.dataset.first = 'true';
        first = false;
      } else {
        delete item.dataset.first;
      }
    }

    if (primaryList) primaryList.hidden = showingArchive;
    if (archiveSection) archiveSection.hidden = !showingArchive;
  }

  /* Both the click handler and the restore go through here so they cannot
     drift apart. */
  function show(filter: string) {
    apply(filter);
  }

  /* Which filter the reader chose is view state, not an address, so it lives
     in sessionStorage rather than in the URL: one tab, cleared when the tab
     closes, and never inherited by a link someone shares.

     It exists because the filter was being lost on the way back. Opening a
     project and pressing Back re-renders /work from the server, where every
     row is visible and every chip is unpressed, so a reader who had narrowed
     the list to one subject landed in the full list and had to narrow it
     again. */
  const KEY = 'work:filter';

  function stored(): string | null {
    try {
      return sessionStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function remember(filter: string) {
    try {
      sessionStorage.setItem(KEY, filter);
    } catch {
      /* Private mode or a storage quota. The filter still works for this
         page; it just will not survive the trip. */
    }
  }

  /* Restore before paint. `astro:after-swap` is where the theme does the same
     thing, and for the same reason: the incoming document is the server's, so
     without this there is a frame of the unfiltered list. */
  function restore() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.filterrow__chip');
    if (!chips.length) return;

    const saved = stored();
    // A tag can disappear from the data between visits, so the chip has to
    // exist before its filter is trusted.
    const chip =
      (saved &&
        document.querySelector<HTMLButtonElement>(`.filterrow__chip[data-filter="${saved}"]`)) ||
      document.querySelector<HTMLButtonElement>('.filterrow__chip[data-filter="all"]');
    if (!chip) return;

    for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
    // All work included: the server renders the archive under the main list
    // for the JS-off case, and this is what takes it away again.
    show(chip.dataset.filter ?? 'all');
  }

  function bind() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.filterrow__chip');
    if (!chips.length) return;

    // Mark the first row on load too, not only after a click.
    const firstItem = document.querySelector<HTMLElement>('[data-category]');
    if (firstItem) firstItem.dataset.first = 'true';

    const archiveSection = document.querySelector<HTMLElement>('[data-archive-section]');

    for (const chip of chips) {
      if (chip.dataset.bound) continue;
      chip.dataset.bound = 'true';
      chip.addEventListener('click', () => {
        for (const other of chips) {
          other.setAttribute('aria-pressed', String(other === chip));
        }

        const filter = chip.dataset.filter ?? 'all';
        remember(filter);
        const primaryList = document.querySelector<HTMLElement>('[data-filter-list]');
        const fade = [primaryList, archiveSection].filter(Boolean) as HTMLElement[];
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const commit = () => {
          show(filter);
          for (const el of fade) delete el.dataset.fading;
        };

        if (reduced) {
          commit();
          return;
        }

        // Fade out, swap while invisible, fade back in.
        for (const el of fade) el.dataset.fading = 'true';
        window.setTimeout(commit, 160);
      });
    }
  }

  document.addEventListener('astro:after-swap', restore);
  document.addEventListener('astro:page-load', () => {
    bind();
    restore();
  });
  bind();
  restore();
</script>

<style>
  .work {
    padding-top: var(--sp-48);
  }

  /* The list's start line lives here, not on the list itself: the list fades
     when a filter changes and the line must not fade with it. */
  .work__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-16);
    padding-bottom: var(--sp-16);
    border-bottom: var(--rule-hair) solid color-mix(in srgb, var(--rule) 50%, transparent);
  }

  .work__heading {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--fs-hello-greet);
    line-height: 1.05;
    font-weight: var(--fw-display);
    letter-spacing: -0.015em;
    color: var(--text);
  }


  /* Whichever row is first drops its own rule, so it never stacks with the
     start line above. */
  .work__item[data-first] :global(.prow) {
    border-top: 0;
  }

  /* Switching filters cross-fades the list rather than swapping it in place.
     Opacity only, so nothing reflows mid-fade. */
  .work__list,
  .archive {
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .work__list[data-fading],
  .archive[data-fading] {
    opacity: 0;
  }

  .archive {
    padding-block: var(--sp-64) var(--sp-32);
  }

  .archive__heading {
    /* The label's own rule is the divider; no second line above it. */
    border-bottom: 0;
    padding-bottom: 0;
  }

  .archive__note {
    max-width: 52ch;
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-24);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

</style>
